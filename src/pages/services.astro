---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { siteConfig } from '../config/site';

const commercialOfferings = [
  {
    id: 'flagship-web',
    number: '01',
    badge: 'Web & Flagships',
    title: 'Flagship Web Development',
    tagline: 'High-performance websites, interactive landing pages, and digital flagships for ambitious teams.',
    summary: 'For businesses whose online presence does not match the actual caliber of their work. We replace bloated templates and generic themes with bespoke, flagship web experiences engineered for sub-second edge speeds, kinetic typography, and high conversion.',
    problemsSolved: [
      'Your existing website looks indistinguishable from every competitor in your category.',
      'Mobile loading speeds are sluggish (>3.5s LCP), costing you direct conversion and search visibility.',
      'Inflexible CMS architectures require weeks of developer tickets just to modify a landing page layout.',
      'Lack of memorable creative brand presence fails to convert high-value decision-makers.'
    ],
    deliverables: [
      'Bespoke digital flagship architecture (Astro / TypeScript / Tailwind CSS)',
      'Sub-50ms static edge deployment on Cloudflare with 95+ Mobile Lighthouse scores',
      'Smooth kinetic GSAP choreography and fluid interactive touchpoints',
      'Flexible, headless editorial CMS integration tailored to your marketing workflows',
      'Comprehensive technical SEO, OpenGraph metadata, and structured data schemas'
    ],
    techStack: ['Astro', 'TypeScript', 'Tailwind CSS', 'GSAP', 'Cloudflare Workers'],
    pricingInfo: siteConfig.pricing.find((p) => p.serviceId === 'flagship-web')
  },
  {
    id: 'software-automation',
    number: '02',
    badge: 'Software & Automation',
    title: 'Software & Automation',
    tagline: 'Custom internal software, robust backend APIs, and workflow engines that eliminate spreadsheet toil.',
    summary: 'For companies running critical operations on fragile spreadsheets, manual emails, and brittle no-code zaps. We engineer bespoke, role-secured operational web applications and backend automation pipelines that run reliably without manual intervention.',
    problemsSolved: [
      'Operations teams spend hours each week manually copying data between spreadsheets and systems.',
      'Accidental formula corruption or concurrent spreadsheet overwrites create costly data errors.',
      'Zero role-based permissions expose sensitive operational or customer records to unauthorized staff.',
      'Brittle no-code zaps silently fail without logging, alerting, or deterministic retry logic.'
    ],
    deliverables: [
      'Custom internal operational portal tailored precisely to your team workflow',
      'Secure PostgreSQL relational database with structured audit ledgers',
      'Automated batch report generation (encrypted PDFs, CSV exports, WhatsApp/Slack dispatch)',
      'Deterministic retry queues and token-bucket API pacing to prevent rate limit lockouts',
      'Granular role-based access control (RBAC) preventing unauthorized data visibility'
    ],
    techStack: ['Go', 'Python / FastAPI', 'PostgreSQL', 'Redis', 'Docker', 'REST APIs'],
    pricingInfo: siteConfig.pricing.find((p) => p.serviceId === 'software-automation')
  }
];
---

<BaseLayout
  title="Services & Capabilities // OTHR Creative Engineering"
  description="Explore OTHR's engineering services: Flagship Web Development (high-performance web flagships) and Software & Automation (custom internal tools and workflow engines)."
>
  <!-- Page Header -->
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Services</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            Services
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            We don't offer generic 50-page agency menus. We deliver focused engineering interventions that solve concrete business bottlenecks.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-2xl text-xs font-semibold">
          <div class="text-neutral-500 text-[11px] mb-1">Commercial Engagements</div>
          <div class="text-[#C6FF3D]">2 Core Services • Direct Engineering</div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">

      <!-- Section: Featured Commercial Offerings -->
      <section>
        <!-- Centered Header with Centered Currency Toggle (Lesser Curved Radius) -->
        <div class="text-center max-w-3xl mx-auto mb-10">
          <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-2">What We Build</div>
          <h2 class="font-display font-black text-3xl sm:text-5xl text-white tracking-tight mb-3">
            Core Engineering Services
          </h2>
          <p class="font-body text-sm sm:text-base text-neutral-400 max-w-xl mx-auto">
            Swipe or select below. Two focused disciplines designed for rapid execution and direct engineering delivery.
          </p>

          <!-- Centered Currency Switcher (lesser curved radius: rounded-lg container, rounded-md buttons) -->
          <div class="inline-flex items-center p-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs font-semibold mt-6 shadow-sm">
            <button class="service-currency-btn px-4 py-1.5 rounded-md transition-all bg-[#C6FF3D] text-black font-bold cursor-pointer" data-currency="usd">
              USD ($)
            </button>
            <button class="service-currency-btn px-4 py-1.5 rounded-md transition-all text-neutral-400 hover:text-white cursor-pointer" data-currency="inr">
              INR (₹)
            </button>
          </div>
        </div>

        <!-- Interactive Slide Navigation (Tabs + Prev/Next) -->
        <div class="flex items-center justify-between gap-4 mb-6 pb-4 border-b border-neutral-900">
          <div class="flex items-center gap-2">
            <button
              type="button"
              class="service-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all bg-[#C6FF3D] text-black cursor-pointer flex items-center gap-2"
              data-index="0"
            >
              <span class="font-mono text-[10px] opacity-80">01</span>
              <span>Flagship Web</span>
            </button>
            <button
              type="button"
              class="service-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-neutral-900 text-neutral-400 hover:text-white border border-neutral-800 cursor-pointer flex items-center gap-2"
              data-index="1"
            >
              <span class="font-mono text-[10px] opacity-80">02</span>
              <span>Software & Automation</span>
            </button>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs font-mono text-neutral-500 hidden sm:inline-block mr-1">
              <span id="current-slide-num">01</span> / 02
            </span>
            <button
              type="button"
              id="service-prev-btn"
              class="w-9 h-9 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors disabled:opacity-30 cursor-pointer"
              aria-label="Previous service"
            >
              <Icon name="ArrowLeft" size={15} />
            </button>
            <button
              type="button"
              id="service-next-btn"
              class="w-9 h-9 rounded-lg bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors disabled:opacity-30 cursor-pointer"
              aria-label="Next service"
            >
              <Icon name="ArrowRight" size={15} />
            </button>
          </div>
        </div>

        <!-- Interactive Horizontal Side-Scroll Track -->
        <div
          id="services-slider"
          class="flex overflow-x-auto snap-x snap-mandatory gap-6 scrollbar-none scroll-smooth pb-4 -mx-4 px-4 sm:mx-0 sm:px-0"
        >
          {commercialOfferings.map((offering, idx) => (
            <article
              class="service-slide w-full min-w-full snap-start snap-always bg-neutral-950 border border-neutral-900 rounded-3xl hover:border-neutral-800 transition-colors p-6 sm:p-10 lg:p-12 relative flex-shrink-0"
              data-slide-index={idx}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
                <!-- Left: Value, Story, Deliverables & Problems -->
                <div class="lg:col-span-7 space-y-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-md">{offering.number}</span>
                    <Badge variant="lime">{offering.badge}</Badge>
                  </div>

                  <h3 class="font-display font-black text-3xl sm:text-5xl text-white tracking-tight">
                    {offering.title}
                  </h3>

                  <p class="font-body text-xl text-[#C6FF3D] font-medium leading-relaxed">
                    {offering.tagline}
                  </p>

                  <p class="font-body text-base text-neutral-400 leading-relaxed">
                    {offering.summary}
                  </p>

                  <!-- Typical Deliverables (Instant Value) -->
                  <div class="pt-6 border-t border-neutral-900">
                    <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-3">
                      What We Build & Deliver
                    </div>
                    <ul class="space-y-2.5">
                      {offering.deliverables.map((del) => (
                        <li class="flex items-start gap-2.5 text-sm text-neutral-300">
                          <span class="text-[#C6FF3D] font-bold mt-0.5">›</span>
                          <span>{del}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <!-- Problems Solved -->
                  <div class="pt-6 border-t border-neutral-900">
                    <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">
                      Bottlenecks Eliminated
                    </div>
                    <ul class="space-y-2">
                      {offering.problemsSolved.map((prob) => (
                        <li class="flex items-start gap-2.5 font-body text-sm text-neutral-400">
                          <span class="text-red-400 font-bold mt-0.5">✕</span>
                          <span>{prob}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <!-- Right: Scope, Indicative Pricing & CTA Card -->
                <div class="lg:col-span-5 bg-neutral-900 border border-neutral-800 rounded-2xl p-6 sm:p-8 flex flex-col justify-between space-y-6">
                  <div>
                    <div class="text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">Scope & Pricing Guide</div>

                    {offering.pricingInfo && (
                      <div class="mb-6 p-5 bg-black border border-neutral-800 rounded-xl">
                        <div class="text-xs font-medium text-neutral-400 uppercase">Indicative Engagement Range</div>
                        <div
                          class="font-display font-extrabold text-2xl sm:text-3xl text-[#C6FF3D] mt-1 service-price-range transition-opacity duration-200"
                          data-usd={offering.pricingInfo.usdRange}
                          data-inr={offering.pricingInfo.inrRange}
                        >
                          {offering.pricingInfo.usdRange}
                        </div>
                        <div class="text-xs text-neutral-500 mt-1">
                          {offering.pricingInfo.unit} • Typical timeline: {offering.pricingInfo.typicalTimeline}
                        </div>
                        <div class="font-body text-xs text-neutral-400 mt-3 pt-3 border-t border-neutral-800">
                          {offering.pricingInfo.note}
                        </div>
                      </div>
                    )}

                    <div class="space-y-3 text-xs">
                      <div class="text-neutral-400 font-medium">Primary Technologies</div>
                      <div class="flex flex-wrap gap-1.5">
                        {offering.techStack.map((tech) => (
                          <Badge variant="muted" size="sm">{tech}</Badge>
                        ))}
                      </div>
                    </div>
                  </div>

                  <div class="pt-4 border-t border-neutral-800">
                    <Button href={`/contact?service=${offering.id}`} variant="primary" size="md" showArrow={true} class="w-full">
                      Start a {offering.title} Project
                    </Button>
                    <p class="text-xs text-neutral-500 text-center mt-2.5">
                      Direct consultation with a lead engineer. No sales reps.
                    </p>
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- Section: Custom Inquiries Banner -->
      <section class="pt-12 border-t border-neutral-900">
        <div class="bg-neutral-950 border border-neutral-900 rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
          <div class="max-w-xl">
            <span class="text-xs font-bold text-[#C6FF3D] uppercase tracking-wider">Custom Scope</span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-white mt-2 mb-2">
              Have a specialized engineering inquiry?
            </h2>
            <p class="font-body text-sm text-neutral-400 leading-relaxed">
              Whether you need specialized API integrations, custom technical architecture, or a dedicated engineering sprint, we're ready to discuss.
            </p>
          </div>
          <Button href="/contact" variant="primary" size="md" showArrow={true} class="whitespace-nowrap">
            Initiate Project Inquiry
          </Button>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>

<script>
  function triggerHaptic(duration = 10) {
    if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
      try { navigator.vibrate(duration); } catch (e) {}
    }
  }

  function initServiceCurrency() {
    const buttons = document.querySelectorAll('.service-currency-btn');
    const prices = document.querySelectorAll<HTMLElement>('.service-price-range');

    function updateCurrency(curr: 'usd' | 'inr', isUserAction = false) {
      buttons.forEach((btn) => {
        if (btn.getAttribute('data-currency') === curr) {
          btn.className = 'service-currency-btn px-4 py-1.5 rounded-md transition-all bg-[#C6FF3D] text-black font-bold cursor-pointer shadow-sm';
        } else {
          btn.className = 'service-currency-btn px-4 py-1.5 rounded-md transition-all text-neutral-400 hover:text-white cursor-pointer';
        }
      });

      prices.forEach((el) => {
        const val = curr === 'inr' ? el.getAttribute('data-inr') : el.getAttribute('data-usd');
        if (val) el.textContent = val;
      });

      try {
        localStorage.setItem('othr_currency', curr);
      } catch (e) {}

      if (isUserAction) {
        triggerHaptic(12);
      }
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const c = (btn.getAttribute('data-currency') || 'usd') as 'usd' | 'inr';
        updateCurrency(c, true);
      });
    });

    try {
      const saved = localStorage.getItem('othr_currency');
      const active = saved === 'inr' ? 'inr' : 'usd';
      updateCurrency(active, false);
    } catch (e) {
      updateCurrency('usd', false);
    }
  }

  function initServiceSlider() {
    const slider = document.getElementById('services-slider');
    if (!slider) return;

    const tabs = document.querySelectorAll('.service-tab-btn');
    const prevBtn = document.getElementById('service-prev-btn') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('service-next-btn') as HTMLButtonElement | null;
    const currentSlideNum = document.getElementById('current-slide-num');
    const slides = document.querySelectorAll('.service-slide');

    function setActiveTab(index: number) {
      tabs.forEach((tab, i) => {
        if (i === index) {
          tab.className = 'service-tab-btn active px-4 py-2 rounded-lg text-xs font-bold transition-all bg-[#C6FF3D] text-black cursor-pointer flex items-center gap-2 shadow-sm';
        } else {
          tab.className = 'service-tab-btn px-4 py-2 rounded-lg text-xs font-bold transition-all bg-neutral-900 text-neutral-400 hover:text-white border border-neutral-800 cursor-pointer flex items-center gap-2';
        }
      });

      if (currentSlideNum) {
        currentSlideNum.textContent = index < 9 ? `0${index + 1}` : String(index + 1);
      }

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === slides.length - 1;
    }

    function scrollToSlide(index: number) {
      if (!slides[index]) return;
      triggerHaptic(12);
      const target = slides[index] as HTMLElement;
      slider.scrollTo({
        left: target.offsetLeft - slider.offsetLeft,
        behavior: 'smooth'
      });
      setActiveTab(index);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => scrollToSlide(i));
    });

    prevBtn?.addEventListener('click', () => {
      const currentIndex = Math.round(slider.scrollLeft / slider.clientWidth);
      if (currentIndex > 0) scrollToSlide(currentIndex - 1);
    });

    nextBtn?.addEventListener('click', () => {
      const currentIndex = Math.round(slider.scrollLeft / slider.clientWidth);
      if (currentIndex < slides.length - 1) scrollToSlide(currentIndex + 1);
    });

    // Detect scroll to update active tab
    let scrollTimer: any;
    slider.addEventListener('scroll', () => {
      clearTimeout(scrollTimer);
      scrollTimer = setTimeout(() => {
        const idx = Math.min(Math.max(0, Math.round(slider.scrollLeft / slider.clientWidth)), slides.length - 1);
        setActiveTab(idx);
      }, 50);
    }, { passive: true });

    setActiveTab(0);
  }

  function initServicesPage() {
    initServiceCurrency();
    initServiceSlider();
  }

  initServicesPage();
  document.addEventListener('astro:page-load', initServicesPage);
</script>
