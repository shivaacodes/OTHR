---
import BaseLayout from '../layouts/BaseLayout.astro';
import InteractiveShader from '../components/lab/InteractiveShader.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { experiments } from '../data/experiments';
---

<BaseLayout
  title="The Lab // Creative Coding & Prototypes // OTHR"
  description="An experimental sandbox for creative coding, GLSL shaders, procedural audio DSP, and exploratory browser technology."
>
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Lab</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            The Lab<span class="text-[#C6FF3D]">.</span>
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            Where we break conventional rules. Algorithmic physics simulations, WebGL shaders, Web Audio synthesizers, and speculative prototypes.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-2xl text-xs font-semibold">
          <div class="text-neutral-500 text-[11px] mb-1">Sandbox Status</div>
          <div class="text-[#C6FF3D]">Live Interactive Experiments</div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      <!-- 01: Fluid Field Sandbox -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-full">01</span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-white">Chroma-Vector Fluid Field</h2>
          </div>
          <Badge variant="lime">Interactive Canvas</Badge>
        </div>
        <InteractiveShader />
      </div>

      <!-- 02: Real-time ASCII Normal Raymarcher Sandbox -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-full">02</span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-white">ASCII Surface Normal Rasterizer</h2>
          </div>
          <Badge variant="outline">Canvas 2D / Math</Badge>
        </div>

        <div class="bg-neutral-950 border border-neutral-900 rounded-3xl p-6 sm:p-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-5 space-y-4">
              <p class="font-body text-base text-neutral-400 leading-relaxed">
                A 3D geometric solid rendered in pure monospace text characters. The surface luminance and specular highlight determine glyph density:
                <code class="text-xs text-[#C6FF3D] bg-neutral-900 px-2 py-0.5 border border-neutral-800 rounded-md">. : - = + * # % @</code>
              </p>
              <div class="p-5 bg-neutral-900 border border-neutral-800 rounded-2xl space-y-3 text-xs">
                <div class="text-neutral-400 font-semibold uppercase tracking-wider">Interactive Controls</div>
                <div class="flex items-center gap-3">
                  <label for="ascii-speed" class="text-neutral-400 text-xs">Rotation Speed:</label>
                  <input type="range" id="ascii-speed" min="1" max="10" value="4" class="accent-[#C6FF3D] cursor-pointer" />
                </div>
              </div>
            </div>

            <div class="lg:col-span-7 bg-black border border-neutral-900 rounded-2xl p-4 flex items-center justify-center min-h-[300px] overflow-hidden">
              <pre id="ascii-output" class="font-mono text-[9px] sm:text-[11px] leading-tight text-[#C6FF3D] select-none text-center"></pre>
            </div>
          </div>
        </div>
      </div>

      <!-- 03: Algorithmic Synthesizer Sandbox -->
      <div>
        <div class="flex items-center justify-between mb-4">
          <div class="flex items-center gap-3">
            <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-full">03</span>
            <h2 class="font-display font-bold text-2xl sm:text-3xl text-white">Drone-Synth • FM Harmonic Modulator</h2>
          </div>
          <Badge variant="outline">Web Audio API</Badge>
        </div>

        <div class="bg-neutral-950 border border-neutral-900 rounded-3xl p-6 sm:p-8">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-6 space-y-4">
              <p class="font-body text-base text-neutral-400 leading-relaxed">
                Direct algorithmic frequency synthesis using zero external audio files. Generates 4 micro-tuned sinusoidal oscillators connected to a resonant biquad filter.
              </p>
              <div class="flex items-center gap-4 pt-2">
                <button
                  id="synth-play-btn"
                  class="px-6 py-3 bg-[#C6FF3D] hover:bg-[#d4ff66] text-black font-semibold text-xs uppercase tracking-wider rounded-full transition-colors cursor-pointer shadow-lg active:scale-95"
                >
                  Start Drone Synth
                </button>
                <span id="synth-status" class="text-xs font-semibold text-neutral-500">STOPPED</span>
              </div>
            </div>

            <div class="lg:col-span-6 bg-neutral-900 border border-neutral-800 rounded-2xl p-6 text-xs space-y-3">
              <div class="text-neutral-400 font-semibold uppercase tracking-wider">Live Oscillator Channels</div>
              <div class="flex items-center justify-between">
                <span class="text-neutral-300">Osc 1 (Fundamental):</span>
                <span class="text-[#C6FF3D] font-semibold">110.00 Hz (A2)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-neutral-300">Osc 2 (Harmonic 5th):</span>
                <span class="text-[#C6FF3D] font-semibold">164.81 Hz (E3)</span>
              </div>
              <div class="flex items-center justify-between">
                <span class="text-neutral-300">Osc 3 (Octave Detune):</span>
                <span class="text-[#C6FF3D] font-semibold">220.40 Hz (A3 +40c)</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Rest of Experiments Index -->
      <div class="pt-8 border-t border-neutral-900">
        <div class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-6">Experiment Archive</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {experiments.map((exp) => (
            <div class="p-8 bg-neutral-950 border border-neutral-900 rounded-3xl flex flex-col justify-between hover:border-neutral-700 transition-colors">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-xs font-bold text-[#C6FF3D]">{exp.code}</span>
                  <Badge variant="muted">{exp.category}</Badge>
                </div>
                <h3 class="font-display font-bold text-xl text-white mb-2">{exp.title}</h3>
                <p class="font-body text-sm text-neutral-400 leading-relaxed mb-4">{exp.description}</p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-4 border-t border-neutral-900">
                {exp.tags.map((t) => (
                  <span class="text-xs text-neutral-400 bg-neutral-900 px-2.5 py-1 border border-neutral-800 rounded-full">{t}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  import { studioAudio } from '../utils/audio';

  // 1. ASCII 3D Donut / Sphere Renderer
  function initAscii() {
    const pre = document.getElementById('ascii-output');
    const speedSlider = document.getElementById('ascii-speed') as HTMLInputElement;
    if (!pre) return;

    let A = 0;
    let B = 0;
    let speed = 0.04;

    if (speedSlider) {
      speedSlider.addEventListener('input', () => {
        speed = (parseFloat(speedSlider.value) / 10) * 0.08;
      });
    }

    function renderAscii() {
      const b: string[] = [];
      const z: number[] = [];
      A += speed;
      B += speed * 0.6;

      const cA = Math.cos(A), sA = Math.sin(A);
      const cB = Math.cos(B), sB = Math.sin(B);

      for (let k = 0; k < 1760; k++) {
        b[k] = k % 80 === 79 ? '\n' : ' ';
        z[k] = 0;
      }

      for (let j = 0; j < 6.28; j += 0.08) {
        const ct = Math.cos(j), st = Math.sin(j);
        for (let i = 0; i < 6.28; i += 0.03) {
          const sp = Math.sin(i), cp = Math.cos(i);
          const h = ct + 2;
          const D = 1 / (sp * h * sA + st * cA + 5);
          const t = sp * h * cA - st * sA;

          const x = 0 | (40 + 30 * D * (cp * h * cB - t * sB));
          const y = 0 | (12 + 15 * D * (cp * h * sB + t * cB));
          const o = x + 80 * y;
          const N = 0 | (8 * ((st * sA - sp * ct * cA) * cB - sp * ct * sA - st * cA - cp * ct * sB));

          if (y < 22 && y >= 0 && x >= 0 && x < 79 && D > z[o]) {
            z[o] = D;
            b[o] = '.,-~:;=!*#$@'[N > 0 ? N : 0];
          }
        }
      }

      pre.textContent = b.join('');
      requestAnimationFrame(renderAscii);
    }

    renderAscii();
  }

  // 2. Drone Synth Controller
  function initDroneSynth() {
    const playBtn = document.getElementById('synth-play-btn');
    const statusLabel = document.getElementById('synth-status');
    if (!playBtn) return;

    let isPlaying = false;
    let audioCtx: AudioContext | null = null;
    let oscillators: OscillatorNode[] = [];
    let masterGain: GainNode | null = null;

    playBtn.addEventListener('click', () => {
      studioAudio.playClick();

      if (!isPlaying) {
        const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
        audioCtx = new AudioContextClass();
        masterGain = audioCtx.createGain();
        masterGain.gain.setValueAtTime(0.08, audioCtx.currentTime);
        masterGain.connect(audioCtx.destination);

        const freqs = [110, 164.81, 220.4, 329.63];
        oscillators = freqs.map((f, i) => {
          const osc = audioCtx!.createOscillator();
          const oscGain = audioCtx!.createGain();
          osc.type = i % 2 === 0 ? 'sine' : 'triangle';
          osc.frequency.setValueAtTime(f, audioCtx!.currentTime);

          oscGain.gain.setValueAtTime(0.25, audioCtx!.currentTime);
          osc.connect(oscGain);
          oscGain.connect(masterGain!);
          osc.start();
          return osc;
        });

        isPlaying = true;
        playBtn.textContent = 'STOP DRONE SYNTH';
        playBtn.classList.remove('bg-[#C6FF3D]', 'text-black');
        playBtn.classList.add('bg-red-500/20', 'text-red-400', 'border', 'border-red-500/40');
        if (statusLabel) {
          statusLabel.textContent = 'RUNNING (HARMONIC FM)';
          statusLabel.className = 'text-xs font-semibold text-[#C6FF3D]';
        }
      } else {
        oscillators.forEach((o) => {
          try { o.stop(); } catch (e) {}
        });
        audioCtx?.close();
        isPlaying = false;
        playBtn.textContent = 'START DRONE SYNTH';
        playBtn.classList.add('bg-[#C6FF3D]', 'text-black');
        playBtn.classList.remove('bg-red-500/20', 'text-red-400', 'border', 'border-red-500/40');
        if (statusLabel) {
          statusLabel.textContent = 'STOPPED';
          statusLabel.className = 'text-xs font-semibold text-neutral-500';
        }
      }
    });
  }

  initAscii();
  initDroneSynth();
  document.addEventListener('astro:page-load', () => {
    initAscii();
    initDroneSynth();
  });
</script>
