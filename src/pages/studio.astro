---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { studioData } from '../data/studio';
---

<BaseLayout
  title="Studio // Ethos & Principles // OTHR"
  description="OTHR is an independent creative engineering studio combining radical visual identity with brutal systems performance."
>
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Studio</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            The Studio<span class="text-[#C6FF3D]">.</span>
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            Independent creative engineering. We design and engineer websites, software, and automations that make businesses work better.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-2xl text-xs font-semibold">
          <div class="text-neutral-500 text-[11px] mb-1">Studio Structure</div>
          <div class="text-[#C6FF3D]">Independent • Bengaluru & Remote</div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      <!-- Founder Story & Why OTHR Exists -->
      <section class="max-w-4xl space-y-6">
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider">The Origin & Founder Note</div>
        <h2 class="font-display font-bold text-3xl sm:text-5xl text-white">
          Built to kill corporate bloat and generic templates.
        </h2>
        <div class="space-y-4 font-body text-lg text-neutral-400 leading-relaxed">
          <p>
            OTHR was founded by <strong class="text-white">Shiva Sajay</strong>, a creative developer and software engineer.
          </p>
          <p>
            The studio started from an obvious frustration: most modern web software is interchangeable. Agencies charge six figures to paste generic corporate templates together, while engineering agencies dismiss visual craftsmanship as unnecessary decoration.
          </p>
          <p>
            We operate differently. OTHR combines technical discipline (compiled languages, relational schemas, deterministic queues) with experimental creative coding (WebGL, Three.js, kinetic typography). When you partner with us, you work directly with engineers who build your systems—with zero sales reps, zero bureaucratic layers, and complete technical transparency.
          </p>
        </div>
      </section>

      <!-- Manifesto -->
      <section class="max-w-4xl space-y-8 pt-12 border-t border-neutral-900">
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider">The Manifesto</div>
        <div class="space-y-6">
          {studioData.manifesto.map((paragraph, i) => (
            <p class={`font-body leading-relaxed ${i === studioData.manifesto.length - 1 ? 'text-2xl sm:text-3xl font-display font-bold text-[#C6FF3D]' : 'text-lg sm:text-xl text-neutral-300'}`}>
              {paragraph}
            </p>
          ))}
        </div>
      </section>

      <!-- Brand Visual Identity: The O. Monogram -->
      <section class="max-w-4xl pt-12 border-t border-neutral-900">
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-6">Brand Identifier • The Official Signature Mark</div>
        <div class="bg-neutral-950 border border-neutral-900 rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row items-center gap-8 justify-between">
          <div class="space-y-4 max-w-lg">
            <h3 class="font-display font-bold text-2xl sm:text-3xl text-white">
              The Continuous Loop & The Terminal Dot<span class="text-[#C6FF3D]">.</span>
            </h3>
            <p class="font-body text-base text-neutral-400 leading-relaxed">
              Our signature mark embodies OTHR’s dual personality: a continuous stadium loop representing high-throughput systems, resilient backends, and uninterrupted engineering velocity—anchored by an assertive terminal dot representing absolute technical precision and decisive outcomes.
            </p>
            <div class="text-xs font-semibold text-neutral-500 pt-2">
              Colorway: <span class="text-[#DDEC43] font-bold">#DDEC43</span> • Electric Neon Lime
            </div>
          </div>
          <div class="p-8 sm:p-10 bg-neutral-900 border border-neutral-800 rounded-2xl flex items-center justify-center min-w-[200px]">
            <img
              src="/logo-mark.png"
              alt="OTHR Official Signature Mark"
              class="h-24 sm:h-28 w-auto object-contain drop-shadow-[0_0_24px_rgba(221,236,67,0.45)]"
              width="180"
              height="105"
            />
          </div>
        </div>
      </section>

      <!-- The 5 Principles -->
      <section class="pt-12 border-t border-neutral-900">
        <div class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-10">Foundational Principles</div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {studioData.principles.map((p) => (
            <div class="p-8 bg-neutral-950 border border-neutral-900 rounded-3xl hover:border-neutral-700 transition-colors flex flex-col justify-between">
              <div>
                <span class="text-xs font-bold text-[#C6FF3D] bg-[#C6FF3D]/10 px-2.5 py-1 rounded-full">{p.number}</span>
                <h3 class="font-display font-bold text-2xl text-white mt-4 mb-3">{p.headline}</h3>
                <p class="font-body text-sm text-neutral-400 leading-relaxed">{p.elaboration}</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Technology Stack Stackup -->
      <section class="pt-12 border-t border-neutral-900">
        <div class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-10">Engineering Stack & Tools</div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {studioData.stack.map((item) => (
            <div class="p-8 bg-neutral-950 border border-neutral-900 rounded-3xl">
              <h3 class="font-display font-bold text-xl text-white mb-4">{item.category}</h3>
              <div class="flex flex-wrap gap-2">
                {item.technologies.map((tech) => (
                  <Badge variant="lime" size="sm">{tech}</Badge>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Location & Collaboration Coordinates -->
      <section class="pt-12 border-t border-neutral-900">
        <div class="text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-10">Studio Location & Collaboration</div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {studioData.coordinates.map((coord) => (
            <div class="p-8 bg-neutral-950 border border-neutral-900 rounded-3xl space-y-2">
              <div class="text-xs font-bold text-[#C6FF3D]">{coord.label}</div>
              <div class="font-display font-bold text-lg text-white">{coord.location}</div>
              <div class="text-xs text-neutral-400">{coord.timezone} ({coord.offset})</div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
