---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Studio // Independent Creative Engineering // OTHR"
  description="OTHR is an independent creative engineering studio founded by Shiva Sajay. We engineer high-performance web flagships, internal automation software, and proprietary products."
>
  <!-- Page Header -->
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Studio</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            The Studio
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            Independent digital software & web studio. We design and build high-performance software, web flagships, and automations that make businesses work better.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-xl text-xs font-semibold">
          <div class="text-neutral-500 text-[11px] mb-1">Founder-Led</div>
          <div class="text-[#C6FF3D]">Kochi, India • Working Everywhere</div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Origin & Founder Note -->
      <section class="max-w-3xl space-y-6">
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider">The Origin</div>
        <h2 class="font-display font-bold text-3xl sm:text-5xl text-white tracking-tight leading-tight">
          Built to kill corporate bloat and generic templates
        </h2>
        <div class="space-y-4 font-body text-base sm:text-lg text-neutral-400 leading-relaxed">
          <p>
            OTHR was founded by <strong class="text-white">Shiva Sajay</strong>, a software engineer and creative developer based in Kochi, India.
          </p>
          <p>
            The studio started from an obvious frustration: most modern web software is interchangeable. Agencies charge excessive retainers to paste generic corporate templates together, while traditional engineering shops dismiss visual craftsmanship as unnecessary decoration.
          </p>
          <p>
            We operate differently. OTHR combines technical discipline (compiled languages, relational schemas, deterministic queues) with experimental creative craft (kinetic typography, sub-second edge speeds, and tactile UI). When you partner with us, you work directly with the engineer who builds your systems: zero sales reps, zero bureaucratic layers, and complete technical transparency.
          </p>
        </div>
      </section>

      <!-- Direct Call to Action Banner -->
      <section class="bg-neutral-950 border border-neutral-900 rounded-3xl p-8 sm:p-12 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div class="max-w-xl">
          <span class="text-xs font-bold text-[#C6FF3D] uppercase tracking-wider">Start a Conversation</span>
          <h2 class="font-display font-bold text-2xl sm:text-4xl text-white mt-2 mb-2">
            Have a project in mind?
          </h2>
          <p class="font-body text-sm sm:text-base text-neutral-400 leading-relaxed">
            Whether you need a flagship website or custom software to automate operations, let's talk directly.
          </p>
        </div>
        <div class="flex flex-col sm:flex-row gap-3">
          <Button href="/contact" variant="primary" size="md" showArrow={true}>
            Get in Touch
          </Button>
          <Button href="/services" variant="outline" size="md">
            View Services
          </Button>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
