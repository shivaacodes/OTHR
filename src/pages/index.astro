---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import MockGenSection from '../components/products/MockGenSection.astro';
import CapabilitiesSection from '../components/studio/CapabilitiesSection.astro';
import LabSection from '../components/lab/LabSection.astro';
import JournalPreviewSection from '../components/journal/JournalPreviewSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<BaseLayout
  title="OTHR // We don't do ordinary. Independent Creative Engineering Studio"
  description="OTHR is an independent creative engineering studio building digital flagships, resilient distributed software, and proprietary SaaS products like MockGen."
>
  <!-- Hero Section with Signature 3D Centerpiece -->
  <Hero />

  <!-- Section 01: Flagship Product Spotlight (MockGen in Neon Orange Theme Card) -->
  <MockGenSection />

  <!-- Section 02: What We Do (Capabilities & Services) -->
  <CapabilitiesSection />

  <!-- Section 03: The Lab (Experimental Technology) -->
  <LabSection />

  <!-- Section 04: The Journal (Engineering Field Notes) -->
  <JournalPreviewSection />

  <!-- Section 05: Contact Inquiries -->
  <ContactSection />
</BaseLayout>
