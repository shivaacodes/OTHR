---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import TrustSection from '../components/home/TrustSection.astro';
import ServicesSection from '../components/home/ServicesSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import FaqSection from '../components/home/FaqSection.astro';
---

<BaseLayout
  title="Nira Studio | Thoughtful Websites. Smarter Business Software."
  description="Websites, custom software, and automation for small businesses and growing teams that want better."
>
  <!-- 1. Hero: What we build and who we help -->
  <Hero />

  <!-- 2. Trust: Deep Blue (#0B3C85), Cream Text (#F5F2EB) -->
  <TrustSection />

  <!-- 3. Services: 3 Core launch offerings in everyday language -->
  <ServicesSection />

  <!-- 4. Pricing: Simple, transparent starting packages -->
  <PricingSection />

  <!-- 5. FAQs: Crisp underlined accordion with top-right inclined arrows -->
  <FaqSection />
</BaseLayout>
