---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import ProductSection from '../components/products/ProductSection.astro';
import WhatWeBuildSection from '../components/services/WhatWeBuildSection.astro';
import FounderSection from '../components/studio/FounderSection.astro';
import LabPreviewSection from '../components/lab/LabPreviewSection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<BaseLayout
  title="OTHR | Independent Creative Engineering Studio // Web Flagships & Software Systems"
  description="Websites, custom software, and automation for businesses that want better. Founded by Shiva Sajay in Kochi, India."
>
  <!-- 1. Hero: Dominant typography + Secondary 3D sculpture + Unmistakable CTAs -->
  <Hero />

  <!-- 2. Original Software (MockGen Hex-Style Video Card) -->
  <ProductSection />

  <!-- 3. What We Build: Three concise service categories with clear examples & pricing -->
  <WhatWeBuildSection />

  <!-- 4. The Person Behind OTHR: Genuine founder introduction & direct trust -->
  <FounderSection />

  <!-- 5. Creative Technology: The Lab Preview -->
  <LabPreviewSection />

  <!-- 6. Contact: One strong final CTA and simple inquiry flow -->
  <ContactSection />
</BaseLayout>
