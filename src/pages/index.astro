import MockGenSection from '../components/products/MockGenSection.astro';
import CapabilitiesSection from '../components/studio/CapabilitiesSection.astro';
import PhilosophySection from '../components/studio/PhilosophySection.astro';
import ContactSection from '../components/contact/ContactSection.astro';
---

<BaseLayout
  title="OTHR — Independent Creative Engineering Studio"
  description="We design and engineer bespoke web flagships, workflow automation engines, and original software products like MockGen."
>
  <!-- Hero Section -->
  <Hero />

  <!-- Products: Flagship Spotlight (MockGen in Neon Orange Theme Card) -->
  <MockGenSection />

  <!-- Services: What We Build -->
  <CapabilitiesSection />

  <!-- Studio: Who We Are & How We Work -->
  <PhilosophySection />

  <!-- Contact: Get in Touch -->
  <ContactSection />
</BaseLayout>
