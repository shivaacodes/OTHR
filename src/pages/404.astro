---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
---

<BaseLayout
  title="404 // Coordinate Not Found // OTHR"
  description="The requested route does not exist in this reality."
>
  <div class="min-h-[75vh] flex items-center justify-center py-20 relative overflow-hidden bg-black">
    <div class="max-w-2xl mx-auto px-4 text-center relative z-10 space-y-8">
      <Badge variant="alert" dot={true}>Error 404 • Not Found</Badge>

      <h1 class="font-display font-black text-6xl sm:text-8xl lg:text-9xl tracking-tighter text-white leading-none">
        404
      </h1>

      <div class="text-sm font-semibold text-[#C6FF3D] tracking-wider uppercase">
        Zero bytes found at this address
      </div>

      <p class="font-body text-base sm:text-lg text-neutral-400 max-w-lg mx-auto leading-relaxed">
        The coordinate you are attempting to access has either been moved, updated, or does not exist.
      </p>

      <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
        <Button href="/" variant="primary" size="md" showArrow={true}>
          Return to Studio Base
        </Button>
        <Button href="/products" variant="outline" size="md">
          Explore Flagship Product
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
