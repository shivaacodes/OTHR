---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/ui/Badge.astro';
import Button from '../../components/ui/Button.astro';
import Icon from '../../components/ui/Icon.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('journal', ({ data }) => {
  return import.meta.env.PROD ? !data.draft : true;
});

const sortedArticles = allArticles.sort(
  (a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime()
);

const featuredArticle = sortedArticles.find((a) => a.data.featured) || sortedArticles[0];
const standardArticles = sortedArticles.filter((a) => a.id !== featuredArticle?.id);

// Extract unique tags
const allTags = Array.from(new Set(allArticles.flatMap((a) => a.data.tags)));
---

<BaseLayout
  title="The Journal // Engineering & Architecture // OTHR"
  description="Technical post-mortems, architectural decisions, systems engineering, and creative technology field notes from OTHR."
>
  <!-- Page Header -->
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Journal</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            The Journal<span class="text-[#C6FF3D]">.</span>
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            Engineering field notes, architecture post-mortems, and honest reflections on software craft. No generic corporate marketing.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-2xl text-xs font-semibold">
          <div class="text-neutral-500 text-[11px] mb-1">Publication Status</div>
          <div class="text-[#C6FF3D]">{sortedArticles.length} Essays • Production Ready</div>
        </div>
      </div>

      <!-- Tag Filter Pills -->
      <div class="pt-6 border-t border-neutral-900 flex flex-wrap items-center gap-2" id="journal-filter-bar">
        <button
          class="journal-filter-btn px-4 py-1.5 font-body text-xs font-semibold uppercase tracking-wider bg-[#C6FF3D] text-black border border-[#C6FF3D] rounded-full cursor-pointer transition-all"
          data-tag="all"
        >
          All Topics
        </button>
        {allTags.map((tag) => (
          <button
            class="journal-filter-btn px-4 py-1.5 font-body text-xs font-semibold uppercase tracking-wider bg-neutral-900 text-neutral-400 border border-neutral-800 hover:border-neutral-700 hover:text-white rounded-full cursor-pointer transition-all"
            data-tag={tag}
          >
            {tag}
          </button>
        ))}
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">

      <!-- Featured Spotlight Article -->
      {featuredArticle && (
        <article class="journal-card bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-3xl transition-colors p-6 sm:p-10 lg:p-12" data-tags={featuredArticle.data.tags.join(',')}>
          <div class="max-w-4xl space-y-6">
            <div class="flex flex-wrap items-center gap-3">
              <Badge variant="lime" dot={true}>Featured Essay</Badge>
              <span class="text-xs text-neutral-500 font-medium">
                {new Date(featuredArticle.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
              </span>
              <span class="text-xs text-neutral-500 font-medium">• {featuredArticle.data.readingTime}</span>
            </div>

            <h2 class="font-display font-bold text-2xl sm:text-4xl lg:text-5xl text-white tracking-tight hover:text-[#C6FF3D] transition-colors leading-tight">
              <a href={`/journal/${featuredArticle.id}`}>
                {featuredArticle.data.title}
              </a>
            </h2>

            <p class="font-body text-lg sm:text-xl text-neutral-400 leading-relaxed">
              {featuredArticle.data.description}
            </p>

            <div class="flex flex-wrap items-center justify-between gap-4 pt-6 border-t border-neutral-900">
              <div class="flex flex-wrap gap-1.5">
                {featuredArticle.data.tags.map((t) => (
                  <span class="text-xs text-neutral-400 bg-neutral-900 px-3 py-1 border border-neutral-800 rounded-full font-medium">
                    {t}
                  </span>
                ))}
              </div>

              <a
                href={`/journal/${featuredArticle.id}`}
                class="text-xs font-semibold text-[#C6FF3D] hover:text-white uppercase tracking-wider flex items-center gap-1.5 transition-colors"
              >
                <span>Read Full Essay</span>
                <Icon name="ArrowUpRight" size={14} />
              </a>
            </div>
          </div>
        </article>
      )}

      <!-- Standard Articles Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8" id="journal-articles-grid">
        {standardArticles.map((article) => (
          <article
            class="journal-card bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-3xl transition-colors p-6 sm:p-8 flex flex-col justify-between"
            data-tags={article.data.tags.join(',')}
          >
            <div class="space-y-4">
              <div class="flex items-center justify-between text-xs text-neutral-500 font-medium">
                <span>
                  {new Date(article.data.publishDate).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
                <span>{article.data.readingTime}</span>
              </div>

              <h3 class="font-display font-bold text-2xl text-white hover:text-[#C6FF3D] transition-colors leading-snug">
                <a href={`/journal/${article.id}`}>
                  {article.data.title}
                </a>
              </h3>

              <p class="font-body text-sm text-neutral-400 leading-relaxed">
                {article.data.description}
              </p>
            </div>

            <div class="pt-6 mt-6 border-t border-neutral-900 flex items-center justify-between">
              <div class="flex flex-wrap gap-1.5">
                {article.data.tags.slice(0, 2).map((t) => (
                  <span class="text-xs text-neutral-400 bg-neutral-900 px-2.5 py-0.5 border border-neutral-800 rounded-full font-medium">
                    {t}
                  </span>
                ))}
              </div>

              <a
                href={`/journal/${article.id}`}
                class="text-xs font-semibold text-neutral-400 hover:text-[#C6FF3D] flex items-center gap-1 transition-colors"
              >
                <span>Read</span>
                <Icon name="ArrowUpRight" size={13} />
              </a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </div>
</BaseLayout>

<script>
  import { studioAudio } from '../../utils/audio';

  function initJournalFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.journal-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.journal-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        studioAudio.playClick();
        const tag = btn.getAttribute('data-tag');

        filterBtns.forEach((b) => {
          b.classList.remove('bg-[#C6FF3D]', 'text-black', 'border-[#C6FF3D]');
          b.classList.add('bg-neutral-900', 'text-neutral-400', 'border-neutral-800');
        });

        btn.classList.add('bg-[#C6FF3D]', 'text-black', 'border-[#C6FF3D]');
        btn.classList.remove('bg-neutral-900', 'text-neutral-400', 'border-neutral-800');

        cards.forEach((card) => {
          const cardTags = card.getAttribute('data-tags') || '';
          if (tag === 'all' || cardTags.split(',').includes(tag || '')) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  initJournalFilter();
  document.addEventListener('astro:page-load', initJournalFilter);
</script>
