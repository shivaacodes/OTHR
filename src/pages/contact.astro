---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import Badge from '../components/ui/Badge.astro';
import Icon from '../components/ui/Icon.astro';
import { studioData } from '../data/studio';

const faqs = [
  {
    q: 'What type of projects does OTHR take on?',
    a: 'We specialize in two primary domains: high-performance distributed systems/software backends, and award-winning interactive digital flagships requiring custom WebGL/Three.js or kinetic typography.'
  },
  {
    q: 'How does OTHR price engagements?',
    a: 'We engage on a dedicated sprint or milestone basis with transparent weekly sprints. We don’t bury clients under opaque change-orders or bloated corporate overhead.'
  },
  {
    q: 'What is the typical project timeline?',
    a: 'Prototypes and technical proof-of-concepts typically ship in 2–4 weeks. Comprehensive production platforms or digital flagships typically run 6–12 weeks from architecture to final release.'
  },
  {
    q: 'Do you work with venture-backed startups as well as enterprise?',
    a: 'Yes. We partner with visionary founders building zero-to-one SaaS products as well as enterprise engineering teams modernizing latency-sensitive architecture.'
  }
];
---

<BaseLayout
  title="Initiate Contact // Shiva Sajay // OTHR Creative Engineering"
  description="Connect directly with Shiva Sajay at OTHR. Reach out via phone (+91 9995228904), WhatsApp, or submit a project inquiry for web flagships and software automations."
>
  <div class="py-16 md:py-24 border-b border-neutral-900 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">Contact</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            Let's Talk
          </h1>
          <p class="font-body text-xl text-neutral-400 max-w-2xl leading-relaxed">
            Have an ambitious product idea, need a high-performance web flagship, or need to automate critical workflows? We're listening.
          </p>
        </div>

        <div class="p-4 bg-neutral-950 border border-neutral-900 rounded-xl text-xs font-semibold space-y-1">
          <div class="text-neutral-500 text-[11px]">Direct Dispatch</div>
          <div class="text-white font-medium">{studioData.contactEmail}</div>
          <a href="tel:+919995228904" class="text-[#C6FF3D] block hover:underline font-mono">
            +91 99952 28904
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Contact Form & Coordinates -->
  <ContactSection />

  <!-- FAQs -->
  <section class="py-16 md:py-24 bg-black border-t border-neutral-900">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-4">Frequently Asked Questions</div>
      <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-12">
        How We Work With Partners
      </h2>

      <div class="space-y-6">
        {faqs.map((faq, i) => (
          <div class="p-8 bg-neutral-950 border border-neutral-900 rounded-2xl">
            <h3 class="font-display font-bold text-xl text-white mb-3">
              <span class="text-[#C6FF3D] text-sm mr-2 font-semibold">0{i + 1} •</span>
              {faq.q}
            </h3>
            <p class="font-body text-sm text-neutral-400 leading-relaxed pl-6 border-l-2 border-[#C6FF3D]/40">
              {faq.a}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
