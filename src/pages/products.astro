---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { products } from '../data/products';

const mockgen = products[0];

const faqs = [
  {
    q: 'Is this just another AI image generator?',
    a: 'No. Unlike traditional generative AI tools that hallucinate flat 2D images with warped typography and incorrect perspective, MockGen is a manufacturing-aware 3D asset pipeline. It outputs real layered files (PSD, OBJ, GLB) and UV dielines with precise print dimensions and bleed margins.'
  },
  {
    q: 'Can I edit the designs and layers individually?',
    a: 'Yes. MockGen outputs complete layered project files. You can isolate logos, surface condensation, typography, and base aluminum/foil finishes, making adjustments directly in Photoshop or your 3D package.'
  },
  {
    q: 'What do I get with the Creator plan?',
    a: 'The Creator plan includes 1,000 credits per month (about 20–25 completed packaging projects), full commercial licensing rights, high-resolution 4K render exports, and access to advanced materials like metallic foil stamping and spot UV coatings.'
  },
  {
    q: 'What formats can I export for my printer or client?',
    a: 'You can export layered Adobe Photoshop (.PSD) documents, 3D Object (.OBJ) geometry, web-ready 3D (.GLB) files for browser inspection, and flat UV dieline maps ready for physical manufacturing.'
  }
];
---

<BaseLayout
  title="MockGen // AI Generated 3D Mockups Ready for Print // OTHR Products"
  description="MockGen is a professional 3D packaging and print asset pipeline. Generate production-ready packaging files with exact dimensions, bleed, and layers in 45 seconds."
>
  <!-- Page Header -->
  <div class="py-16 md:py-24 border-b border-neutral-900 relative overflow-hidden bg-black">
    <!-- Neon Yellow Background Glow -->
    <div class="absolute right-[10%] top-[10%] w-[450px] h-[450px] bg-[#FFE500]/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex items-center gap-2 font-body text-xs text-neutral-500 mb-6">
        <a href="/" class="hover:text-white transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#FFE500]">Products</span>
        <span>/</span>
        <span class="text-neutral-300">MockGen</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-8">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <Badge variant="yellow" dot={true}>Live Commercial SaaS</Badge>
            <span class="font-body text-xs text-neutral-400">Web & Print Pipeline</span>
          </div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-white mb-4">
            MockGen
          </h1>
          <p class="font-display font-bold text-2xl sm:text-3xl text-[#FFE500] max-w-2xl leading-snug mb-3">
            {mockgen.tagline}
          </p>
          <p class="font-body text-lg text-neutral-400 max-w-2xl leading-relaxed">
            {mockgen.subtitle}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <Button
            href="https://trymockgen.vercel.app/?auth=signup"
            variant="yellow"
            size="lg"
            showArrow={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get Started Free
          </Button>
          <Button
            href="https://trymockgen.vercel.app/#demo"
            variant="yellow-outline"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch 30s Demo
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-black">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">

      <!-- Flagship Tactile Showcase Card (HEX Style in Neon Yellow) -->
      <section class="bg-[#FFE500] text-black rounded-3xl p-6 sm:p-10 lg:p-12 shadow-[0_20px_60px_-15px_rgba(255,229,0,0.35)] transition-transform duration-300">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Inset Media Window: Production Asset Preview -->
          <div class="lg:col-span-7">
            <div class="bg-neutral-950 rounded-2xl overflow-hidden border border-black/20 shadow-2xl p-6 sm:p-8 flex flex-col justify-between">
              <!-- Top HUD -->
              <div class="flex items-center justify-between pb-4 mb-6 border-b border-neutral-800 text-xs">
                <div class="flex items-center gap-2">
                  <span class="w-2 h-2 rounded-full bg-[#FFE500] animate-pulse"></span>
                  <span class="text-white font-mono font-semibold">Production Asset Pipeline</span>
                </div>
                <span class="text-[#FFE500] font-mono text-xs">100% Deterministic</span>
              </div>

              <!-- Layered Visualization Matrix -->
              <div class="space-y-3 mb-6 font-mono text-xs">
                <div class="p-3.5 bg-neutral-900 border border-neutral-800 rounded-xl flex items-center justify-between text-neutral-300">
                  <div class="flex items-center gap-3">
                    <span class="text-[#FFE500] font-bold">01</span>
                    <span class="text-white font-medium">Layered Photoshop (.PSD)</span>
                  </div>
                  <span class="text-neutral-500 text-[11px]">Separate Art, UV & Bleed</span>
                </div>

                <div class="p-3.5 bg-neutral-900 border border-neutral-800 rounded-xl flex items-center justify-between text-neutral-300">
                  <div class="flex items-center gap-3">
                    <span class="text-[#FFE500] font-bold">02</span>
                    <span class="text-white font-medium">3D Geometry (.OBJ / .GLB)</span>
                  </div>
                  <span class="text-neutral-500 text-[11px]">Curved Mesh & UV Coordinates</span>
                </div>

                <div class="p-3.5 bg-neutral-900 border border-neutral-800 rounded-xl flex items-center justify-between text-neutral-300">
                  <div class="flex items-center gap-3">
                    <span class="text-[#FFE500] font-bold">03</span>
                    <span class="text-white font-medium">Flat Print Dieline (PDF)</span>
                  </div>
                  <span class="text-neutral-500 text-[11px]">Exact Bleed Margins (3mm)</span>
                </div>

                <div class="p-3.5 bg-neutral-900 border border-neutral-800 rounded-xl flex items-center justify-between text-neutral-300">
                  <div class="flex items-center gap-3">
                    <span class="text-[#FFE500] font-bold">04</span>
                    <span class="text-white font-medium">Material Spec Sheet</span>
                  </div>
                  <span class="text-neutral-500 text-[11px]">Foil, Metallic & Spot UV</span>
                </div>
              </div>

              <!-- Bottom Status -->
              <div class="pt-4 border-t border-neutral-800 flex items-center justify-between text-xs text-neutral-400">
                <span>Output: <strong class="text-white">4K Print Ready (300 DPI)</strong></span>
                <span class="text-[#FFE500] font-mono">Zero AI Hallucination</span>
              </div>
            </div>
          </div>

          <!-- Card Content -->
          <div class="lg:col-span-5 flex flex-col justify-between">
            <div>
              <div class="inline-flex items-center gap-2 bg-black/10 px-3.5 py-1.5 rounded-full text-black font-semibold text-xs mb-4">
                <span>⚡ Transparent Workflow</span>
                <span>•</span>
                <span>No AI Blackbox</span>
              </div>

              <h2 class="font-display font-black text-3xl sm:text-5xl text-black tracking-tight leading-[1.05] mb-4">
                Visualize Production-Ready Packaging Instantly
              </h2>

              <p class="font-body text-base sm:text-lg text-black/85 font-medium leading-relaxed mb-6">
                Unlike normal AI image generators that produce flat, unusable graphics with distorted text, MockGen generates print-ready packaging files with exact dimensions, bleed margins, and isolated layers.
              </p>

              <div class="space-y-3 mb-8 bg-black/5 p-5 rounded-2xl border border-black/10">
                {mockgen.highlights.map((h) => (
                  <div class="flex items-center justify-between text-xs sm:text-sm font-semibold">
                    <span class="text-black/75">{h.label}</span>
                    <span class="text-black font-bold">{h.value}</span>
                  </div>
                ))}
              </div>
            </div>

            <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href="https://trymockgen.vercel.app/?auth=signup"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-black hover:bg-neutral-900 text-white font-semibold text-sm px-7 py-3.5 rounded-full transition-all text-center shadow-lg active:scale-95 inline-flex items-center justify-center gap-2"
              >
                <span>Draft Your Design Free</span>
                <Icon name="ArrowUpRight" size={16} />
              </a>
              <a
                href="https://trymockgen.vercel.app/dashboard?model=%2Fmodels%2Fsoda_can.glb"
                target="_blank"
                rel="noopener noreferrer"
                class="bg-white/80 hover:bg-white text-black font-semibold text-sm px-6 py-3.5 rounded-full transition-all text-center active:scale-95"
              >
                Launch Studio
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: 4-Step Production Pipeline -->
      <section>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-6 border-b border-neutral-900">
          <div>
            <div class="text-xs font-semibold text-[#FFE500] uppercase tracking-wider mb-2">The 4-Step Pipeline</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-white">
              How MockGen Works
            </h2>
          </div>
          <p class="font-body text-sm text-neutral-400 max-w-md">
            A deterministic engineering workflow from prompt conception to production-grade physical manufacturing files.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {mockgen.workflow.map((item) => (
            <div class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all group">
              <div>
                <span class="text-xs font-bold text-[#FFE500] bg-[#FFE500]/10 px-2.5 py-1 rounded-full">
                  Step {item.step}
                </span>
                <h3 class="font-display font-bold text-xl text-white group-hover:text-[#FFE500] transition-colors mt-4 mb-3">
                  {item.title}
                </h3>
                <p class="font-body text-sm text-neutral-400 leading-relaxed mb-6">
                  {item.description}
                </p>
              </div>

              {item.formats && (
                <div class="pt-4 border-t border-neutral-900 space-y-2">
                  <div class="text-[11px] font-medium text-neutral-500 uppercase">Exportable Assets</div>
                  <div class="flex flex-wrap gap-1.5">
                    {item.formats.map((fmt) => (
                      <span class="px-2.5 py-1 bg-neutral-900 border border-neutral-800 text-xs font-medium text-[#FFE500] rounded-full">
                        {fmt}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Section: Base Canvas / 3D Can -->
      <section class="bg-neutral-950 border border-neutral-900 rounded-3xl p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <div class="text-xs font-semibold text-[#FFE500] uppercase tracking-wider">Your Canvas • Choose Your Base</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-white">
              {mockgen.featuredModel.name}
            </h2>
            <p class="font-body text-base text-neutral-400 leading-relaxed max-w-2xl">
              {mockgen.featuredModel.description}
            </p>
            <div class="flex flex-wrap gap-6 pt-2 text-sm font-medium">
              <div>
                <span class="text-neutral-500">Material: </span>
                <span class="text-white">{mockgen.featuredModel.material}</span>
              </div>
              <div>
                <span class="text-neutral-500">Dimensions: </span>
                <span class="text-[#FFE500]">{mockgen.featuredModel.dimensions}</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col justify-center">
            <Button
              href={mockgen.featuredModel.interactiveUrl}
              variant="yellow"
              size="lg"
              showArrow={true}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center"
            >
              Start Designing Can
            </Button>
          </div>
        </div>
      </section>

      <!-- Section: Transparent Pricing -->
      <section>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-10 pb-6 border-b border-neutral-900">
          <div>
            <div class="text-xs font-semibold text-[#FFE500] uppercase tracking-wider mb-2">Transparent Pricing</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-white">
              Choose the Plan that Powers Your Workflow
            </h2>
          </div>
          <div class="text-xs font-medium text-neutral-400">
            1 design generation = 20 credits • 4K export = 10 credits
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {mockgen.pricingPlans.map((plan) => (
            <div class={`rounded-3xl p-8 flex flex-col justify-between transition-all ${
              plan.badge
                ? 'bg-neutral-900 border-2 border-[#FFE500] shadow-[0_10px_40px_-10px_rgba(255,229,0,0.25)]'
                : 'bg-neutral-950 border border-neutral-900'
            }`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-display font-black text-2xl text-white">{plan.name}</span>
                  {plan.badge && (
                    <Badge variant="yellow">{plan.badge}</Badge>
                  )}
                </div>

                <div class="mb-4">
                  <span class="font-display font-black text-4xl sm:text-5xl text-[#FFE500]">{plan.price}</span>
                  <span class="text-xs text-neutral-400 ml-1">{plan.billing}</span>
                </div>

                <p class="font-body text-sm text-neutral-400 leading-relaxed mb-6 pb-6 border-b border-neutral-800">
                  {plan.description}
                </p>

                <ul class="space-y-3 text-xs sm:text-sm text-neutral-300 mb-8">
                  {plan.features.map((feat) => (
                    <li class="flex items-start gap-2.5">
                      <span class="text-[#FFE500] font-bold">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <Button
                  href={plan.ctaUrl}
                  variant={plan.badge ? 'yellow' : 'outline'}
                  size="md"
                  showArrow={true}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full"
                >
                  {plan.ctaText}
                </Button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section: FAQs -->
      <section class="max-w-4xl mx-auto pt-10 border-t border-neutral-900">
        <div class="text-xs font-semibold text-[#FFE500] uppercase tracking-wider mb-3">Common Questions</div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-white mb-10">
          Frequently Asked Questions
        </h2>

        <div class="space-y-4">
          {faqs.map((faq, i) => (
            <div class="bg-neutral-950 border border-neutral-900 rounded-2xl p-6 sm:p-8">
              <h3 class="font-display font-bold text-xl text-white mb-3">
                <span class="text-[#FFE500] text-sm mr-2 font-semibold">0{i + 1} •</span>
                {faq.q}
              </h3>
              <p class="font-body text-sm text-neutral-400 leading-relaxed pl-6 border-l-2 border-[#FFE500]/40">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Final Launch Banner -->
      <section class="bg-gradient-to-br from-neutral-950 via-neutral-900 to-black border border-neutral-800 rounded-3xl p-8 sm:p-14 flex flex-col md:flex-row items-center justify-between gap-8 shadow-2xl">
        <div>
          <div class="text-xs font-semibold text-[#FFE500] uppercase tracking-wider mb-2">See Your Packaging Before You Print</div>
          <h2 class="font-display font-black text-3xl sm:text-5xl text-white mb-3">
            Draft Your Design on MockGen
          </h2>
          <p class="font-body text-base text-neutral-400 max-w-xl">
            Join freelance packaging designers and global D2C brand teams moving from idea to printer-ready files in 45 seconds.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <Button
            href="https://trymockgen.vercel.app/?auth=signup"
            variant="yellow"
            size="lg"
            showArrow={true}
            target="_blank"
            rel="noopener noreferrer"
            class="whitespace-nowrap"
          >
            Draft Your Design Free
          </Button>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
