---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { products } from '../data/products';

const wrapforge = products[0];
---

<BaseLayout
  title="Our Products // WrapForge Prototype // OTHR"
  description="OTHR conceives and engineers original software tools. Discover WrapForge, our experimental WebGL packaging visualization prototype."
>
  <div class="py-16 md:py-24 border-b border-[#1D2620]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 font-mono text-xs text-[#5C635B] mb-4">
        <a href="/" class="hover:text-[#C6FF3D] transition-colors">INDEX</a>
        <span>/</span>
        <span class="text-[#C6FF3D]">PRODUCTS</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-[#F5F6F0] mb-4">
            Our Products<span class="text-[#C6FF3D]">.</span>
          </h1>
          <p class="font-body text-xl text-[#A5A9A3] max-w-2xl leading-relaxed">
            We don't just build software for clients. We conceive, architect, and prototype our own commercial tools and creative software experiments.
          </p>
        </div>

        <div class="p-4 bg-[#141A16] border border-[#1D2620] font-mono text-xs">
          <div class="text-[#5C635B] text-[10px]">// PRODUCT STATUS</div>
          <div class="text-[#C6FF3D]">1 PROTOTYPE IN ACTIVE DEVELOPMENT</div>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-[#080B0A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- WrapForge Showcase -->
      <section class="bg-[#0E1410] border border-[#1D2620] p-6 sm:p-12 relative overflow-hidden">
        <div class="max-w-4xl space-y-8">
          <div class="flex flex-wrap items-center gap-3">
            <Badge variant="lime" dot={true}>ACTIVE PROTOTYPE</Badge>
            <Badge variant="outline">{wrapforge.version}</Badge>
            <span class="font-mono text-xs text-[#5C635B]">// TARGET ROADMAP: 2026-2027</span>
          </div>

          <h2 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl text-[#F5F6F0] leading-none">
            {wrapforge.name}
          </h2>

          <p class="font-body text-xl sm:text-2xl text-[#C6FF3D] leading-relaxed">
            {wrapforge.tagline}
          </p>

          <p class="font-body text-base sm:text-lg text-[#A5A9A3] leading-relaxed">
            {wrapforge.description}
          </p>

          <!-- Specifications Table -->
          <div class="pt-6 border-t border-[#1D2620]">
            <div class="font-mono text-xs text-[#5C635B] uppercase tracking-widest mb-4">// PROTOTYPE ARCHITECTURE</div>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
              {wrapforge.specs.map((spec) => (
                <div class="p-4 bg-[#141A16] border border-[#1D2620]">
                  <div class="font-mono text-[10px] text-[#5C635B] uppercase mb-1">{spec.label}</div>
                  <div class="font-mono text-xs text-[#F5F6F0] font-bold">{spec.value}</div>
                </div>
              ))}
            </div>
          </div>

          <!-- Feature Breakdown: Implemented vs Roadmap -->
          <div class="pt-6 border-t border-[#1D2620] space-y-6">
            <div>
              <div class="font-mono text-xs text-[#C6FF3D] uppercase tracking-widest mb-4">// CURRENTLY IMPLEMENTED IN PROTOTYPE</div>
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                {wrapforge.implementedFeatures.map((feat) => (
                  <div class="p-5 bg-[#141A16] border border-[#1D2620]">
                    <div class="font-mono text-xs text-[#C6FF3D] mb-1">✓ LIVE</div>
                    <h3 class="font-display font-bold text-base text-[#F5F6F0] mb-2">{feat.title}</h3>
                    <p class="font-body text-xs text-[#A5A9A3] leading-relaxed">{feat.detail}</p>
                  </div>
                ))}
              </div>
            </div>

            <div>
              <div class="font-mono text-xs text-[#5C635B] uppercase tracking-widest mb-4">// ENGINEERING ROADMAP (PLANNED)</div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {wrapforge.roadmapFeatures.map((feat) => (
                  <div class="p-5 bg-[#0E1410] border border-[#2A362E]">
                    <div class="font-mono text-xs text-[#5C635B] mb-1">○ IN RESEARCH</div>
                    <h3 class="font-display font-bold text-base text-[#F5F6F0] mb-2">{feat.title}</h3>
                    <p class="font-body text-xs text-[#A5A9A3] leading-relaxed">{feat.detail}</p>
                  </div>
                ))}
              </div>
            </div>
          </div>

          <!-- Prototype Waitlist Form -->
          <div class="pt-8 border-t border-[#1D2620] bg-[#141A16] p-6 sm:p-8 border">
            <h3 class="font-display font-bold text-2xl text-[#F5F6F0] mb-2">Follow Prototype Progress</h3>
            <p class="font-body text-sm text-[#A5A9A3] mb-6">
              Leave your email to receive technical devlogs and early testing invitations when interactive dieline imports open.
            </p>

            <form id="wrapforge-alpha-form" class="flex flex-col sm:flex-row gap-4">
              <input
                type="email"
                required
                placeholder="designer@studio.com"
                class="bg-[#080B0A] border border-[#2A362E] focus:border-[#C6FF3D] focus:outline-none p-3.5 font-mono text-sm text-[#F5F6F0] placeholder-[#5C635B] flex-grow"
              />
              <button
                type="submit"
                class="px-8 py-3.5 bg-[#C6FF3D] hover:bg-[#d4ff66] text-[#080B0A] font-mono text-xs uppercase tracking-wider font-bold transition-all cursor-pointer whitespace-nowrap"
              >
                REQUEST EARLY ACCESS
              </button>
            </form>

            <div id="alpha-confirm-msg" class="hidden mt-4 font-mono text-xs text-[#C6FF3D]">
              ✓ NOTED. WE WILL NOTIFY YOU AS ALPHA BUILDS PROGRESS.
            </div>
          </div>
        </div>
      </section>

      <!-- Custom Project Prompt -->
      <section class="bg-[#141A16] border border-[#1D2620] p-8 sm:p-12 flex flex-col md:flex-row items-center justify-between gap-6">
        <div>
          <div class="font-mono text-xs text-[#C6FF3D] uppercase tracking-wider mb-2">// NEED CUSTOM 3D OR WEBGL?</div>
          <h3 class="font-display font-bold text-2xl sm:text-3xl text-[#F5F6F0] mb-2">
            Looking for bespoke WebGL or 3D engineering for your brand?
          </h3>
          <p class="font-body text-sm text-[#A5A9A3] max-w-xl">
            We build high-performance 3D configurators, custom interactive shaders, and kinetic web experiences for businesses worldwide.
          </p>
        </div>

        <Button href="/contact?service=custom-software" variant="primary" size="md" showArrow={true}>
          Start a 3D Web Project
        </Button>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  function initProductsPage() {
    const form = document.getElementById('wrapforge-alpha-form') as HTMLFormElement;
    const confirm = document.getElementById('alpha-confirm-msg');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (confirm) confirm.classList.remove('hidden');
      form.reset();
    });
  }

  initProductsPage();
  document.addEventListener('astro:page-load', initProductsPage);
</script>
