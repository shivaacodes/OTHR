---
import BaseLayout from '../layouts/BaseLayout.astro';
import Badge from '../components/ui/Badge.astro';
import Button from '../components/ui/Button.astro';
import Icon from '../components/ui/Icon.astro';
import { products } from '../data/products';

const mockgen = products[0];

const faqs = [
  {
    q: 'Is this just another AI image generator?',
    a: 'No. Unlike traditional generative AI tools that hallucinate flat 2D images with warped typography and incorrect perspective, MockGen is a manufacturing-aware 3D asset pipeline. It outputs real layered files (PSD, OBJ, GLB) and UV dielines with precise print dimensions and bleed margins.'
  },
  {
    q: 'Can I edit the designs and layers individually?',
    a: 'Yes. MockGen outputs complete layered project files. You can isolate logos, surface condensation, typography, and base aluminum/foil finishes, making adjustments directly in Photoshop or your 3D package.'
  },
  {
    q: 'What do I get with the Creator plan?',
    a: 'The Creator plan includes 1,000 credits per month (about 20–25 completed packaging projects), full commercial licensing rights, high-resolution 4K render exports, and access to advanced materials like metallic foil stamping and spot UV coatings.'
  },
  {
    q: 'What formats can I export for my printer or client?',
    a: 'You can export layered Adobe Photoshop (.PSD) documents, 3D Object (.OBJ) geometry, web-ready 3D (.GLB) files for browser inspection, and flat UV dieline maps ready for physical manufacturing.'
  }
];
---

<BaseLayout
  title="MockGen // AI Generated 3D Mockups Ready for Print // OTHR Products"
  description="MockGen is a professional 3D packaging and print asset pipeline. Generate production-ready packaging files with exact dimensions, bleed, and layers in 45 seconds."
>
  <!-- Page Header -->
  <div class="py-16 md:py-24 border-b border-[#1D2620] relative overflow-hidden">
    <!-- Neon Orange Background Glow -->
    <div class="absolute right-[10%] top-[10%] w-[450px] h-[450px] bg-[#FF5500]/10 rounded-full blur-[140px] pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="flex items-center gap-2 font-mono text-xs text-[#5C635B] mb-4">
        <a href="/" class="hover:text-[#FF5500] transition-colors">INDEX</a>
        <span>/</span>
        <span class="text-[#FF5500]">PRODUCTS</span>
        <span>/</span>
        <span class="text-[#F5F6F0]">MOCKGEN</span>
      </div>

      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <Badge variant="orange" dot={true}>LIVE COMMERCIAL SAAS</Badge>
            <span class="font-mono text-xs text-[#A5A9A3]">// WEB & PRINT PIPELINE</span>
          </div>
          <h1 class="font-display font-extrabold text-5xl sm:text-7xl lg:text-8xl tracking-tight text-[#F5F6F0] mb-4">
            MockGen<span class="text-[#FF5500]">.</span>
          </h1>
          <p class="font-display font-bold text-2xl sm:text-3xl text-[#FF5500] max-w-2xl leading-snug mb-3">
            {mockgen.tagline}
          </p>
          <p class="font-body text-lg text-[#A5A9A3] max-w-2xl leading-relaxed">
            {mockgen.subtitle}
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <Button
            href="https://trymockgen.vercel.app/?auth=signup"
            variant="orange"
            size="lg"
            showArrow={true}
            target="_blank"
            rel="noopener noreferrer"
          >
            Get Started Free
          </Button>
          <Button
            href="https://trymockgen.vercel.app/#demo"
            variant="orange-outline"
            size="lg"
            target="_blank"
            rel="noopener noreferrer"
          >
            Watch 30s Demo
          </Button>
        </div>
      </div>
    </div>
  </div>

  <div class="py-16 md:py-24 bg-[#080B0A]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">

      <!-- Section: Value Proposition & Transparent Workflow -->
      <section class="bg-[#0E1410] border-2 border-[#FF5500]/50 rounded-xl p-8 sm:p-12 relative overflow-hidden shadow-[0_0_40px_-10px_rgba(255,85,0,0.3)]">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-7 space-y-6">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#FF5500] animate-ping"></span>
              <span class="font-mono text-xs text-[#FF5500] font-bold uppercase tracking-wider">
                TRANSPARENT WORKFLOW // NO AI BLACKBOX
              </span>
            </div>

            <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-[#F5F6F0] tracking-tight leading-tight">
              Visualize Production-Ready Packaging Instantly<span class="text-[#FF5500]">.</span>
            </h2>

            <p class="font-body text-lg text-[#F5F6F0] leading-relaxed">
              Unlike normal AI image generators that produce flat, unusable graphics with distorted text, MockGen generates print-ready packaging files with exact dimensions, bleed margins, and isolated layers.
            </p>

            <p class="font-body text-base text-[#A5A9A3] leading-relaxed">
              Export high-resolution assets and send them straight to your printer or client. Perfect for freelance designers, agile design agencies, and high-growth physical D2C brands.
            </p>

            <div class="p-4 bg-[#141A16] border border-[#FF5500]/30 rounded-lg flex items-center justify-between font-mono text-xs">
              <span class="text-[#FF5500] font-bold">⚡ PROOF POINT:</span>
              <span class="text-[#F5F6F0]">FROM IDEA TO PRINTER FILE IN 45 SECONDS</span>
            </div>
          </div>

          <div class="lg:col-span-5 bg-[#141A16] border border-[#1D2620] rounded-xl p-6 sm:p-8 space-y-6">
            <div class="font-mono text-xs text-[#5C635B] uppercase tracking-wider border-b border-[#1D2620] pb-3">
              // PRODUCTION CAPABILITIES
            </div>

            <div class="space-y-4">
              {mockgen.highlights.map((h) => (
                <div class="flex items-center justify-between font-mono text-xs pb-3 border-b border-[#1D2620]/60">
                  <span class="text-[#A5A9A3]">{h.label}:</span>
                  <span class="text-[#FF5500] font-bold">{h.value}</span>
                </div>
              ))}
            </div>

            <div class="pt-2">
              <a
                href="https://trymockgen.vercel.app/dashboard?model=%2Fmodels%2Fsoda_can.glb"
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3 px-4 bg-[#FF5500] hover:bg-[#ff6e26] text-[#080B0A] font-mono text-xs font-bold uppercase tracking-wider rounded-md transition-colors flex items-center justify-center gap-2"
              >
                <span>OPEN 3D SODA CAN STUDIO</span>
                <Icon name="ArrowUpRight" size={14} />
              </a>
              <div class="text-[10px] font-mono text-[#5C635B] text-center mt-2">
                Join Free • No Credit Card Required
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Section: 4-Step Production Pipeline -->
      <section>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12 pb-6 border-b border-[#1D2620]">
          <div>
            <div class="font-mono text-xs text-[#FF5500] uppercase tracking-widest mb-2">// THE 4-STEP PIPELINE</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-[#F5F6F0]">
              How MockGen Works
            </h2>
          </div>
          <p class="font-body text-sm text-[#A5A9A3] max-w-md">
            A deterministic engineering workflow from prompt conception to production-grade physical manufacturing files.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {mockgen.workflow.map((item) => (
            <div class="bg-[#0E1410] border border-[#1D2620] hover:border-[#FF5500]/50 rounded-xl p-6 sm:p-8 flex flex-col justify-between transition-all group">
              <div>
                <span class="font-mono text-xs text-[#FF5500] font-bold">[{item.step}]</span>
                <h3 class="font-display font-bold text-xl text-[#F5F6F0] group-hover:text-[#FF5500] transition-colors mt-3 mb-3">
                  {item.title}
                </h3>
                <p class="font-body text-sm text-[#A5A9A3] leading-relaxed mb-6">
                  {item.description}
                </p>
              </div>

              {item.formats && (
                <div class="pt-4 border-t border-[#1D2620] space-y-1.5">
                  <div class="font-mono text-[10px] text-[#5C635B] uppercase">// EXPORTABLE ASSETS</div>
                  <div class="flex flex-wrap gap-1.5">
                    {item.formats.map((fmt) => (
                      <span class="px-2 py-0.5 bg-[#141A16] border border-[#2A362E] text-[10px] font-mono text-[#FF5500] rounded-[3px]">
                        {fmt}
                      </span>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </section>

      <!-- Section: Base Canvas / 3D Can -->
      <section class="bg-[#0E1410] border border-[#1D2620] rounded-xl p-8 sm:p-12">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-8 space-y-4">
            <div class="font-mono text-xs text-[#FF5500] uppercase tracking-widest">// YOUR CANVAS // CHOOSE YOUR BASE</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-[#F5F6F0]">
              {mockgen.featuredModel.name}
            </h2>
            <p class="font-body text-base text-[#A5A9A3] leading-relaxed max-w-2xl">
              {mockgen.featuredModel.description}
            </p>
            <div class="flex flex-wrap gap-6 pt-2 font-mono text-xs">
              <div>
                <span class="text-[#5C635B]">MATERIAL: </span>
                <span class="text-[#F5F6F0]">{mockgen.featuredModel.material}</span>
              </div>
              <div>
                <span class="text-[#5C635B]">DIMENSIONS: </span>
                <span class="text-[#FF5500]">{mockgen.featuredModel.dimensions}</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-4 flex flex-col justify-center">
            <Button
              href={mockgen.featuredModel.interactiveUrl}
              variant="orange"
              size="lg"
              showArrow={true}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full text-center"
            >
              Start Designing Can
            </Button>
          </div>
        </div>
      </section>

      <!-- Section: Transparent Pricing -->
      <section>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-12 pb-6 border-b border-[#1D2620]">
          <div>
            <div class="font-mono text-xs text-[#FF5500] uppercase tracking-widest mb-2">// TRANSPARENT PRICING</div>
            <h2 class="font-display font-bold text-3xl sm:text-4xl text-[#F5F6F0]">
              Choose the Plan that Powers Your Workflow
            </h2>
          </div>
          <div class="font-mono text-xs text-[#A5A9A3]">
            1 design generation = 20 credits • 4K export = 10 credits
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {mockgen.pricingPlans.map((plan) => (
            <div class={`rounded-xl p-8 flex flex-col justify-between transition-all ${
              plan.badge
                ? 'bg-[#141A16] border-2 border-[#FF5500] shadow-[0_0_30px_-5px_rgba(255,85,0,0.3)]'
                : 'bg-[#0E1410] border border-[#1D2620]'
            }`}>
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="font-display font-black text-2xl text-[#F5F6F0]">{plan.name}</span>
                  {plan.badge && (
                    <Badge variant="orange">{plan.badge}</Badge>
                  )}
                </div>

                <div class="mb-4">
                  <span class="font-display font-black text-4xl sm:text-5xl text-[#FF5500]">{plan.price}</span>
                  <span class="font-mono text-xs text-[#5C635B] ml-1">{plan.billing}</span>
                </div>

                <p class="font-body text-sm text-[#A5A9A3] leading-relaxed mb-6 pb-6 border-b border-[#1D2620]">
                  {plan.description}
                </p>

                <ul class="space-y-3 font-mono text-xs text-[#F5F6F0] mb-8">
                  {plan.features.map((feat) => (
                    <li class="flex items-start gap-2">
                      <span class="text-[#FF5500] font-bold">✓</span>
                      <span>{feat}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div>
                <Button
                  href={plan.ctaUrl}
                  variant={plan.badge ? 'orange' : 'outline'}
                  size="md"
                  showArrow={true}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full"
                >
                  {plan.ctaText}
                </Button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Section: FAQs -->
      <section class="max-w-4xl mx-auto pt-12 border-t border-[#1D2620]">
        <div class="font-mono text-xs text-[#FF5500] uppercase tracking-widest mb-3">// COMMON QUESTIONS</div>
        <h2 class="font-display font-bold text-3xl sm:text-4xl text-[#F5F6F0] mb-10">
          Frequently Asked Questions
        </h2>

        <div class="space-y-6">
          {faqs.map((faq, i) => (
            <div class="bg-[#0E1410] border border-[#1D2620] rounded-xl p-6 sm:p-8">
              <h3 class="font-display font-bold text-xl text-[#F5F6F0] mb-3">
                <span class="text-[#FF5500] font-mono text-sm mr-2">0{i + 1} //</span>
                {faq.q}
              </h3>
              <p class="font-body text-sm text-[#A5A9A3] leading-relaxed pl-6 border-l-2 border-[#FF5500]/40">
                {faq.a}
              </p>
            </div>
          ))}
        </div>
      </section>

      <!-- Final Launch Banner -->
      <section class="bg-gradient-to-r from-[#141A16] to-[#1c0f08] border border-[#FF5500]/50 rounded-xl p-8 sm:p-14 flex flex-col md:flex-row items-center justify-between gap-8 shadow-[0_0_40px_-10px_rgba(255,85,0,0.3)]">
        <div>
          <div class="font-mono text-xs text-[#FF5500] uppercase tracking-widest mb-2">// SEE YOUR PACKAGING BEFORE YOU PRINT</div>
          <h2 class="font-display font-black text-3xl sm:text-5xl text-[#F5F6F0] mb-3">
            Draft Your Design on MockGen.
          </h2>
          <p class="font-body text-base text-[#A5A9A3] max-w-xl">
            Join freelance packaging designers and global D2C brand teams moving from idea to printer-ready files in 45 seconds.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto">
          <Button
            href="https://trymockgen.vercel.app/?auth=signup"
            variant="orange"
            size="lg"
            showArrow={true}
            target="_blank"
            rel="noopener noreferrer"
            class="whitespace-nowrap"
          >
            Draft Your Design Free
          </Button>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
