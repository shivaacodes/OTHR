---
export interface Props {
  variant?: 'lime' | 'blue' | 'primary' | 'muted' | 'outline' | 'alert' | 'orange' | 'yellow';
  size?: 'sm' | 'md';
  class?: string;
  dot?: boolean;
}

const { variant = 'muted', size = 'sm', class: className = '', dot = false } = Astro.props;

const variantStyles = {
  primary: 'bg-[#0B3C85]/10 text-[#0B3C85] border-[#0B3C85]/25',
  lime: 'bg-[#0B3C85]/10 text-[#0B3C85] border-[#0B3C85]/25',
  blue: 'bg-[#0B3C85]/10 text-[#0B3C85] border-[#0B3C85]/25',
  muted: 'bg-[#EDE9DF] text-neutral-700 border-[#D1CABE]',
  outline: 'bg-transparent text-neutral-600 border-[#D1CABE]',
  alert: 'bg-amber-500/15 text-amber-700 border-amber-500/30',
  orange: 'bg-[#FF5500]/15 text-[#FF5500] border-[#FF5500]/40',
  yellow: 'bg-[#FFE500]/25 text-amber-900 border-amber-400/40'
};

const sizeStyles = {
  sm: 'text-xs px-3 py-1',
  md: 'text-xs px-3.5 py-1.5'
};
---

<span class={`inline-flex items-center gap-1.5 font-body font-semibold rounded-full border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  {dot && (
    <span class={`w-1.5 h-1.5 rounded-full ${variant === 'primary' || variant === 'lime' || variant === 'blue' ? 'bg-[#0B3C85]' : variant === 'yellow' ? 'bg-[#FFE500]' : variant === 'orange' ? 'bg-[#FF5500]' : 'bg-current'}`} />
  )}
  <slot />
</span>
