---
export interface Props {
  variant?: 'lime' | 'muted' | 'outline' | 'alert' | 'orange';
  size?: 'sm' | 'md';
  class?: string;
  dot?: boolean;
}

const { variant = 'muted', size = 'sm', class: className = '', dot = false } = Astro.props;

const variantStyles = {
  lime: 'bg-[#C6FF3D]/15 text-[#C6FF3D] border-[#C6FF3D]/30',
  muted: 'bg-neutral-900 text-neutral-300 border-neutral-800',
  outline: 'bg-transparent text-neutral-400 border-neutral-800',
  alert: 'bg-amber-500/15 text-amber-300 border-amber-500/30',
  orange: 'bg-[#FF5500]/15 text-[#FF5500] border-[#FF5500]/40'
};

const sizeStyles = {
  sm: 'text-xs px-3 py-1',
  md: 'text-xs px-3.5 py-1.5'
};
---

<span class={`inline-flex items-center gap-1.5 font-body font-semibold rounded-full border ${variantStyles[variant]} ${sizeStyles[size]} ${className}`}>
  {dot && (
    <span class={`w-1.5 h-1.5 rounded-full ${variant === 'lime' ? 'bg-[#C6FF3D] shadow-[0_0_8px_#C6FF3D]' : variant === 'orange' ? 'bg-[#FF5500] shadow-[0_0_8px_#FF5500]' : 'bg-current'}`} />
  )}
  <slot />
</span>
