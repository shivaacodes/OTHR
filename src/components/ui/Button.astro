---
import Icon from './Icon.astro';

export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  showArrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  showArrow = false,
  class: className = '',
  target,
  rel,
  id,
  type = 'button',
  'aria-label': ariaLabel
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-mono font-medium transition-all duration-300 relative group overflow-hidden select-none cursor-pointer';

const variantStyles = {
  primary: 'bg-[#C6FF3D] text-[#080B0A] hover:bg-[#d4ff66] shadow-[0_0_24px_-6px_rgba(198,255,61,0.45)] hover:shadow-[0_0_32px_0px_rgba(198,255,61,0.6)] active:scale-[0.98]',
  secondary: 'bg-[#141A16] text-[#F5F6F0] border border-[#1D2620] hover:border-[#C6FF3D]/50 hover:bg-[#1B241E] active:scale-[0.98]',
  outline: 'bg-transparent text-[#F5F6F0] border border-[#2A362E] hover:border-[#C6FF3D] hover:text-[#C6FF3D] active:scale-[0.98]',
  ghost: 'bg-transparent text-[#A5A9A3] hover:text-[#C6FF3D] p-0'
};

const sizeStyles = {
  sm: 'text-xs tracking-wider uppercase px-3.5 py-1.5 gap-2',
  md: 'text-xs tracking-wider uppercase px-5 py-3 gap-2.5',
  lg: 'text-sm tracking-wider uppercase px-7 py-4 gap-3'
};

const combinedClasses = `${baseStyles} ${variantStyles[variant]} ${variant === 'ghost' ? '' : sizeStyles[size]} ${className}`;
---

{href ? (
  <a href={href} class={combinedClasses} target={target} rel={rel} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </a>
) : (
  <button type={type} class={combinedClasses} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </button>
)}
