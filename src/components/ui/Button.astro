---
import Icon from './Icon.astro';

export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'orange' | 'orange-outline';
  size?: 'sm' | 'md' | 'lg';
  showArrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  showArrow = false,
  class: className = '',
  target,
  rel,
  id,
  type = 'button',
  'aria-label': ariaLabel
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-body font-semibold rounded-full transition-all duration-300 relative group overflow-hidden select-none cursor-pointer';

const variantStyles = {
  primary: 'bg-[#C6FF3D] text-black hover:bg-[#d4ff66] shadow-[0_4px_20px_rgba(198,255,61,0.25)] hover:shadow-[0_6px_28px_rgba(198,255,61,0.4)] active:scale-[0.98]',
  secondary: 'bg-neutral-900 text-white border border-neutral-800 hover:border-neutral-700 hover:bg-neutral-800 active:scale-[0.98]',
  outline: 'bg-transparent text-white border border-neutral-700 hover:border-white hover:text-white active:scale-[0.98]',
  ghost: 'bg-transparent text-neutral-400 hover:text-white p-0',
  orange: 'bg-[#FF5500] text-black font-bold hover:bg-[#ff6e26] shadow-[0_4px_20px_rgba(255,85,0,0.3)] hover:shadow-[0_6px_28px_rgba(255,85,0,0.5)] active:scale-[0.98]',
  'orange-outline': 'bg-transparent text-[#FF5500] border border-[#FF5500]/60 hover:border-[#FF5500] hover:bg-[#FF5500]/10 active:scale-[0.98]'
};

const sizeStyles = {
  sm: 'text-xs px-4 py-2 gap-1.5',
  md: 'text-sm px-6 py-3 gap-2',
  lg: 'text-sm sm:text-base px-8 py-3.5 gap-2.5'
};

const combinedClasses = `${baseStyles} ${variantStyles[variant]} ${variant === 'ghost' ? '' : sizeStyles[size]} ${className}`;
---

{href ? (
  <a href={href} class={combinedClasses} target={target} rel={rel} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </a>
) : (
  <button type={type} class={combinedClasses} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </button>
)}
