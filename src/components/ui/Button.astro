---
import Icon from './Icon.astro';

export interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost' | 'orange' | 'orange-outline' | 'yellow' | 'yellow-outline';
  size?: 'sm' | 'md' | 'lg';
  showArrow?: boolean;
  class?: string;
  target?: string;
  rel?: string;
  id?: string;
  type?: 'button' | 'submit' | 'reset';
  'aria-label'?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  showArrow = false,
  class: className = '',
  target,
  rel,
  id,
  type = 'button',
  'aria-label': ariaLabel
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-body font-semibold rounded-full transition-all duration-300 relative group overflow-hidden select-none cursor-pointer';

const variantStyles = {
  primary: 'bg-[#0B3C85] text-[#F5F2EB] hover:bg-[#082D64] shadow-sm active:scale-[0.98]',
  secondary: 'bg-[#EDE9DF] text-[#0D111C] border border-[#D1CABE] hover:border-[#0B3C85] hover:bg-white active:scale-[0.98]',
  outline: 'bg-transparent text-[#0B3C85] border border-[#0B3C85] hover:bg-[#0B3C85] hover:text-[#F5F2EB] active:scale-[0.98]',
  ghost: 'bg-transparent text-neutral-600 hover:text-[#0D111C] p-0',
  orange: 'bg-[#FF5500] text-black font-bold hover:bg-[#ff6e26] shadow-sm active:scale-[0.98]',
  'orange-outline': 'bg-transparent text-[#FF5500] border border-[#FF5500]/60 hover:border-[#FF5500] hover:bg-[#FF5500]/10 active:scale-[0.98]',
  yellow: 'bg-[#FFE500] text-black font-bold hover:bg-[#ffea33] shadow-sm active:scale-[0.98]',
  'yellow-outline': 'bg-transparent text-[#FFE500] border border-[#FFE500]/60 hover:border-[#FFE500] hover:bg-[#FFE500]/10 active:scale-[0.98]'
};

const sizeStyles = {
  sm: 'text-xs px-4 py-2 gap-1.5',
  md: 'text-sm px-6 py-3 gap-2',
  lg: 'text-sm sm:text-base px-8 py-3.5 gap-2.5'
};

const combinedClasses = `${baseStyles} ${variantStyles[variant]} ${variant === 'ghost' ? '' : sizeStyles[size]} ${className}`;
---

{href ? (
  <a href={href} class={combinedClasses} target={target} rel={rel} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </a>
) : (
  <button type={type} class={combinedClasses} id={id} aria-label={ariaLabel}>
    <slot />
    {showArrow && (
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-1 group-hover:-translate-y-1">
        <Icon name="ArrowUpRight" size={size === 'sm' ? 14 : 16} />
      </span>
    )}
  </button>
)}
