---
import Icon from '../ui/Icon.astro';
---

<section class="relative min-h-[80vh] flex items-center overflow-hidden bg-black border-b border-neutral-900 pt-24 pb-20">
  <!-- Subtle Ambient Glow -->
  <div class="absolute right-[15%] top-[25%] w-[500px] h-[500px] bg-[#C6FF3D]/5 rounded-full blur-[160px] pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
    <div class="max-w-3xl">
      <!-- Main Headline (Punchy, confident) -->
      <h1 class="font-display font-black text-4xl sm:text-6xl lg:text-7xl tracking-tight leading-[1.04] text-white mb-6 select-none">
        High-performance software and <span class="text-[#C6FF3D]">digital flagships</span>
      </h1>

      <!-- Supporting Statement -->
      <p class="font-body text-base sm:text-lg lg:text-xl text-neutral-400 max-w-2xl leading-relaxed mb-10">
        We design and engineer bespoke web flagships, internal automation systems, and original software products. Built with engineering precision.
      </p>

      <!-- Capability Highlights -->
      <div class="pt-8 border-t border-neutral-900 flex flex-wrap items-center gap-8 text-xs text-neutral-400">
        <div>
          <span class="text-neutral-500 block text-[11px] uppercase tracking-wider mb-0.5">Flagship Web</span>
          <span class="text-white font-medium">High-Speed Edge Architecture</span>
        </div>
        <div>
          <span class="text-neutral-500 block text-[11px] uppercase tracking-wider mb-0.5">Automation</span>
          <span class="text-white font-medium">Bespoke Internal Systems</span>
        </div>
        <div>
          <span class="text-neutral-500 block text-[11px] uppercase tracking-wider mb-0.5">Products</span>
          <a href="/products" class="text-[#FFE500] hover:underline font-medium">MockGen 3D Pipeline →</a>
        </div>
      </div>
    </div>
  </div>
</section>
