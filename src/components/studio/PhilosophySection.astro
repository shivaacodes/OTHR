---
import Icon from '../ui/Icon.astro';

const pillars = [
  {
    number: '01',
    title: 'Function First',
    desc: 'A breathtaking interaction that fails to solve the underlying problem is decorative waste. We build software that performs critical work under load with zero fragility.'
  },
  {
    number: '02',
    title: 'Performance is Design',
    desc: 'Speed is not an optimization ticket filed before launch. Speed is the architecture. Sub-second execution with zero stutter and 95+ Lighthouse baselines.'
  },
  {
    number: '03',
    title: 'Zero Bureaucracy',
    desc: 'You work directly with the senior engineers who design and build your systems. Zero sales reps, zero account managers, and complete technical transparency.'
  }
];
---

<section class="py-14 sm:py-18 bg-black border-b border-neutral-900" id="philosophy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-neutral-900">
      <div>
        <span class="text-[11px] font-semibold text-[#C6FF3D] uppercase tracking-wider block mb-1">Studio Ethos</span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-white">
          How We Work
        </h2>
      </div>
      <a
        href="/studio"
        class="text-xs font-semibold text-neutral-400 hover:text-[#C6FF3D] flex items-center gap-1 transition-colors"
      >
        <span>Full Studio Story</span>
        <Icon name="ArrowUpRight" size={14} />
      </a>
    </div>

    <!-- Crisp 3-Pillar Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {pillars.map((p) => (
        <div class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all group">
          <div>
            <div class="mb-4">
              <span class="text-xs font-mono font-bold text-[#C6FF3D] bg-[#C6FF3D]/10 px-2 py-0.5 rounded-full">
                {p.number}
              </span>
            </div>
            <h3 class="font-display font-bold text-xl sm:text-2xl text-white group-hover:text-[#C6FF3D] transition-colors mb-2.5">
              {p.title}
            </h3>
            <p class="font-body text-sm text-neutral-400 leading-relaxed">
              {p.desc}
            </p>
          </div>

          <div class="pt-5 mt-6 border-t border-neutral-900 text-[11px] font-mono text-neutral-500">
            OTHR Studio Principle
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
