---
import { studioData } from '../../data/studio';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
---

<section class="py-24 md:py-32 bg-black border-b border-neutral-900 relative" id="philosophy">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 pb-8 border-b border-neutral-900">
      <div>
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-3" data-reveal>
          Philosophy & Ethos
        </div>
        <h2 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-white" data-reveal data-delay="0.1">
          How We Think
        </h2>
      </div>
      <p class="font-body text-base text-neutral-400 max-w-md" data-reveal data-delay="0.2">
        We reject the corporate playbook of generic templates and bloated abstractions. Here is the operational code we work by.
      </p>
    </div>

    <!-- 5 Editorial Principles in Alternating Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
      {studioData.principles.map((p, idx) => (
        <div
          class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-3xl p-8 flex flex-col justify-between group transition-all"
          data-reveal
          data-delay={0.08 * idx}
        >
          <div>
            <div class="mb-4">
              <span class="text-xs font-bold text-[#C6FF3D] bg-[#C6FF3D]/10 px-2.5 py-1 rounded-full">{p.number}</span>
            </div>
            <h3 class="font-display font-bold text-2xl text-white group-hover:text-[#C6FF3D] transition-colors mb-3">
              {p.headline}
            </h3>
            <p class="font-body text-sm text-neutral-400 leading-relaxed">
              {p.elaboration}
            </p>
          </div>

          <div class="mt-8 pt-4 border-t border-neutral-900 text-[11px] font-semibold text-neutral-500 uppercase tracking-wider">
            OTHR Principle
          </div>
        </div>
      ))}

      <!-- 6th Special Manifesto Box -->
      <div
        class="bg-neutral-900 border border-neutral-800 rounded-3xl p-8 flex flex-col justify-between relative overflow-hidden"
        data-reveal
        data-delay="0.4"
      >
        <div class="absolute -right-6 -bottom-6 w-32 h-32 bg-[#C6FF3D]/10 rounded-full blur-2xl pointer-events-none"></div>

        <div>
          <div class="mb-4">
            <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-full">Manifesto</span>
          </div>
          <h3 class="font-display font-bold text-2xl text-white mb-4">
            Brutally fast underneath. Unreasonably polished on top.
          </h3>
          <p class="font-body text-sm text-neutral-400 leading-relaxed">
            If it stutters, it’s broken. If it looks like every other software studio, it’s irrelevant.
          </p>
        </div>

        <div class="mt-8 pt-4 border-t border-neutral-800 flex items-center justify-between">
          <Button href="/studio" variant="outline" size="sm" showArrow={true}>
            Studio Story
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
