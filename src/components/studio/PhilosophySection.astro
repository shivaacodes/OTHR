---
import Icon from '../ui/Icon.astro';

const agencyFriction = [
  {
    title: 'Junior Dev Bait-and-Switch',
    desc: 'Senior partners pitch your project, then hand execution off to inexperienced interns or offshore layers.'
  },
  {
    title: '50-Page Change Orders',
    desc: 'Opaque hourly billing structures and endless scope debates that inflate your final bill by 2x.'
  },
  {
    title: 'Sluggish Multi-MB Templates',
    desc: 'Generic corporate themes bloated with unused plugins that stutter on mobile devices and kill conversion.'
  },
  {
    title: 'Fragile No-Code Zaps',
    desc: 'Brittle automations stitched together with zero error logging or retry logic, silently failing under load.'
  }
];

const othrCommitments = [
  {
    title: '100% Engineer-Led Partnership',
    desc: 'Direct collaboration with Shiva Sajay from initial architecture through production release. Zero sales reps.'
  },
  {
    title: 'Transparent Fixed-Scope Sprints',
    desc: 'Clear milestone pricing, predictable delivery timelines (1–4 weeks), and zero unexpected invoice surprises.'
  },
  {
    title: 'Sub-Second Edge Performance',
    desc: '95+ Mobile Lighthouse scores, sub-50ms static edge distribution, and fluid 60fps kinetic typography.'
  },
  {
    title: 'Battle-Tested Software Architecture',
    desc: 'Typed, compiled, reliable systems in Go, Python, Astro, and PostgreSQL designed to permanently eliminate toil.'
  }
];
---

<!-- Inverted Neon Lime Section: High-Contrast Visual Breakpoint -->
<section class="py-20 sm:py-28 bg-[#C6FF3D] text-black border-y border-neutral-900 overflow-hidden relative" id="standards">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Centered, Punchy, High Impact) -->
    <div class="max-w-3xl mb-14 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-black text-[#C6FF3D] rounded-md text-xs font-bold uppercase tracking-wider mb-4">
        <span>⚡ The OTHR Standard</span>
      </div>

      <h2 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl text-black tracking-tight leading-[1.05] mb-4">
        Engineered for clarity.<br class="hidden sm:inline" />
        Zero agency circus.
      </h2>

      <p class="font-body text-base sm:text-lg text-black/80 font-medium leading-relaxed max-w-2xl">
        Most digital agencies bill you for overhead, account managers, and interchangeable templates. Here is what you never deal with when partnering directly with OTHR.
      </p>
    </div>

    <!-- Comparison Grid: Agency Friction vs OTHR Commitment -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch mb-12">
      
      <!-- Left Card: What You Never Deal With (Agency Model) -->
      <div class="bg-black/5 border border-black/15 rounded-2xl p-6 sm:p-9 flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-black/10">
            <span class="text-xs font-mono font-bold text-red-600 bg-red-600/10 px-2.5 py-1 rounded-md">
              ✕ What You Never Deal With
            </span>
            <span class="text-xs font-semibold text-black/60 uppercase tracking-wider">Traditional Agency</span>
          </div>

          <div class="space-y-5">
            {agencyFriction.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 font-display font-bold text-base sm:text-lg text-black">
                  <span class="text-red-600 font-black">✕</span>
                  <span>{item.title}</span>
                </div>
                <p class="font-body text-sm text-black/75 leading-relaxed pl-5">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-8 border-t border-black/10 text-xs font-mono text-black/60">
          Result: Sluggish delivery, inflated costs, fragile software.
        </div>
      </div>

      <!-- Right Card: The OTHR Commitment (Solid Black Centerpiece) -->
      <div class="bg-black text-white rounded-2xl p-6 sm:p-9 shadow-2xl flex flex-col justify-between">
        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-neutral-800">
            <span class="text-xs font-mono font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-md">
              ✓ The OTHR Guarantee
            </span>
            <span class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider">Direct Engineering</span>
          </div>

          <div class="space-y-5">
            {othrCommitments.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 font-display font-bold text-base sm:text-lg text-white">
                  <span class="text-[#C6FF3D] font-black">✓</span>
                  <span>{item.title}</span>
                </div>
                <p class="font-body text-sm text-neutral-400 leading-relaxed pl-5">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-8 border-t border-neutral-800 text-xs font-mono text-[#C6FF3D]">
          Result: Sub-second speed, typed codebases, predictable outcomes.
        </div>
      </div>

    </div>

    <!-- Bottom Metrics & Direct CTA Bar -->
    <div class="pt-8 border-t border-black/15 flex flex-col md:flex-row md:items-center justify-between gap-6">
      
      <!-- Micro-Metrics -->
      <div class="flex flex-wrap items-center gap-6 sm:gap-10 text-xs">
        <div>
          <span class="font-display font-black text-2xl text-black block leading-none mb-1">95+</span>
          <span class="text-black/70 font-semibold">Mobile Lighthouse Baseline</span>
        </div>
        <div>
          <span class="font-display font-black text-2xl text-black block leading-none mb-1">&lt;50ms</span>
          <span class="text-black/70 font-semibold">Edge Static Deployment</span>
        </div>
        <div>
          <span class="font-display font-black text-2xl text-black block leading-none mb-1">0</span>
          <span class="text-black/70 font-semibold">Middlemen or Account Reps</span>
        </div>
      </div>

      <!-- Action Buttons -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
        <a
          href="/contact"
          class="bg-black hover:bg-neutral-900 text-[#C6FF3D] font-bold text-sm px-6 py-3.5 rounded-lg transition-all shadow-lg active:scale-95 inline-flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>Start a Project</span>
          <Icon name="ArrowUpRight" size={15} />
        </a>
        <a
          href="/services"
          class="bg-black/10 hover:bg-black/20 text-black font-bold text-sm px-5 py-3.5 rounded-lg transition-all active:scale-95 inline-flex items-center justify-center gap-2 cursor-pointer text-center"
        >
          <span>Explore Services</span>
        </a>
      </div>

    </div>

  </div>
</section>
