---
import Icon from '../ui/Icon.astro';

const services = [
  {
    number: '01',
    title: 'Flagship Web Development',
    badge: 'Web & Flagship',
    valueHeadline: 'Sub-second edge speeds and kinetic typography that converts high-ticket clients',
    desc: 'Bespoke marketing flagships, high-converting landing pages, and interactive web experiences engineered with modern web standards.',
    highlights: [
      'Sub-50ms static edge deployment on Cloudflare',
      '95+ Mobile Lighthouse performance scores',
      'Kinetic GSAP choreography and fluid touchpoints'
    ],
    tech: 'Astro · TypeScript · Tailwind · GSAP',
    link: '/services'
  },
  {
    number: '02',
    title: 'Software & Automation',
    badge: 'Software & Ops',
    valueHeadline: 'Eliminate spreadsheet toil and manual tasks with bespoke role-secured software',
    desc: 'Custom operational tools, relational backend APIs, and autonomous data pipelines that permanently eradicate manual copy-pasting.',
    highlights: [
      'Custom operational web portals tailored to your team',
      'Relational PostgreSQL schemas with structured audit trails',
      'Deterministic retry queues and automated batch reports'
    ],
    tech: 'Go · Python · PostgreSQL · APIs',
    link: '/services'
  }
];
---

<section class="py-14 sm:py-18 bg-black border-b border-neutral-900 overflow-hidden" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (Clean, Interactive Header) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6 pb-4 border-b border-neutral-900">
      <div>
        <span class="text-[11px] font-semibold text-[#C6FF3D] uppercase tracking-wider block mb-1">Capabilities</span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-white">
          What We Do
        </h2>
      </div>

      <!-- Interactive Controls (Tabs + Arrows) -->
      <div class="flex items-center gap-3 self-start sm:self-auto">
        <div class="inline-flex items-center p-1 bg-neutral-900 border border-neutral-800 rounded-lg text-xs font-semibold">
          <button
            type="button"
            class="home-svc-tab active px-3 py-1 rounded-md transition-all bg-[#C6FF3D] text-black font-bold cursor-pointer shadow-sm"
            data-target="0"
          >
            01 Web
          </button>
          <button
            type="button"
            class="home-svc-tab px-3 py-1 rounded-md transition-all text-neutral-400 hover:text-white cursor-pointer"
            data-target="1"
          >
            02 Software
          </button>
        </div>

        <div class="flex items-center gap-1.5">
          <button
            type="button"
            id="home-svc-prev"
            class="w-8 h-8 rounded-md bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors disabled:opacity-30 cursor-pointer"
            aria-label="Previous capability"
          >
            <Icon name="ArrowLeft" size={14} />
          </button>
          <button
            type="button"
            id="home-svc-next"
            class="w-8 h-8 rounded-md bg-neutral-900 border border-neutral-800 flex items-center justify-center text-neutral-400 hover:text-white hover:border-neutral-700 transition-colors disabled:opacity-30 cursor-pointer"
            aria-label="Next capability"
          >
            <Icon name="ArrowRight" size={14} />
          </button>
        </div>
      </div>
    </div>

    <!-- Side-Scroll Track -->
    <div
      id="home-services-track"
      class="flex overflow-x-auto snap-x snap-mandatory gap-6 scrollbar-none scroll-smooth pb-4 -mx-4 px-4 sm:mx-0 sm:px-0"
    >
      {services.map((svc, idx) => (
        <div
          class="home-service-card w-[90vw] sm:w-[540px] lg:w-[calc(50%-12px)] min-w-[90vw] sm:min-w-[540px] lg:min-w-[calc(50%-12px)] snap-start snap-always bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-2xl p-6 sm:p-8 flex flex-col justify-between transition-all group flex-shrink-0"
          data-index={idx}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-[#C6FF3D] bg-[#C6FF3D]/10 px-2.5 py-1 rounded-md">
                {svc.number}
              </span>
              <span class="text-[11px] font-semibold text-neutral-500 uppercase tracking-wider">
                {svc.badge}
              </span>
            </div>

            <h3 class="font-display font-bold text-2xl sm:text-3xl text-white group-hover:text-[#C6FF3D] transition-colors mb-2">
              {svc.title}
            </h3>

            <p class="font-body text-sm font-medium text-[#C6FF3D] leading-snug mb-3">
              {svc.valueHeadline}
            </p>

            <p class="font-body text-sm text-neutral-400 leading-relaxed mb-5">
              {svc.desc}
            </p>

            <!-- Value Highlights -->
            <div class="space-y-2 mb-6 pt-4 border-t border-neutral-900">
              {svc.highlights.map((h) => (
                <div class="flex items-start gap-2 text-xs text-neutral-300">
                  <span class="text-[#C6FF3D] font-bold mt-0.5">›</span>
                  <span>{h}</span>
                </div>
              ))}
            </div>
          </div>

          <div class="pt-4 border-t border-neutral-900 flex items-center justify-between">
            <span class="text-xs font-mono text-neutral-500">{svc.tech}</span>
            <a
              href={svc.link}
              class="text-xs font-semibold text-neutral-300 group-hover:text-[#C6FF3D] flex items-center gap-1 transition-colors"
            >
              <span>Explore Specs</span>
              <Icon name="ArrowUpRight" size={13} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function initHomeServicesSlider() {
    const track = document.getElementById('home-services-track');
    if (!track) return;

    const tabs = document.querySelectorAll('.home-svc-tab');
    const prevBtn = document.getElementById('home-svc-prev') as HTMLButtonElement | null;
    const nextBtn = document.getElementById('home-svc-next') as HTMLButtonElement | null;
    const cards = document.querySelectorAll('.home-service-card');

    function triggerHaptic(duration = 10) {
      if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
        try { navigator.vibrate(duration); } catch (e) {}
      }
    }

    function setActiveTab(index: number) {
      tabs.forEach((tab, i) => {
        if (i === index) {
          tab.className = 'home-svc-tab active px-3 py-1 rounded-md transition-all bg-[#C6FF3D] text-black font-bold cursor-pointer shadow-sm';
        } else {
          tab.className = 'home-svc-tab px-3 py-1 rounded-md transition-all text-neutral-400 hover:text-white cursor-pointer';
        }
      });

      if (prevBtn) prevBtn.disabled = index === 0;
      if (nextBtn) nextBtn.disabled = index === cards.length - 1;
    }

    function scrollToCard(index: number) {
      if (!cards[index]) return;
      triggerHaptic(12);
      const target = cards[index] as HTMLElement;
      track.scrollTo({
        left: target.offsetLeft - track.offsetLeft,
        behavior: 'smooth'
      });
      setActiveTab(index);
    }

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => scrollToCard(i));
    });

    prevBtn?.addEventListener('click', () => {
      const cardWidth = (cards[0] as HTMLElement)?.offsetWidth || 300;
      const idx = Math.round(track.scrollLeft / cardWidth);
      if (idx > 0) scrollToCard(idx - 1);
    });

    nextBtn?.addEventListener('click', () => {
      const cardWidth = (cards[0] as HTMLElement)?.offsetWidth || 300;
      const idx = Math.round(track.scrollLeft / cardWidth);
      if (idx < cards.length - 1) scrollToCard(idx + 1);
    });

    let scrollTimeout: any;
    track.addEventListener('scroll', () => {
      clearTimeout(scrollTimeout);
      scrollTimeout = setTimeout(() => {
        const cardWidth = (cards[0] as HTMLElement)?.offsetWidth || 300;
        const idx = Math.min(Math.max(0, Math.round(track.scrollLeft / cardWidth)), cards.length - 1);
        setActiveTab(idx);
      }, 50);
    }, { passive: true });

    setActiveTab(0);
  }

  initHomeServicesSlider();
  document.addEventListener('astro:page-load', initHomeServicesSlider);
</script>
