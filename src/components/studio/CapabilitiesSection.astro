---
import Icon from '../ui/Icon.astro';

const services = [
  {
    number: '01',
    title: 'Digital Flagships',
    desc: 'High-performance brand websites and 3D WebGL experiences engineered to convert.',
    tech: 'Astro · Three.js · GSAP'
  },
  {
    number: '02',
    title: 'Workflow Automation',
    desc: 'Bespoke internal systems and automated pipelines that permanently kill spreadsheet toil.',
    tech: 'Go · Python · PostgreSQL'
  },
  {
    number: '03',
    title: 'Custom Software',
    desc: 'Production-grade web apps, APIs, and proprietary SaaS platforms built to scale.',
    tech: 'TypeScript · Edge · Docker'
  }
];
---

<section class="py-14 sm:py-18 bg-black border-b border-neutral-900" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header (Clean & Minimal) -->
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-neutral-900">
      <div>
        <span class="text-[11px] font-semibold text-[#C6FF3D] uppercase tracking-wider block mb-1">Capabilities</span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-white">
          What We Do
        </h2>
      </div>
      <a
        href="/services"
        class="text-xs font-semibold text-neutral-400 hover:text-[#C6FF3D] flex items-center gap-1 transition-colors"
      >
        <span>View Services</span>
        <Icon name="ArrowUpRight" size={14} />
      </a>
    </div>

    <!-- Crisp 3-Card Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {services.map((svc) => (
        <a
          href="/services"
          class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all group hover:-translate-y-0.5"
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-mono font-bold text-[#C6FF3D] bg-[#C6FF3D]/10 px-2 py-0.5 rounded-full">
                {svc.number}
              </span>
              <Icon name="ArrowUpRight" size={15} class="text-neutral-600 group-hover:text-[#C6FF3D] transition-colors" />
            </div>

            <h3 class="font-display font-bold text-xl sm:text-2xl text-white group-hover:text-[#C6FF3D] transition-colors mb-2.5">
              {svc.title}
            </h3>

            <p class="font-body text-sm text-neutral-400 leading-relaxed">
              {svc.desc}
            </p>
          </div>

          <div class="pt-5 mt-6 border-t border-neutral-900 flex items-center justify-between text-xs font-mono text-neutral-500">
            <span>{svc.tech}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
