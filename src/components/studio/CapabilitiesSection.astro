---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';

const services = [
  {
    number: '01',
    title: 'Digital Flagships & Creative Web',
    desc: 'Bespoke web experiences, 60fps WebGL/Three.js interactive centerpieces, and kinetic typography. Engineered for sub-second edge speeds and unmistakable brand presence.',
    tags: ['Astro', 'Three.js / WebGL', 'GSAP', 'Tailwind CSS', 'TypeScript']
  },
  {
    number: '02',
    title: 'Workflow Automation & Internal Tools',
    desc: 'Custom operational portals and autonomous background pipelines that permanently eliminate fragile spreadsheets, manual data entry, and sync errors.',
    tags: ['Go', 'FastAPI', 'PostgreSQL', 'Redis', 'Docker']
  },
  {
    number: '03',
    title: 'Custom Software & SaaS Engineering',
    desc: 'Zero-to-one software architecture, robust relational schemas, granular role-based permissions, and resilient edge deployments built to scale.',
    tags: ['Go', 'Python', 'Cloudflare Workers', 'PostgreSQL', 'Stripe']
  }
];
---

<section class="py-20 md:py-28 bg-black border-b border-neutral-900 relative" id="services">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 pb-6 border-b border-neutral-900">
      <div>
        <div class="inline-flex items-center gap-2 mb-3 px-3.5 py-1 bg-neutral-900 border border-neutral-800 rounded-full text-xs font-semibold text-[#C6FF3D]">
          <span>Services</span>
        </div>
        <h2 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-white">
          What We Do
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <p class="font-body text-sm sm:text-base text-neutral-400 max-w-sm">
          Focused engineering disciplines designed for rapid execution and tangible business impact.
        </p>
        <a
          href="/services"
          class="text-xs font-semibold text-[#C6FF3D] hover:underline uppercase tracking-wider flex items-center gap-1.5 whitespace-nowrap"
        >
          <span>All Services & Pricing</span>
          <Icon name="ArrowUpRight" size={13} />
        </a>
      </div>
    </div>

    <!-- Clean, Non-collapsible 3-Card Grid (No bloated accordions) -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {services.map((svc) => (
        <div class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-3xl p-8 flex flex-col justify-between transition-all group">
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="text-xs font-bold text-black bg-[#C6FF3D] px-2.5 py-1 rounded-full">{svc.number}</span>
            </div>

            <h3 class="font-display font-bold text-2xl text-white group-hover:text-[#C6FF3D] transition-colors mb-3">
              {svc.title}
            </h3>

            <p class="font-body text-sm text-neutral-400 leading-relaxed mb-6">
              {svc.desc}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 pt-4 border-t border-neutral-900 mb-6">
              {svc.tags.map((tag) => (
                <span class="text-xs text-neutral-400 bg-neutral-900 px-2.5 py-1 border border-neutral-800 rounded-full font-medium">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href="/services"
              class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-300 group-hover:text-[#C6FF3D] transition-colors"
            >
              <span>Explore Scope & Details</span>
              <Icon name="ArrowUpRight" size={13} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
