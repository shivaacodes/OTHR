---
import Icon from '../ui/Icon.astro';

const navLinks = [
  { href: '/#services', targetId: 'services', label: 'Services' },
  { href: '/#pricing', targetId: 'pricing', label: 'Pricing' },
  { href: '/#faq', targetId: 'faq', label: 'FAQs' },
  { href: '/start', label: 'Enquire' }
];
---

<footer class="bg-[#0B3C85] text-[#F5F2EB] border-t border-white/10 py-10 sm:py-12 relative" id="footer">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-6 sm:gap-8 pb-8 border-b border-white/10">
      
      <!-- Brand & Coordinates -->
      <div class="space-y-2">
        <a href="/" class="flex items-center gap-2.5 group focus:outline-none" aria-label="Nira Studio">
          <img
            src="/nira-studio.png"
            alt="Nira Studio Logo"
            class="h-7 w-auto object-contain brightness-0 invert transition-transform group-hover:scale-105"
            width="134"
            height="117"
          />
          <span class="font-display font-bold text-xl sm:text-2xl tracking-tight text-[#F5F2EB]">
            Nira Studio
          </span>
        </a>
        <p class="text-xs text-[#F5F2EB]/70 font-body max-w-sm leading-relaxed">
          Thoughtful websites. Smarter business software. Built for businesses that want better.
        </p>
        <div class="flex items-center gap-2.5 text-xs pt-0.5">
          <a
            href="mailto:shivasajay23@gmail.com"
            class="text-[#F5F2EB]/90 hover:text-white transition-colors font-medium"
          >
            shivasajay23@gmail.com
          </a>
          <span class="text-[#F5F2EB]/30">•</span>
          <a
            href="tel:+919995228904"
            class="text-[#F5F2EB]/80 hover:text-white transition-colors font-mono"
          >
            +91 99952 28904
          </a>
        </div>
      </div>

      <!-- Navigation & X Handle -->
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7">
        <div class="flex flex-wrap items-center gap-4 sm:gap-5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              data-scroll-to={link.targetId}
              class="text-xs sm:text-sm font-semibold text-[#F5F2EB]/80 hover:text-white transition-colors cursor-pointer"
            >
              {link.label}
            </a>
          ))}
        </div>
        <a
          href="https://x.com/NiraaStudio"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-bold text-[#F5F2EB] bg-white/10 hover:bg-white/20 border border-white/15 px-3 py-1 rounded-full flex items-center gap-1 transition-colors"
        >
          <span>@NiraaStudio</span>
          <Icon name="ArrowUpRight" size={12} />
        </a>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-6 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs font-mono text-[#F5F2EB]/50">
      <div>© {new Date().getFullYear()} Nira Studio. All rights reserved.</div>
      <div>Kochi, India</div>
    </div>
  </div>
</footer>
