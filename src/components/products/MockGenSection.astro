---
import { products } from '../../data/products';
import Icon from '../ui/Icon.astro';

const mockgen = products[0];
---

<section class="py-12 sm:py-16 md:py-20 bg-black border-b border-neutral-900" id="products">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-neutral-900">
      <div>
        <span class="text-[11px] font-semibold text-[#FF5500] uppercase tracking-wider block mb-1">Product</span>
        <h2 class="font-display font-bold text-xl sm:text-3xl text-white">
          MockGen
        </h2>
      </div>
      <a
        href="/products"
        class="text-xs font-semibold text-neutral-400 hover:text-[#FF5500] flex items-center gap-1 transition-colors"
      >
        <span>Explore Specs & Pricing</span>
        <Icon name="ArrowUpRight" size={14} />
      </a>
    </div>

    <!-- MOCKGEN ORANGE CARD (Clean, Fast, Crisp) -->
    <div class="bg-[#FF5500] text-black rounded-3xl p-6 sm:p-8 lg:p-10 shadow-[0_20px_50px_-15px_rgba(255,85,0,0.3)]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <!-- Visual Asset Pipeline Card (Left on desktop, top on mobile) -->
        <div class="lg:col-span-6">
          <div class="bg-neutral-950 border border-neutral-800 rounded-2xl p-5 sm:p-6 shadow-2xl">
            <!-- HUD Header -->
            <div class="flex items-center justify-between pb-3 mb-4 border-b border-neutral-800 text-xs">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-[#FF5500] animate-pulse"></span>
                <span class="text-white font-mono font-semibold">MockGen Engine</span>
              </div>
              <span class="text-[11px] font-mono text-[#FF5500]">45s Generation</span>
            </div>

            <!-- Layered Pipeline Preview -->
            <div class="space-y-2.5 mb-5 font-mono text-xs">
              <div class="flex items-center justify-between p-2.5 bg-neutral-900/90 border border-neutral-800 rounded-lg text-neutral-300">
                <span class="text-neutral-400">01 // Surface Geometry</span>
                <span class="text-[#FF5500] text-[11px]">3D Cylindrical Mesh</span>
              </div>
              <div class="flex items-center justify-between p-2.5 bg-neutral-900/90 border border-neutral-800 rounded-lg text-neutral-300">
                <span class="text-neutral-400">02 // Vector Artwork</span>
                <span class="text-[#FF5500] text-[11px]">Full Wrap Dieline</span>
              </div>
              <div class="flex items-center justify-between p-2.5 bg-neutral-900/90 border border-neutral-800 rounded-lg text-neutral-300">
                <span class="text-neutral-400">03 // Material Shaders</span>
                <span class="text-[#FF5500] text-[11px]">Metallic & Spot UV</span>
              </div>
              <div class="flex items-center justify-between p-2.5 bg-neutral-900/90 border border-neutral-800 rounded-lg text-neutral-300">
                <span class="text-neutral-400">04 // Print Tolerances</span>
                <span class="text-[#FF5500] text-[11px]">3mm Bleed & Margins</span>
              </div>
            </div>

            <!-- Export Formats -->
            <div class="pt-3 border-t border-neutral-800/80 flex flex-wrap items-center justify-between gap-2">
              <span class="text-[11px] font-mono text-neutral-400">Exports:</span>
              <div class="flex flex-wrap gap-1.5">
                <span class="text-[10px] font-mono px-2 py-0.5 bg-neutral-900 text-neutral-300 border border-neutral-800 rounded">PSD</span>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-neutral-900 text-neutral-300 border border-neutral-800 rounded">OBJ</span>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-neutral-900 text-neutral-300 border border-neutral-800 rounded">GLB</span>
                <span class="text-[10px] font-mono px-2 py-0.5 bg-neutral-900 text-neutral-300 border border-neutral-800 rounded">UV MAPS</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Copy & CTAs (Right on desktop, below on mobile) -->
        <div class="lg:col-span-6 flex flex-col justify-center space-y-6">
          <div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-black text-white text-[11px] font-bold rounded-full uppercase tracking-wider mb-3">
              <span>Packaging Asset Pipeline</span>
            </div>

            <h3 class="font-display font-bold text-xl sm:text-2xl lg:text-3xl text-black tracking-tight leading-tight">
              AI Generated 3D Mockups Ready for Print
            </h3>
          </div>

          <!-- CTAs (Guaranteed same row across all screen sizes) -->
          <div class="flex flex-row items-center gap-2.5 sm:gap-3 w-full">
            <a
              href="https://trymockgen.vercel.app/?auth=signup"
              target="_blank"
              rel="noopener noreferrer"
              class="bg-black hover:bg-neutral-900 text-white font-semibold text-xs sm:text-sm px-4 sm:px-6 py-3 sm:py-3.5 rounded-full transition-all active:scale-95 flex items-center justify-center gap-1.5 shadow-md whitespace-nowrap flex-1 sm:flex-initial"
            >
              <span>Draft Your Design Free</span>
              <Icon name="ArrowUpRight" size={14} />
            </a>
            <a
              href="/products"
              class="bg-black/10 hover:bg-black/20 text-black font-semibold text-xs sm:text-sm px-3.5 sm:px-5 py-3 sm:py-3.5 rounded-full transition-all active:scale-95 text-center whitespace-nowrap flex-shrink-0"
            >
              Explore Specs
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
