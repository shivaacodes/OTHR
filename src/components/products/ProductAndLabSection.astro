---
import Icon from '../ui/Icon.astro';
---

<section class="py-20 sm:py-28 bg-black border-b border-neutral-900" id="product-and-lab">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section 1: Proprietary Product Spotlight (Clean Video Card + Title Only) -->
    <div class="mb-20">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-neutral-900">
        <div>
          <div class="font-mono text-xs font-bold text-[#FFE500] uppercase tracking-wider mb-2">
            04 // Proprietary Product
          </div>
          <h2 class="font-display font-black text-3xl sm:text-4xl text-white tracking-tight">
            MockGen
          </h2>
          <p class="font-body text-sm sm:text-base text-neutral-400 mt-1">
            AI generated 3D mockups ready for print. Click below to inspect complete specs, plans, and export formats.
          </p>
        </div>

        <a
          href="/products"
          class="text-xs font-semibold text-neutral-400 hover:text-[#FFE500] flex items-center gap-1.5 transition-colors"
        >
          <span>View all specs & pricing</span>
          <Icon name="ArrowUpRight" size={14} />
        </a>
      </div>

      <!-- CLICKABLE VIDEO CARD (Clean, Fast, Responsive) -->
      <a
        href="/products"
        class="block group relative w-full rounded-2xl bg-neutral-950 border border-neutral-900 hover:border-[#FFE500]/50 transition-all overflow-hidden shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#FFE500]"
        aria-label="View MockGen Product Details and Video Demo"
      >
        <!-- Video Container (Aspect Ratio 16:9) -->
        <div class="relative w-full aspect-video bg-gradient-to-br from-neutral-900 via-black to-neutral-950 flex items-center justify-center overflow-hidden">
          
          <!-- Background Ambient Glow -->
          <div class="absolute inset-0 bg-radial from-[#FFE500]/10 via-transparent to-transparent opacity-60 group-hover:opacity-100 transition-opacity pointer-events-none"></div>

          <!-- Video Element (User can replace src with their video file/mp4) -->
          <video
            class="w-full h-full object-cover opacity-80 group-hover:opacity-95 transition-opacity pointer-events-none"
            poster="/og-image.png"
            muted
            loop
            playsinline
          >
            <!-- User can drop their video file here: e.g. <source src="/mockgen-demo.mp4" type="video/mp4" /> -->
          </video>

          <!-- Play / Click Overlay -->
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-black/40 group-hover:bg-black/20 transition-colors">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#FFE500] text-black flex items-center justify-center shadow-[0_0_35px_rgba(255,229,0,0.5)] transition-transform group-hover:scale-110">
              <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
            <div class="text-xs font-mono font-bold text-white bg-black/70 px-3.5 py-1.5 rounded-full border border-neutral-800 backdrop-blur-sm group-hover:border-[#FFE500] transition-colors">
              Click to view MockGen demo & specs →
            </div>
          </div>

          <!-- Top-Left Title Tag -->
          <div class="absolute top-4 left-4 z-20">
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-black/80 backdrop-blur-md rounded-md border border-neutral-800 text-xs text-white font-medium">
              <span class="w-2 h-2 rounded-full bg-[#FFE500] animate-pulse"></span>
              <span>MockGen Engine • 3D Packaging Pipeline</span>
            </div>
          </div>

          <!-- Bottom-Right Specs Pill -->
          <div class="absolute bottom-4 right-4 z-20">
            <span class="text-[11px] font-mono text-neutral-400 bg-black/80 backdrop-blur-md px-3 py-1 rounded-md border border-neutral-800">
              Exports: PSD · OBJ · GLB · Dieline
            </span>
          </div>
        </div>

        <!-- Minimal Footer Strip -->
        <div class="p-4 sm:p-5 bg-neutral-950 flex items-center justify-between border-t border-neutral-900">
          <div class="font-display font-bold text-base sm:text-lg text-white group-hover:text-[#FFE500] transition-colors">
            AI Generated 3D Mockups Ready for Print
          </div>
          <span class="text-xs text-[#FFE500] font-semibold flex items-center gap-1">
            <span>Explore Details</span>
            <Icon name="ArrowUpRight" size={14} />
          </span>
        </div>
      </a>
    </div>

    <!-- Section 2: Creative Technology (The Lab Preview) -->
    <div class="pt-12 border-t border-neutral-900">
      <div class="p-8 sm:p-10 bg-neutral-950 border border-neutral-900 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="font-mono text-xs font-bold text-[#C6FF3D] uppercase tracking-wider">
            Creative Technology
          </div>
          <h3 class="font-display font-bold text-2xl text-white">
            The Lab: Experimental Code & Shaders
          </h3>
          <p class="font-body text-sm text-neutral-400 leading-relaxed">
            Where we test unconventional ideas. Algorithmic physics simulations, WebGL shaders, and browser audio DSP that keep our production engineering miles ahead.
          </p>
        </div>

        <a
          href="/lab"
          class="px-6 py-3.5 bg-neutral-900 hover:bg-[#C6FF3D] text-neutral-300 hover:text-black font-semibold text-xs sm:text-sm rounded-lg transition-colors flex items-center gap-2 whitespace-nowrap cursor-pointer flex-shrink-0"
        >
          <span>Explore The Lab</span>
          <Icon name="ArrowUpRight" size={15} />
        </a>
      </div>
    </div>

  </div>
</section>
