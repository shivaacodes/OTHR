---
import Icon from '../ui/Icon.astro';
---

<section class="py-20 sm:py-28 bg-black border-b border-neutral-900" id="product-and-lab">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-neutral-900">
      <div>
        <span class="text-xs font-mono font-bold text-[#FFE500] uppercase tracking-wider block mb-1">
          04 // Proprietary Product
        </span>
        <h2 class="font-display font-black text-2xl sm:text-4xl text-white">
          Original Software
        </h2>
      </div>

      <a
        href="/products"
        class="text-xs font-semibold text-neutral-400 hover:text-[#FFE500] flex items-center gap-1.5 transition-colors"
      >
        <span>View all specs & pricing</span>
        <Icon name="ArrowUpRight" size={14} />
      </a>
    </div>

    <!-- HEX-STYLE PRODUCT CARD (Exact Layout: Solid Color Outer Frame + Inner Video + Title Underneath) -->
    <div class="mb-20">
      <a
        href="/products"
        class="block group rounded-3xl bg-[#FFE500] p-3 sm:p-5 transition-transform duration-300 hover:scale-[1.008] active:scale-[0.99] shadow-2xl focus:outline-none focus:ring-2 focus:ring-[#FFE500]"
        aria-label="View MockGen: AI Generated 3D Mockups Ready for Print"
      >
        <!-- Inner Media / Video Container -->
        <div class="relative w-full aspect-video rounded-2xl bg-black overflow-hidden flex items-center justify-center">
          <!-- Video Element (Drop your video src here: e.g. <source src="/mockgen.mp4" type="video/mp4" />) -->
          <video
            class="w-full h-full object-cover opacity-85 group-hover:opacity-100 transition-opacity"
            poster="/og-image.png"
            autoplay
            muted
            loop
            playsinline
          >
            <!-- User can drop their video file here -->
          </video>

          <!-- Subtle Play Indicator Overlay -->
          <div class="absolute inset-0 flex items-center justify-center bg-black/20 group-hover:bg-black/10 transition-colors pointer-events-none">
            <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-full bg-black/70 text-[#FFE500] border border-[#FFE500]/40 flex items-center justify-center backdrop-blur-sm transition-transform duration-300 group-hover:scale-110 shadow-xl">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </div>
          </div>
        </div>

        <!-- Title & Subtitle Below Media (Directly on the Yellow Surface, Hex Style) -->
        <div class="pt-4 sm:pt-5 pb-2 px-2 sm:px-3">
          <h3 class="font-display font-black text-xl sm:text-2xl lg:text-3xl text-black tracking-tight leading-tight">
            MockGen: AI Generated 3D Mockups Ready for Print
          </h3>
          <div class="font-body text-xs sm:text-sm text-black/75 font-semibold mt-1">
            3D Packaging & Print Asset Pipeline
          </div>
        </div>
      </a>
    </div>

    <!-- Section 2: Creative Technology (The Lab Preview) -->
    <div class="pt-12 border-t border-neutral-900">
      <div class="p-8 sm:p-10 bg-neutral-950 border border-neutral-900 rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
        <div class="space-y-2 max-w-xl">
          <div class="font-mono text-xs font-bold text-[#C6FF3D] uppercase tracking-wider">
            Creative Technology
          </div>
          <h3 class="font-display font-bold text-2xl text-white">
            The Lab: Experimental Code & Shaders
          </h3>
          <p class="font-body text-sm text-neutral-400 leading-relaxed">
            Where we test unconventional ideas. Algorithmic physics simulations, WebGL shaders, and browser audio DSP that keep our production engineering miles ahead.
          </p>
        </div>

        <a
          href="/lab"
          class="px-6 py-3.5 bg-neutral-900 hover:bg-[#C6FF3D] text-neutral-300 hover:text-black font-semibold text-xs sm:text-sm rounded-lg transition-colors flex items-center gap-2 whitespace-nowrap cursor-pointer flex-shrink-0"
        >
          <span>Explore The Lab</span>
          <Icon name="ArrowUpRight" size={15} />
        </a>
      </div>
    </div>

  </div>
</section>
