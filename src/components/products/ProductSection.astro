---
import Icon from '../ui/Icon.astro';

const projectTypes = [
  'Flagship Web',
  'Software & Automation',
  'Other Inquiries'
];
---

<section class="py-16 sm:py-24 bg-black border-b border-neutral-900" id="product-and-inquiry">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Asymmetric 4 / 8 Grid (Not half-half: Form is narrower, Product Card is wide) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- LEFT COLUMN: Clean, Unwrapped Inquiry Form (Less width: 4 of 12 columns) -->
      <div class="lg:col-span-4 order-2 lg:order-1" id="contact">
        <form id="hero-inquiry-form" class="space-y-4">
          
          <!-- Heading -->
          <div class="pb-1">
            <h3 class="font-display font-black text-2xl text-white tracking-tight">
              Start a Project
            </h3>
          </div>

          <!-- Project Type Selection -->
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-2">
              What are you looking to build?
            </label>
            <div class="flex flex-wrap gap-1.5" id="hero-inquiry-type-selector">
              {projectTypes.map((type, idx) => (
                <button
                  type="button"
                  class={`hero-inquiry-pill px-3 py-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${
                    idx === 0
                      ? 'bg-[#C6FF3D] text-black shadow-sm'
                      : 'bg-neutral-950 text-neutral-400 hover:text-white border border-neutral-800'
                  }`}
                  data-value={type}
                >
                  {type}
                </button>
              ))}
            </div>
            <input type="hidden" name="projectType" id="hero-selected-type" value={projectTypes[0]} />
          </div>

          <!-- Your Name -->
          <div>
            <label for="hero-inquiry-name" class="block text-xs font-semibold text-neutral-400 mb-1.5">
              Your Name *
            </label>
            <input
              type="text"
              id="hero-inquiry-name"
              name="name"
              required
              placeholder="Shiva Sajay"
              class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none px-3.5 py-2.5 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600"
            />
          </div>

          <!-- Your Email -->
          <div>
            <label for="hero-inquiry-email" class="block text-xs font-semibold text-neutral-400 mb-1.5">
              Your Email *
            </label>
            <input
              type="email"
              id="hero-inquiry-email"
              name="email"
              required
              placeholder="shiva@example.com"
              class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none px-3.5 py-2.5 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600"
            />
          </div>

          <!-- Scope / Overview -->
          <div>
            <label for="hero-inquiry-message" class="block text-xs font-semibold text-neutral-400 mb-1.5">
              Project Overview / Scope *
            </label>
            <textarea
              id="hero-inquiry-message"
              name="message"
              required
              rows={3}
              placeholder="Tell us what you're looking to engineer, your rough timeline, and any key requirements..."
              class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none p-3 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600 resize-none"
            ></textarea>
          </div>

          <!-- Submit CTA -->
          <div class="pt-1">
            <button
              type="submit"
              id="hero-inquiry-submit-btn"
              class="w-full py-3 bg-[#C6FF3D] hover:bg-[#d4ff66] text-black font-bold text-sm rounded-lg transition-all flex items-center justify-center gap-2 shadow-sm active:scale-95 cursor-pointer"
            >
              <span>Send Project Inquiry</span>
              <Icon name="ArrowUpRight" size={15} />
            </button>
          </div>

          <!-- Bottom Direct Coordinates -->
          <div class="pt-2 flex items-center justify-between text-xs text-neutral-500">
            <span>Replies within 24–48 hours</span>
            <a
              href="https://wa.me/919995228904"
              target="_blank"
              rel="noopener noreferrer"
              class="text-neutral-400 hover:text-[#C6FF3D] font-mono flex items-center gap-1 transition-colors"
            >
              <span>+91 99952 28904</span>
              <Icon name="ArrowUpRight" size={12} />
            </a>
          </div>
        </form>

        <!-- Feedback Success Alert -->
        <div id="hero-inquiry-success" class="hidden p-5 bg-neutral-950 border border-[#C6FF3D] rounded-xl space-y-3 mt-4">
          <div class="flex items-center gap-2 text-[#C6FF3D] font-bold text-xs">
            <span>✓</span>
            <span>Inquiry Prepared & Copied</span>
          </div>
          <p class="text-xs text-neutral-300 leading-relaxed font-body">
            Your inquiry has been copied to your clipboard and addressed to <strong class="text-white">shivasajay23@gmail.com</strong>.
          </p>
          <div class="flex gap-2 pt-1">
            <a
              id="hero-mailto-link"
              href="mailto:shivasajay23@gmail.com"
              class="px-4 py-2 bg-[#C6FF3D] text-black font-semibold text-xs rounded-lg inline-block"
            >
              Open Email App
            </a>
            <button
              type="button"
              id="hero-inquiry-reset-btn"
              class="px-4 py-2 bg-neutral-900 border border-neutral-800 text-neutral-300 hover:text-white font-medium text-xs rounded-lg cursor-pointer"
            >
              Send Another
            </button>
          </div>
        </div>
      </div>

      <!-- RIGHT COLUMN: Wide Hex-Style Product Card (8 of 12 columns, Lesser Corner Radius, Image) -->
      <div class="lg:col-span-8 order-1 lg:order-2 space-y-3">
        
        <!-- Header Strip Above Card -->
        <div class="flex items-center justify-between pb-1">
          <h2 class="font-display font-black text-2xl text-white">
            Original Software
          </h2>

          <a
            href="/products"
            class="text-xs font-semibold text-neutral-400 hover:text-[#FF5500] flex items-center gap-1.5 transition-colors"
          >
            <span>View all specs & pricing</span>
            <Icon name="ArrowUpRight" size={14} />
          </a>
        </div>

        <!-- HEX-STYLE PRODUCT CARD (Lesser Corner Radius: rounded-xl, Neon Orange Frame, Image, Steady No Zoom) -->
        <a
          href="/products"
          class="block group rounded-xl bg-[#FF5500] p-3 sm:p-4 shadow-[0_15px_40px_-10px_rgba(255,85,0,0.3)] focus:outline-none focus:ring-2 focus:ring-[#FF5500]"
          aria-label="View MockGen: AI Generated 3D Mockups Ready for Print"
        >
          <!-- Inner Media Container: Direct mockgen.png image -->
          <div class="relative w-full aspect-[16/10] sm:aspect-video rounded-lg bg-black overflow-hidden flex items-center justify-center">
            <img
              src="/mockgen.png"
              alt="MockGen: AI Generated 3D Mockups Ready for Print"
              class="w-full h-full object-cover"
              loading="eager"
            />

            <!-- Subtle Hover Arrow Pill in Top Right -->
            <div class="absolute top-3 right-3 opacity-0 group-hover:opacity-100 transition-opacity bg-black/80 backdrop-blur-sm text-white px-3 py-1 rounded-full text-xs font-mono font-medium flex items-center gap-1.5">
              <span>Inspect specs</span>
              <Icon name="ArrowUpRight" size={13} />
            </div>
          </div>

          <!-- Title & Subtitle Below Media (Directly on Neon Orange Surface) -->
          <div class="pt-3 pb-1 px-1">
            <h3 class="font-display font-black text-lg sm:text-xl lg:text-2xl text-black tracking-tight leading-snug">
              MockGen: AI Generated 3D Mockups Ready for Print
            </h3>
            <div class="font-body text-xs sm:text-sm text-black/80 font-semibold mt-0.5">
              3D Packaging & Print Asset Pipeline
            </div>
          </div>
        </a>

      </div>

    </div>

  </div>
</section>

<script>
  function initHeroInquiryForm() {
    const form = document.getElementById('hero-inquiry-form') as HTMLFormElement | null;
    const successAlert = document.getElementById('hero-inquiry-success');
    const resetBtn = document.getElementById('hero-inquiry-reset-btn');
    const pills = document.querySelectorAll('.hero-inquiry-pill');
    const selectedInput = document.getElementById('hero-selected-type') as HTMLInputElement | null;
    const mailtoTrigger = document.getElementById('hero-mailto-link') as HTMLAnchorElement | null;

    if (!form) return;

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('bg-[#C6FF3D]', 'text-black', 'shadow-sm');
          p.classList.add('bg-neutral-950', 'text-neutral-400', 'border', 'border-neutral-800');
        });
        pill.classList.remove('bg-neutral-950', 'text-neutral-400', 'border', 'border-neutral-800');
        pill.classList.add('bg-[#C6FF3D]', 'text-black', 'shadow-sm');

        const val = pill.getAttribute('data-value') || '';
        if (selectedInput) selectedInput.value = val;
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
        try { navigator.vibrate([15, 40, 20]); } catch (err) {}
      }

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const type = formData.get('projectType') as string;
      const message = formData.get('message') as string;

      const briefText = `OTHR INQUIRY\n---\nName: ${name}\nEmail: ${email}\nProject Type: ${type}\nMessage:\n${message}`;

      if (navigator.clipboard) {
        navigator.clipboard.writeText(briefText);
      }

      const subject = encodeURIComponent(`Project Inquiry: ${type} - ${name}`);
      const body = encodeURIComponent(briefText);
      const mailtoUrl = `mailto:shivasajay23@gmail.com?subject=${subject}&body=${body}`;

      if (mailtoTrigger) {
        mailtoTrigger.href = mailtoUrl;
      }

      window.location.href = mailtoUrl;

      form.classList.add('hidden');
      successAlert?.classList.remove('hidden');
    });

    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      successAlert?.classList.add('hidden');
    });
  }

  initHeroInquiryForm();
  document.addEventListener('astro:page-load', initHeroInquiryForm);
</script>
