---
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

const principles = [
  {
    number: '01',
    category: 'Clarity',
    title: 'Zero Jargon',
    desc: 'Plain English explanations of what we are building, why, and how it works.'
  },
  {
    number: '02',
    category: 'Predictability',
    title: 'Fixed Scopes',
    desc: 'Defined deliverables, rapid sprint timelines (1–4 weeks), and zero invoice surprises.'
  },
  {
    number: '03',
    category: 'Reliability',
    title: 'Real Accountability',
    desc: 'I test, deploy, and verify everything myself. If something breaks, I fix it.'
  }
];
---

<section class="py-16 sm:py-24 lg:py-28 bg-[#F5F2EB]" id="founder">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <p class="text-xs font-mono font-bold uppercase tracking-wider text-[#0B3C85] mb-3">
        The Person Behind Nira Studio
      </p>

      <h2 class="font-display font-bold text-3xl sm:text-5xl lg:text-6xl text-[#0D111C] tracking-tight leading-tight mb-4">
        Direct collaboration.<br />
        No middlemen.
      </h2>

      <p class="font-body text-base sm:text-lg lg:text-xl text-neutral-700 leading-relaxed max-w-2xl">
        The biggest risk in hiring an agency is paying senior rates only to have your project handed to inexperienced junior subcontractors. At Nira Studio, you collaborate directly with the engineer writing your code.
      </p>
    </div>

    <!-- Main Founder Card & Story -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start mb-14">
      
      <!-- Left: Shiva's Profile Card (Optimized for Mobile Viewing & Fast Taps) -->
      <div class="lg:col-span-5 bg-white border border-[#E2DDD1] rounded-3xl p-6 sm:p-8 shadow-sm">
        <div class="flex items-center gap-4 mb-6">
          <!-- Monogram Avatar -->
          <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-[#0B3C85] text-[#F5F2EB] font-display font-extrabold text-2xl sm:text-3xl flex items-center justify-center tracking-tight shadow-sm flex-shrink-0">
            SS
          </div>
          <div>
            <h3 class="font-display font-bold text-xl sm:text-2xl text-[#0D111C] leading-snug">
              Shiva Sajay
            </h3>
            <div class="text-xs sm:text-sm font-semibold text-[#0B3C85] mt-0.5">
              Founder & Lead Engineer
            </div>
            <div class="text-xs text-neutral-500 mt-1 flex items-center gap-1.5 font-medium">
              <span>📍 Kochi, India</span>
            </div>
          </div>
        </div>

        <!-- Direct Coordinates List -->
        <div class="space-y-2.5 pt-4 border-t border-[#E2DDD1]">
          <a
            href="tel:+919995228904"
            class="flex items-center justify-between p-3 rounded-xl bg-[#F5F2EB]/70 hover:bg-[#F5F2EB] border border-[#E2DDD1] text-xs font-semibold text-[#0D111C] group transition-colors"
          >
            <span class="text-neutral-600">Direct Phone:</span>
            <span class="font-mono text-[#0B3C85] font-bold group-hover:underline">+91 99952 28904</span>
          </a>

          <a
            href="mailto:shivasajay23@gmail.com"
            class="flex items-center justify-between p-3 rounded-xl bg-[#F5F2EB]/70 hover:bg-[#F5F2EB] border border-[#E2DDD1] text-xs font-semibold text-[#0D111C] group transition-colors"
          >
            <span class="text-neutral-600">Direct Email:</span>
            <span class="text-[#0B3C85] font-bold group-hover:underline">shivasajay23@gmail.com</span>
          </a>

          <a
            href="https://x.com/NiraaStudio"
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-between p-3 rounded-xl bg-[#F5F2EB]/70 hover:bg-[#F5F2EB] border border-[#E2DDD1] text-xs font-semibold text-[#0D111C] group transition-colors"
          >
            <span class="text-neutral-600">Updates on X:</span>
            <span class="text-[#0B3C85] font-bold flex items-center gap-1 group-hover:underline">
              <span>@NiraaStudio</span>
              <Icon name="ArrowUpRight" size={12} />
            </span>
          </a>
        </div>
      </div>

      <!-- Right: The Thesis & Real Experience -->
      <div class="lg:col-span-7 space-y-6">
        <div class="bg-white border border-[#E2DDD1] rounded-3xl p-6 sm:p-8 lg:p-10 shadow-sm space-y-5 font-body text-base sm:text-lg text-neutral-700 leading-relaxed">
          <p>
            I started Nira Studio with a straightforward thesis: great software does not require an army of account managers or months of bureaucratic meetings. It requires an engineer who genuinely understands your business constraints, communicates clearly, and delivers what was promised.
          </p>
          <p>
            Having built internal systems for automotive dealerships (automating end-of-month payroll pipelines for 2,500+ employees under strict Meta WhatsApp API burst limits) as well as interactive 3D browser tools, I know that real engineering begins where tutorials end.
          </p>
        </div>

        <!-- Call to Action Banner (Deep mysterious blue, solid, no gradient) -->
        <div class="p-6 sm:p-7 bg-[#0B3C85] text-[#F5F2EB] rounded-3xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-sm">
          <div>
            <div class="text-xs font-mono font-bold text-[#F5F2EB]/80 uppercase tracking-wider">Ready to eliminate agency friction?</div>
            <div class="font-display font-bold text-xl sm:text-2xl text-[#F5F2EB] mt-0.5">Let's build your system right.</div>
          </div>
          <a
            href="/start"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-[#F5F2EB] text-[#0B3C85] hover:bg-white font-bold text-sm rounded-full transition-all active:scale-95 whitespace-nowrap shadow-sm"
          >
            <span>Start a project</span>
            <Icon name="ArrowUpRight" size={16} />
          </a>
        </div>
      </div>

    </div>

    <!-- 3 Partnership Principles (01 Clarity, 02 Predictability, 03 Reliability) -->
    <div>
      <div class="text-xs font-mono font-bold text-[#0B3C85] uppercase tracking-wider mb-6">
        When We Work Together:
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {principles.map((p) => (
          <div class="bg-white border border-[#E2DDD1] hover:border-[#0B3C85]/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all group shadow-sm">
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-mono font-bold text-[#0B3C85] bg-[#0B3C85]/10 px-2.5 py-1 rounded-md">
                  {p.number} / {p.category}
                </span>
              </div>
              <h3 class="font-display font-bold text-xl text-[#0D111C] group-hover:text-[#0B3C85] transition-colors mb-2">
                {p.title}
              </h3>
              <p class="font-body text-sm text-neutral-600 leading-relaxed">
                {p.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
