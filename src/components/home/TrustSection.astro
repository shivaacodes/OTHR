---
// Real client testimonials will be added here as projects launch
const testimonials: {
  quote: string;
  author: string;
  organization: string;
}[] = [];
---

{testimonials.length > 0 && (
  <section class="py-24 sm:py-32 bg-[#0B3C85] text-[#F5F2EB] relative" id="testimonials">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Clean Minimal Heading -->
      <div class="mb-14 sm:mb-20 text-center">
        <h2 class="font-display font-extrabold text-3xl sm:text-5xl text-[#F5F2EB] tracking-tight leading-tight">
          Testimonials
        </h2>
      </div>

      <!-- Spacious Testimonial Quotes Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10 items-stretch">
        {testimonials.map((t) => (
          <div class="bg-white/5 border border-white/10 hover:border-white/20 rounded-[2rem] p-8 sm:p-10 flex flex-col justify-between transition-colors shadow-sm">
            <p class="font-body text-sm sm:text-base text-[#F5F2EB]/90 leading-relaxed mb-8">
              "{t.quote}"
            </p>

            <div class="pt-5 border-t border-white/10">
              <div class="font-display font-bold text-sm sm:text-base text-[#F5F2EB]">
                {t.author}
              </div>
              <div class="font-body text-xs sm:text-sm text-[#F5F2EB]/60 mt-1">
                {t.organization}
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
)}
