---
import Icon from '../ui/Icon.astro';

const agencyFriction = [
  {
    title: 'Junior Dev Bait-and-Switch',
    desc: 'Senior partners pitch your project, then hand execution off to inexperienced interns or offshore layers.'
  },
  {
    title: '50-Page Change Orders',
    desc: 'Opaque hourly billing structures and endless scope debates that inflate your final bill by 2x.'
  },
  {
    title: 'Sluggish Multi-MB Templates',
    desc: 'Generic corporate themes bloated with unused plugins that stutter on mobile devices and kill conversion.'
  },
  {
    title: 'Fragile No-Code Zaps',
    desc: 'Brittle automations stitched together with zero error logging or retry logic, silently failing under load.'
  }
];

const othrCommitments = [
  {
    title: '100% Engineer-Led Partnership',
    desc: 'Direct collaboration with Shiva Sajay from initial architecture through production release. Zero sales reps.'
  },
  {
    title: 'Transparent Fixed-Scope Sprints',
    desc: 'Clear milestone pricing, predictable delivery timelines (1–3 weeks), and zero unexpected invoice surprises.'
  },
  {
    title: 'Sub-Second Edge Performance',
    desc: '95+ Mobile Lighthouse scores, sub-50ms static edge distribution on Cloudflare, and fluid responsive UI.'
  },
  {
    title: 'Battle-Tested Software Architecture',
    desc: 'Typed, compiled, reliable systems in Go, Python, Astro, and PostgreSQL designed to permanently eliminate operational toil.'
  }
];
---

<section class="py-20 sm:py-28 bg-[#F5F2EB] border-b border-[#E2DDD1]" id="ideology">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-14 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3 py-1 bg-[#EDE9DF] border border-[#D1CABE] text-[#0B3C85] rounded-full text-xs font-mono font-bold uppercase tracking-wider mb-4">
        <span>The Ideology</span>
      </div>

      <h2 class="font-display font-bold text-3xl sm:text-5xl lg:text-6xl text-[#0D111C] tracking-tight leading-tight mb-4">
        Clarity over complexity.<br />
        Zero agency circus.
      </h2>

      <p class="font-body text-base sm:text-lg text-neutral-600 leading-relaxed max-w-2xl">
        Most digital agencies bill you for corporate overhead, account managers, and interchangeable templates. Here is the difference when you partner directly with Nira Studio.
      </p>
    </div>

    <!-- Comparison Grid: Agency Friction vs OTHR Commitment -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch mb-12">
      
      <!-- Left Card: What You Never Deal With (Agency Model) -->
      <div class="bg-white border border-[#E2DDD1] rounded-2xl p-6 sm:p-9 flex flex-col justify-between shadow-sm">
        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#E2DDD1]">
            <span class="text-xs font-mono font-bold text-red-600 bg-red-600/10 px-2.5 py-1 rounded-md">
              ✕ The Traditional Agency
            </span>
            <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider">Unnecessary Friction</span>
          </div>

          <div class="space-y-5">
            {agencyFriction.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 font-display font-bold text-base sm:text-lg text-[#0D111C]">
                  <span class="text-red-600 font-black">✕</span>
                  <span>{item.title}</span>
                </div>
                <p class="font-body text-sm text-neutral-600 leading-relaxed pl-5">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-8 border-t border-[#E2DDD1] text-xs font-mono text-neutral-500">
          Result: Sluggish delivery, inflated costs, fragile software.
        </div>
      </div>

      <!-- Right Card: The Nira Studio Commitment -->
      <div class="bg-white border-2 border-[#0232d4] text-[#0D111C] rounded-2xl p-6 sm:p-9 shadow-md flex flex-col justify-between relative overflow-hidden">
        <div class="absolute top-0 right-0 w-32 h-32 bg-[#0232d4]/5 rounded-bl-full pointer-events-none"></div>

        <div>
          <div class="flex items-center justify-between mb-6 pb-4 border-b border-[#E2DDD1]">
            <span class="text-xs font-mono font-bold text-[#F5F2EB] bg-[#0232d4] px-2.5 py-1 rounded-md">
              ✓ The Nira Studio Standard
            </span>
            <span class="text-xs font-semibold text-[#0232d4] uppercase tracking-wider font-mono">Direct Engineering</span>
          </div>

          <div class="space-y-5">
            {othrCommitments.map((item) => (
              <div class="space-y-1">
                <div class="flex items-center gap-2 font-display font-bold text-base sm:text-lg text-[#0D111C]">
                  <span class="text-[#0232d4] font-black">✓</span>
                  <span>{item.title}</span>
                </div>
                <p class="font-body text-sm text-neutral-600 leading-relaxed pl-5">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>
        </div>

        <div class="pt-6 mt-8 border-t border-[#E2DDD1] text-xs font-mono text-[#0232d4] font-bold">
          Result: Sub-second speed, typed codebases, predictable outcomes.
        </div>
      </div>

    </div>

    <!-- Bottom Strip: 3 Metrics -->
    <div class="pt-8 border-t border-[#E2DDD1] flex flex-wrap items-center justify-between gap-6">
      <div class="flex flex-wrap items-center gap-8 sm:gap-12 text-xs">
        <div>
          <span class="font-display font-extrabold text-2xl text-[#0232d4] block leading-none mb-1">95+</span>
          <span class="text-neutral-600 font-semibold">Mobile Lighthouse Baseline</span>
        </div>
        <div>
          <span class="font-display font-extrabold text-2xl text-[#0232d4] block leading-none mb-1">&lt;50ms</span>
          <span class="text-neutral-600 font-semibold">Global Edge Distribution</span>
        </div>
        <div>
          <span class="font-display font-extrabold text-2xl text-[#0232d4] block leading-none mb-1">0</span>
          <span class="text-neutral-600 font-semibold">Middlemen or Account Reps</span>
        </div>
      </div>

      <a
        href="/start"
        class="px-6 py-3.5 bg-[#0232d4] hover:bg-[#0028b0] text-[#F5F2EB] font-bold text-sm rounded-lg transition-all shadow-sm flex items-center gap-2 cursor-pointer"
      >
        <span>Work directly with Shiva</span>
        <Icon name="ArrowUpRight" size={15} />
      </a>
    </div>

  </div>
</section>