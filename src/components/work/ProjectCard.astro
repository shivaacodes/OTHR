---
import type { CaseStudy } from '../../data/projects';
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';

export interface Props {
  project: CaseStudy;
  index: number;
}

const { project, index } = Astro.props;
const formattedIndex = (index + 1).toString().padStart(2, '0');
---

<article
  class="group relative bg-[#0E1410] border border-[#1D2620] hover:border-[#C6FF3D]/50 transition-all duration-500 overflow-hidden flex flex-col justify-between"
  data-reveal
  data-delay={0.1 * index}
>
  <!-- Architectural Corner Crosshairs -->
  <div class="absolute top-2 left-2 font-mono text-[9px] text-[#5C635B] pointer-events-none group-hover:text-[#C6FF3D] transition-colors">+</div>
  <div class="absolute top-2 right-2 font-mono text-[9px] text-[#5C635B] pointer-events-none group-hover:text-[#C6FF3D] transition-colors">+</div>
  <div class="absolute bottom-2 left-2 font-mono text-[9px] text-[#5C635B] pointer-events-none group-hover:text-[#C6FF3D] transition-colors">+</div>
  <div class="absolute bottom-2 right-2 font-mono text-[9px] text-[#5C635B] pointer-events-none group-hover:text-[#C6FF3D] transition-colors">+</div>

  <!-- Top Metadata Header -->
  <div class="p-6 sm:p-8 border-b border-[#1D2620] flex items-center justify-between">
    <div class="flex items-center gap-3">
      <span class="font-mono text-xs text-[#C6FF3D] font-bold">[{formattedIndex}]</span>
      <Badge variant="muted">{project.category}</Badge>
      {project.statusText && (
        <Badge variant="alert" size="sm">ALPHA</Badge>
      )}
    </div>
    <span class="font-mono text-xs text-[#5C635B]">{project.year}</span>
  </div>

  <!-- Interactive Project Geometric Abstract Schematic Canvas / Preview -->
  <a href={`/work/${project.slug}`} class="block relative h-64 sm:h-72 bg-[#141A16] overflow-hidden group-hover:bg-[#18211b] transition-colors">
    <div class="absolute inset-0 scanline-grid opacity-30"></div>

    <!-- Generative Architectural Geometry Schematic specific to project type -->
    <div class="absolute inset-0 flex items-center justify-center p-8 transition-transform duration-700 ease-out group-hover:scale-105">
      {project.slug === 'payroll-automation-platform' && (
        <svg viewBox="0 0 200 200" class="w-48 h-48 text-[#C6FF3D]">
          <rect x="40" y="40" width="120" height="120" fill="none" stroke="currentColor" stroke-width="2"/>
          <line x1="40" y1="80" x2="160" y2="80" stroke="#5C635B" stroke-width="1.5"/>
          <line x1="40" y1="120" x2="160" y2="120" stroke="#5C635B" stroke-width="1.5"/>
          <circle cx="100" cy="100" r="16" fill="#141A16" stroke="currentColor" stroke-width="2"/>
          <path d="M 94 100 L 98 104 L 106 96" fill="none" stroke="#C6FF3D" stroke-width="2"/>
        </svg>
      )}

      {project.slug === 'recruitment-management-system' && (
        <svg viewBox="0 0 200 200" class="w-48 h-48 text-[#C6FF3D]">
          <line x1="40" y1="100" x2="100" y2="50" stroke="#5C635B" stroke-width="1.5"/>
          <line x1="100" y1="50" x2="160" y2="100" stroke="#5C635B" stroke-width="1.5"/>
          <line x1="40" y1="100" x2="100" y2="150" stroke="#5C635B" stroke-width="1.5"/>
          <line x1="100" y1="150" x2="160" y2="100" stroke="#5C635B" stroke-width="1.5"/>
          <circle cx="40" cy="100" r="10" fill="#141A16" stroke="currentColor" stroke-width="2"/>
          <circle cx="160" cy="100" r="10" fill="#141A16" stroke="currentColor" stroke-width="2"/>
          <circle cx="100" cy="50" r="12" fill="#F5F6F0"/>
          <circle cx="100" cy="150" r="12" fill="#F5F6F0"/>
          <circle cx="100" cy="100" r="16" fill="#C6FF3D"/>
        </svg>
      )}

      {project.slug === 'inventory-stock-workflows' && (
        <svg viewBox="0 0 200 200" class="w-48 h-48 text-[#C6FF3D]">
          <rect x="30" y="50" width="14" height="100" fill="currentColor"/>
          <rect x="52" y="50" width="6" height="100" fill="currentColor"/>
          <rect x="66" y="50" width="18" height="100" fill="currentColor"/>
          <rect x="92" y="50" width="8" height="100" fill="currentColor"/>
          <rect x="108" y="50" width="16" height="100" fill="currentColor"/>
          <rect x="132" y="50" width="6" height="100" fill="currentColor"/>
          <rect x="146" y="50" width="14" height="100" fill="currentColor"/>
          <line x1="20" y1="100" x2="180" y2="100" stroke="#C6FF3D" stroke-width="2" stroke-dasharray="6 4"/>
        </svg>
      )}

      {project.slug === 'tedx-treasure-hunt' && (
        <svg viewBox="0 0 200 200" class="w-48 h-48 text-[#C6FF3D]">
          <circle cx="100" cy="100" r="75" fill="none" stroke="currentColor" stroke-width="1.5" stroke-dasharray="6 6"/>
          <circle cx="100" cy="100" r="45" fill="none" stroke="#F5F6F0" stroke-width="2"/>
          <polygon points="100,30 112,90 100,85 88,90" fill="#C6FF3D"/>
          <polygon points="100,170 112,110 100,115 88,110" fill="#5C635B"/>
          <circle cx="100" cy="100" r="6" fill="#080B0A" stroke="#C6FF3D" stroke-width="2"/>
        </svg>
      )}

      {project.slug === 'wrapforge' && (
        <svg viewBox="0 0 200 200" class="w-48 h-48 text-[#C6FF3D]">
          <polygon points="100,30 170,70 100,110 30,70" fill="#141A16" stroke="currentColor" stroke-width="2"/>
          <polygon points="30,70 100,110 100,180 30,140" fill="#0E1410" stroke="currentColor" stroke-width="2"/>
          <polygon points="170,70 100,110 100,180 170,140" fill="#18221b" stroke="currentColor" stroke-width="2"/>
          <circle cx="100" cy="110" r="4" fill="#C6FF3D"/>
        </svg>
      )}
    </div>

    <!-- Hover Indicator Pill -->
    <div class="absolute bottom-4 right-4 bg-[#080B0A]/90 border border-[#1D2620] px-3 py-1 font-mono text-[10px] text-[#A5A9A3] group-hover:text-[#C6FF3D] group-hover:border-[#C6FF3D]/40 transition-colors flex items-center gap-1.5">
      <span>VIEW SPEC</span>
      <Icon name="ArrowUpRight" size={12} />
    </div>
  </a>

  <!-- Content & Scope Section -->
  <div class="p-6 sm:p-8 flex flex-col justify-between flex-grow">
    <div>
      <h3 class="font-display font-bold text-2xl sm:text-3xl tracking-tight text-[#F5F6F0] group-hover:text-[#C6FF3D] transition-colors mb-2">
        <a href={`/work/${project.slug}`}>
          {project.title}
        </a>
      </h3>

      <p class="font-body text-sm text-[#A5A9A3] leading-relaxed mb-6">
        {project.tagline}
      </p>
    </div>

    <div>
      <!-- Tech Stack Badges -->
      <div class="flex flex-wrap gap-1.5 pt-4 border-t border-[#1D2620]/80">
        {project.technologies.map((tech) => (
          <span class="font-mono text-[10px] text-[#5C635B] bg-[#141A16] px-2 py-0.5 border border-[#1D2620]">
            {tech}
          </span>
        ))}
      </div>
    </div>
  </div>
</article>
