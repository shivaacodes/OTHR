---
import { experiments } from '../../data/experiments';
import InteractiveShader from './InteractiveShader.astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

const featuredExperiment = experiments[0];
const otherExperiments = experiments.slice(1, 4);
---

<section class="py-24 md:py-32 bg-black border-b border-neutral-900 relative" id="lab">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-16 pb-8 border-b border-neutral-900">
      <div>
        <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-3" data-reveal>
          The Lab
        </div>
        <h2 class="font-display font-extrabold text-4xl sm:text-5xl lg:text-6xl tracking-tight text-white" data-reveal data-delay="0.1">
          Experiments<span class="text-[#C6FF3D]">.</span>
        </h2>
      </div>
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4" data-reveal data-delay="0.2">
        <p class="font-body text-base text-neutral-400 max-w-sm">
          Where we explore WebGL shaders, synthesize algorithmic audio, and test the outer boundaries of browser tech.
        </p>
        <Button href="/lab" variant="outline" size="sm" showArrow={true}>
          All Experiments
        </Button>
      </div>
    </div>

    <!-- Featured Experiment: Live Interactive Canvas Demo -->
    <div class="mb-12" data-reveal>
      <div class="flex flex-col lg:flex-row gap-8 bg-neutral-950 border border-neutral-900 rounded-3xl p-6 sm:p-8 lg:p-10">
        <div class="lg:w-1/2 flex flex-col justify-between">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <Badge variant="lime" dot={true}>Featured Experiment</Badge>
              <span class="text-xs font-semibold text-neutral-500">{featuredExperiment.code}</span>
            </div>

            <h3 class="font-display font-bold text-3xl sm:text-4xl text-white mb-4">
              {featuredExperiment.title}
            </h3>

            <p class="font-body text-base text-neutral-400 leading-relaxed mb-6">
              {featuredExperiment.description}
            </p>

            <div class="p-5 bg-neutral-900 border border-neutral-800 rounded-2xl mb-6">
              <div class="text-xs font-semibold text-[#C6FF3D] uppercase tracking-wider mb-1">Interactive Controls</div>
              <p class="text-sm text-neutral-300">
                {featuredExperiment.instructions}
              </p>
            </div>
          </div>

          <div class="flex flex-wrap gap-2 pt-4 border-t border-neutral-900">
            {featuredExperiment.tags.map((tag) => (
              <span class="text-xs font-medium text-neutral-400 bg-neutral-900 px-3 py-1 border border-neutral-800 rounded-full">
                {tag}
              </span>
            ))}
          </div>
        </div>

        <div class="lg:w-1/2">
          <InteractiveShader />
        </div>
      </div>
    </div>

    <!-- Expandable Grid of Other Experiments -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {otherExperiments.map((exp, i) => (
        <div
          class="bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-3xl p-6 sm:p-8 flex flex-col justify-between group transition-all"
          data-reveal
          data-delay={0.1 * i}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-xs font-bold text-[#C6FF3D]">{exp.code}</span>
              <span class="text-xs text-neutral-500">{exp.date}</span>
            </div>

            <h4 class="font-display font-bold text-xl text-white group-hover:text-[#C6FF3D] transition-colors mb-3">
              {exp.title}
            </h4>

            <p class="font-body text-sm text-neutral-400 leading-relaxed mb-6">
              {exp.description}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-6">
              {exp.tags.slice(0, 2).map((tag) => (
                <span class="text-xs text-neutral-400 bg-neutral-900 px-2.5 py-0.5 border border-neutral-800 rounded-full">
                  {tag}
                </span>
              ))}
            </div>

            <a
              href="/lab"
              class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-400 group-hover:text-[#C6FF3D] transition-colors"
            >
              <span>Inspect in Lab</span>
              <Icon name="ArrowUpRight" size={13} />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
