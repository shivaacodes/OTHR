---
import Icon from '../ui/Icon.astro';
---

<section class="py-16 sm:py-24 bg-[#F5F2EB] border-b border-[#E2DDD1] relative" id="lab-preview">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      id="lab-preview-card"
      class="relative overflow-hidden p-8 sm:p-12 bg-white border border-[#E2DDD1] rounded-2xl flex flex-col md:flex-row items-start md:items-center justify-between gap-8 group shadow-sm"
    >
      <!-- Interactive Reactive Dotted Canvas -->
      <canvas
        id="lab-dots-canvas"
        class="absolute inset-0 w-full h-full pointer-events-none z-0"
        aria-hidden="true"
      ></canvas>

      <!-- Ambient Glow in Bottom Right -->
      <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-[#0232d4]/5 rounded-full blur-[100px] pointer-events-none z-0"></div>

      <!-- Foreground Card Content -->
      <div class="space-y-2.5 max-w-xl relative z-10">
        <div class="font-mono text-xs font-bold text-[#0232d4] uppercase tracking-wider">
          Creative Technology
        </div>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-[#0D111C] tracking-tight leading-snug">
          The Lab: Experimental Code & Shaders
        </h3>
        <p class="font-body text-sm text-neutral-600 leading-relaxed">
          Where we test unconventional ideas. Algorithmic physics simulations, WebGL shaders, and browser audio DSP that keep our production engineering miles ahead.
        </p>
      </div>

      <a
        href="/lab"
        class="relative z-10 px-6 py-3.5 bg-[#0232d4] hover:bg-[#0028b0] text-[#F5F2EB] font-semibold text-xs sm:text-sm rounded-lg transition-all duration-200 active:scale-95 flex items-center gap-2 whitespace-nowrap cursor-pointer flex-shrink-0 shadow-sm"
      >
        <span>Explore The Lab</span>
        <Icon name="ArrowUpRight" size={15} />
      </a>
    </div>
  </div>
</section>

<script>
  interface LabDot {
    originX: number;
    originY: number;
    x: number;
    y: number;
    baseRadius: number;
    phase: number;
  }

  let labAnimFrameId: number | null = null;
  let labObserver: IntersectionObserver | null = null;
  let labCleanup: (() => void) | null = null;

  function initLabDots() {
    const card = document.getElementById('lab-preview-card');
    const canvas = document.getElementById('lab-dots-canvas') as HTMLCanvasElement | null;
    if (!card || !canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    if (labAnimFrameId) {
      cancelAnimationFrame(labAnimFrameId);
      labAnimFrameId = null;
    }
    if (labCleanup) {
      labCleanup();
      labCleanup = null;
    }
    if (labObserver) {
      labObserver.disconnect();
      labObserver = null;
    }

    let width = 0;
    let height = 0;
    let dpr = 1;
    let dots: LabDot[] = [];
    const gap = 28;
    const interactionRadius = 130;
    const maxRepulsion = 14;

    let mouseX = -9999;
    let mouseY = -9999;
    let targetMouseX = -9999;
    let targetMouseY = -9999;
    let isVisible = true;

    function resize() {
      if (!canvas || !card) return;
      const rect = card.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);

      dots = [];
      const cols = Math.ceil(width / gap) + 1;
      const rows = Math.ceil(height / gap) + 1;
      const offsetX = (width - (cols - 1) * gap) / 2;
      const offsetY = (height - (rows - 1) * gap) / 2;

      for (let r = 0; r < rows; r++) {
        for (let c = 0; c < cols; c++) {
          const originX = offsetX + c * gap;
          const originY = offsetY + r * gap;
          dots.push({
            originX,
            originY,
            x: originX,
            y: originY,
            baseRadius: 1.1,
            phase: (originX * 0.03) + (originY * 0.03)
          });
        }
      }
    }

    resize();

    // Micro-haptic tactile feedback on mobile
    let lastHapticX = -9999;
    let lastHapticY = -9999;
    let lastHapticTime = 0;

    function triggerDotHaptic(x: number, y: number) {
      if (typeof navigator === 'undefined' || !('vibrate' in navigator)) return;
      const now = performance.now();
      if (now - lastHapticTime < 50) return;

      const dist = Math.hypot(x - lastHapticX, y - lastHapticY);
      if (dist >= 28) {
        try {
          navigator.vibrate(8);
          lastHapticX = x;
          lastHapticY = y;
          lastHapticTime = now;
        } catch (err) {}
      }
    }

    const onMouseMove = (e: MouseEvent) => {
      const rect = card.getBoundingClientRect();
      targetMouseX = e.clientX - rect.left;
      targetMouseY = e.clientY - rect.top;
    };

    const onTouchStart = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const rect = card.getBoundingClientRect();
        const curX = e.touches[0].clientX - rect.left;
        const curY = e.touches[0].clientY - rect.top;
        targetMouseX = curX;
        targetMouseY = curY;
        lastHapticX = curX;
        lastHapticY = curY;
        lastHapticTime = performance.now();
      }
    };

    const onTouchMove = (e: TouchEvent) => {
      if (e.touches.length > 0) {
        const rect = card.getBoundingClientRect();
        const curX = e.touches[0].clientX - rect.left;
        const curY = e.touches[0].clientY - rect.top;
        targetMouseX = curX;
        targetMouseY = curY;
        triggerDotHaptic(curX, curY);
      }
    };

    const onLeave = () => {
      targetMouseX = -9999;
      targetMouseY = -9999;
    };

    card.addEventListener('mousemove', onMouseMove, { passive: true });
    card.addEventListener('mouseleave', onLeave, { passive: true });
    card.addEventListener('touchstart', onTouchStart, { passive: true });
    card.addEventListener('touchmove', onTouchMove, { passive: true });
    card.addEventListener('touchend', onLeave, { passive: true });
    card.addEventListener('touchcancel', onLeave, { passive: true });

    const onResize = () => resize();
    window.addEventListener('resize', onResize, { passive: true });

    labCleanup = () => {
      card.removeEventListener('mousemove', onMouseMove);
      card.removeEventListener('mouseleave', onLeave);
      card.removeEventListener('touchstart', onTouchStart);
      card.removeEventListener('touchmove', onTouchMove);
      card.removeEventListener('touchend', onLeave);
      card.removeEventListener('touchcancel', onLeave);
      window.removeEventListener('resize', onResize);
    };

    let time = 0;

    function render() {
      if (!isVisible) {
        labAnimFrameId = requestAnimationFrame(render);
        return;
      }

      ctx.clearRect(0, 0, width, height);

      time += 0.02;

      // Smooth cursor interpolation
      if (targetMouseX < -1000) {
        mouseX = -9999;
        mouseY = -9999;
      } else {
        mouseX += (targetMouseX - mouseX) * 0.18;
        mouseY += (targetMouseY - mouseY) * 0.18;
      }

      const len = dots.length;
      for (let i = 0; i < len; i++) {
        const dot = dots[i];
        const dx = mouseX - dot.originX;
        const dy = mouseY - dot.originY;
        const dist = Math.hypot(dx, dy);

        let targetX = dot.originX;
        let targetY = dot.originY;
        let intensity = 0;

        if (dist < interactionRadius && mouseX > -1000) {
          intensity = 1 - dist / interactionRadius;
          const angle = Math.atan2(dy, dx);
          targetX = dot.originX - Math.cos(angle) * intensity * maxRepulsion;
          targetY = dot.originY - Math.sin(angle) * intensity * maxRepulsion;
        } else {
          targetY = dot.originY + Math.sin(time + dot.phase) * 1.0;
        }

        dot.x += (targetX - dot.x) * 0.16;
        dot.y += (targetY - dot.y) * 0.16;

        const radius = dot.baseRadius + intensity * 1.3;

        ctx.beginPath();
        ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);

        if (intensity > 0.25) {
          ctx.fillStyle = `rgba(2, 50, 212, ${0.25 + intensity * 0.4})`;
        } else {
          ctx.fillStyle = 'rgba(2, 50, 212, 0.12)';
        }
        ctx.fill();
      }

      labAnimFrameId = requestAnimationFrame(render);
    }

    labAnimFrameId = requestAnimationFrame(render);

    // Pause animation when scrolled out of viewport
    labObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        isVisible = entry.isIntersecting;
      });
    }, { threshold: 0.05 });

    labObserver.observe(card);
  }

  initLabDots();
  document.addEventListener('astro:page-load', initLabDots);
</script>
