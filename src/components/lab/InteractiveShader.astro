---
// Interactive generative canvas sandbox for The Lab
---

<div class="relative w-full h-80 sm:h-96 bg-[#080D1A] border border-[#E2DDD1] rounded-2xl overflow-hidden group select-none shadow-md" id="lab-canvas-container">
  <!-- HUD overlay header -->
  <div class="absolute top-0 left-0 right-0 p-4 bg-[#080D1A]/85 backdrop-blur-md border-b border-[#080D1A]/40 flex items-center justify-between z-10 text-xs">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-[#0232d4] animate-ping" style="animation-duration: 2s;"></span>
      <span class="text-white font-bold">Lab-084 • Chroma-Vector Fluid</span>
    </div>
    <div class="flex items-center gap-4 text-neutral-400">
      <span id="canvas-fps">-- FPS</span>
      <span class="text-neutral-500 hidden sm:inline">Canvas 2D</span>
    </div>
  </div>

  <!-- Real-time Interactive Canvas -->
  <canvas id="interactive-fluid-canvas" class="w-full h-full block cursor-crosshair"></canvas>

  <!-- Bottom Interactive HUD Controls -->
  <div class="absolute bottom-0 left-0 right-0 p-4 bg-[#080D1A]/85 backdrop-blur-md border-t border-[#080D1A]/40 flex flex-wrap items-center justify-between gap-4 z-10 text-xs">
    <div class="text-neutral-300 flex items-center gap-2">
      <span class="text-[#4D7CFF] font-semibold">Input:</span>
      <span class="text-xs">Drag or hover cursor to inject fluid turbulence</span>
    </div>
    <div class="flex items-center gap-2">
      <button
        id="clear-particles-btn"
        class="px-3.5 py-1.5 bg-white/10 border border-white/10 hover:border-white/20 rounded-full text-xs text-neutral-200 hover:text-white transition-colors cursor-pointer"
      >
        Clear Field
      </button>
      <button
        id="burst-particles-btn"
        class="px-3.5 py-1.5 bg-[#0232d4] border border-[#0232d4] rounded-full text-xs text-[#F5F2EB] hover:bg-[#0228aa] transition-colors cursor-pointer font-semibold shadow-sm"
      >
        Trigger Burst
      </button>
    </div>
  </div>
</div>

<script>
  import { studioAudio } from '../../utils/audio';

  function initFluidSimulation() {
    const canvas = document.getElementById('interactive-fluid-canvas') as HTMLCanvasElement;
    const container = document.getElementById('lab-canvas-container');
    const clearBtn = document.getElementById('clear-particles-btn');
    const burstBtn = document.getElementById('burst-particles-btn');
    const fpsLabel = document.getElementById('canvas-fps');

    if (!canvas || !container) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let animationId: number;
    let isVisible = true;

    // Resize canvas
    function resize() {
      if (!container || !canvas) return;
      width = container.clientWidth;
      height = container.clientHeight;
      canvas.width = width * window.devicePixelRatio;
      canvas.height = height * window.devicePixelRatio;
      ctx?.scale(window.devicePixelRatio, window.devicePixelRatio);
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Particle vector system
    interface VectorParticle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      life: number;
      maxLife: number;
      size: number;
      color: string;
      alpha: number;
    }

    let particles: VectorParticle[] = [];
    const colors = ['#0232d4', '#3B82F6', '#60A5FA', '#F5F2EB'];

    function spawnParticle(x: number, y: number, vx: number, vy: number) {
      if (particles.length > 250) return;
      particles.push({
        x,
        y,
        vx: vx * 0.4 + (Math.random() - 0.5) * 1.5,
        vy: vy * 0.4 + (Math.random() - 0.5) * 1.5,
        life: 0,
        maxLife: Math.random() * 60 + 40,
        size: Math.random() * 3.5 + 1.2,
        color: colors[Math.floor(Math.random() * colors.length)],
        alpha: 0.9
      });
    }

    let prevMouseX = 0;
    let prevMouseY = 0;

    canvas.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      const vx = x - prevMouseX;
      const vy = y - prevMouseY;

      const speed = Math.sqrt(vx * vx + vy * vy);
      const count = Math.min(Math.floor(speed / 4) + 1, 6);

      for (let i = 0; i < count; i++) {
        spawnParticle(x + (Math.random() - 0.5) * 8, y + (Math.random() - 0.5) * 8, vx, vy);
      }

      prevMouseX = x;
      prevMouseY = y;
    });

    // Touch support for mobile
    canvas.addEventListener('touchmove', (e) => {
      if (e.touches.length === 1) {
        const rect = canvas.getBoundingClientRect();
        const x = e.touches[0].clientX - rect.left;
        const y = e.touches[0].clientY - rect.top;
        const vx = x - prevMouseX;
        const vy = y - prevMouseY;
        for (let i = 0; i < 3; i++) {
          spawnParticle(x, y, vx, vy);
        }
        prevMouseX = x;
        prevMouseY = y;
      }
    });

    clearBtn?.addEventListener('click', () => {
      particles = [];
      studioAudio.playClick();
    });

    burstBtn?.addEventListener('click', () => {
      studioAudio.playChirp(700, 0.08);
      const cx = width / 2;
      const cy = height / 2;
      for (let i = 0; i < 70; i++) {
        const angle = Math.random() * Math.PI * 2;
        const spd = Math.random() * 6 + 2;
        spawnParticle(cx, cy, Math.cos(angle) * spd, Math.sin(angle) * spd);
      }
    });

    // Seed initial particles
    for (let i = 0; i < 40; i++) {
      spawnParticle(
        Math.random() * width,
        Math.random() * height,
        (Math.random() - 0.5) * 2,
        (Math.random() - 0.5) * 2
      );
    }

    let lastTime = performance.now();
    let frameCount = 0;
    let lastFpsUpdate = lastTime;

    function render(currentTime: number) {
      animationId = requestAnimationFrame(render);
      if (!isVisible || !ctx) return;

      frameCount++;
      if (currentTime - lastFpsUpdate > 500) {
        const fps = Math.round((frameCount * 1000) / (currentTime - lastFpsUpdate));
        if (fpsLabel) fpsLabel.textContent = `${fps} FPS`;
        frameCount = 0;
        lastFpsUpdate = currentTime;
      }

      // Semi-transparent black fade creates clean fluid ghost trails (pure black)
      ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
      ctx.fillRect(0, 0, width, height);

      // Update and draw vector particles
      for (let i = particles.length - 1; i >= 0; i--) {
        const p = particles[i];
        p.x += p.vx;
        p.y += p.vy;
        p.vx *= 0.97;
        p.vy *= 0.97;
        p.life++;

        const progress = p.life / p.maxLife;
        p.alpha = Math.max(0, 1 - progress);

        if (progress >= 1 || p.x < 0 || p.x > width || p.y < 0 || p.y > height) {
          particles.splice(i, 1);
          continue;
        }

        ctx.save();
        ctx.globalAlpha = p.alpha;
        ctx.fillStyle = p.color;
        ctx.shadowColor = p.color;
        ctx.shadowBlur = 8;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.size * (1 - progress * 0.4), 0, Math.PI * 2);
        ctx.fill();

        // Connect nearby particles with subtle filament lines
        for (let j = i - 1; j >= 0; j--) {
          const p2 = particles[j];
          const dx = p.x - p2.x;
          const dy = p.y - p2.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < 45) {
            ctx.beginPath();
            ctx.strokeStyle = p.color;
            ctx.globalAlpha = (1 - dist / 45) * 0.25 * p.alpha;
            ctx.lineWidth = 0.8;
            ctx.moveTo(p.x, p.y);
            ctx.lineTo(p2.x, p2.y);
            ctx.stroke();
          }
        }

        ctx.restore();
      }
    }

    // Observer to pause when scrolled out
    const obs = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        isVisible = e.isIntersecting;
      });
    }, { threshold: 0.1 });

    obs.observe(container);
    animationId = requestAnimationFrame(render);
  }

  initFluidSimulation();
  document.addEventListener('astro:page-load', initFluidSimulation);
</script>
