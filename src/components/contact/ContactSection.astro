---
import Icon from '../ui/Icon.astro';
import { siteConfig } from '../../config/site';

const projectTypes = [
  'Flagship Web',
  'Software & Automation',
  'Other Inquiries'
];
---

<section class="py-20 md:py-28 bg-black border-t border-neutral-900 relative" id="contact">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      
      <!-- Left Column: Direct Info -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <div class="font-mono text-xs font-bold text-[#C6FF3D] uppercase tracking-wider mb-3">
            Get in touch
          </div>
          <h2 class="font-display font-black text-3xl sm:text-5xl lg:text-6xl tracking-tight text-white leading-[1.05]">
            Let's build something exceptional
          </h2>
        </div>

        <p class="font-body text-base sm:text-lg text-neutral-400 leading-relaxed">
          Whether you need a flagship web experience, a custom software system to kill manual spreadsheet toil, or proprietary product engineering, let's talk.
        </p>

        <!-- Direct Cards -->
        <div class="space-y-3 pt-2">
          <!-- Direct Phone / WhatsApp Card -->
          <a
            href="https://wa.me/919995228904"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 bg-neutral-950 border border-neutral-900 hover:border-[#C6FF3D]/40 rounded-xl flex items-center justify-between transition-colors group"
          >
            <div>
              <div class="text-xs text-neutral-500 font-medium">Direct Line / WhatsApp</div>
              <div class="text-white group-hover:text-[#C6FF3D] font-bold text-sm sm:text-base transition-colors mt-0.5">
                +91 99952 28904
              </div>
            </div>
            <span class="w-9 h-9 rounded-full bg-neutral-900 flex items-center justify-center text-neutral-400 group-hover:text-[#C6FF3D] transition-colors">
              <Icon name="Phone" size={16} />
            </span>
          </a>

          <!-- Email Card -->
          <a
            href="mailto:shivasajay23@gmail.com"
            class="p-4 sm:p-5 bg-neutral-950 border border-neutral-900 hover:border-[#C6FF3D]/40 rounded-xl flex items-center justify-between transition-colors group"
          >
            <div>
              <div class="text-xs text-neutral-500 font-medium">Direct Email</div>
              <div class="text-white group-hover:text-[#C6FF3D] font-bold text-sm sm:text-base transition-colors mt-0.5">
                shivasajay23@gmail.com
              </div>
            </div>
            <span class="w-9 h-9 rounded-full bg-neutral-900 flex items-center justify-center text-neutral-400 group-hover:text-[#C6FF3D] transition-colors">
              <Icon name="ArrowUpRight" size={16} />
            </span>
          </a>

          <!-- Social X Card -->
          <a
            href="https://x.com/othrbuilds"
            target="_blank"
            rel="noopener noreferrer"
            class="p-4 sm:p-5 bg-neutral-950 border border-neutral-900 hover:border-neutral-700 rounded-xl flex items-center justify-between transition-colors group"
          >
            <div>
              <div class="text-xs text-neutral-500 font-medium">Follow Updates on X</div>
              <div class="text-white font-bold text-sm sm:text-base transition-colors mt-0.5">
                @othrbuilds
              </div>
            </div>
            <span class="w-9 h-9 rounded-full bg-neutral-900 flex items-center justify-center text-neutral-400 group-hover:text-white transition-colors">
              <Icon name="ArrowUpRight" size={16} />
            </span>
          </a>
        </div>
      </div>

      <!-- Right Column: Streamlined Inquiry Form (Direct & Unwrapped) -->
      <div class="lg:col-span-7">
        <form id="studio-contact-form" class="space-y-6">
          
          <!-- Quick Project Type Pills -->
          <div>
            <label class="block text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3">
              What are you looking to build?
            </label>
            <div class="flex flex-wrap gap-2" id="contact-type-selector">
              {projectTypes.map((type, idx) => (
                <button
                  type="button"
                  class={`contact-type-pill px-4 py-2 rounded-lg text-xs font-semibold transition-all cursor-pointer ${
                    idx === 0
                      ? 'bg-[#C6FF3D] text-black shadow-sm'
                      : 'bg-neutral-950 text-neutral-400 hover:text-white border border-neutral-800'
                  }`}
                  data-value={type}
                >
                  {type}
                </button>
              ))}
            </div>
            <input type="hidden" name="projectType" id="selected-project-type" value={projectTypes[0]} />
          </div>

          <!-- Name & Email (2 columns on tablet+, 1 column on mobile) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="contact-name" class="block text-xs font-semibold text-neutral-400 mb-2">
                Your Name *
              </label>
              <input
                type="text"
                id="contact-name"
                name="name"
                required
                placeholder="Shiva Sajay"
                class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none px-4 py-3 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600"
              />
            </div>

            <div>
              <label for="contact-email" class="block text-xs font-semibold text-neutral-400 mb-2">
                Your Email *
              </label>
              <input
                type="email"
                id="contact-email"
                name="email"
                required
                placeholder="shiva@example.com"
                class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none px-4 py-3 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600"
              />
            </div>
          </div>

          <!-- Message / Scope -->
          <div>
            <label for="contact-message" class="block text-xs font-semibold text-neutral-400 mb-2">
              Project Overview / Scope *
            </label>
            <textarea
              id="contact-message"
              name="message"
              required
              rows={4}
              placeholder="Tell us what you're looking to engineer, your rough timeline, and any key requirements..."
              class="w-full bg-neutral-950 border border-neutral-800 focus:border-[#C6FF3D] focus:outline-none p-4 text-sm text-white rounded-lg transition-colors placeholder:text-neutral-600 resize-none"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-4">
            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full sm:w-auto px-7 py-3.5 bg-[#C6FF3D] hover:bg-[#d4ff66] text-black font-bold text-sm rounded-lg transition-all flex items-center justify-center gap-2 shadow-sm active:scale-95 cursor-pointer"
            >
              <span>Send Project Inquiry</span>
              <Icon name="ArrowUpRight" size={16} />
            </button>
            <span class="text-xs text-neutral-500 text-center sm:text-right">
              Replies within 24–48 hours
            </span>
          </div>
        </form>

        <!-- Feedback Success Alert -->
        <div id="contact-success-alert" class="hidden p-6 bg-neutral-950 border border-[#C6FF3D] rounded-xl space-y-3">
          <div class="flex items-center gap-2 text-[#C6FF3D] font-bold text-sm">
            <span>✓</span>
            <span>Inquiry Copied & Email Prepared</span>
          </div>
          <p class="text-sm text-neutral-300 leading-relaxed font-body">
            Your inquiry was copied to your clipboard and addressed to <strong class="text-white">shivasajay23@gmail.com</strong>.
          </p>
          <div class="flex flex-wrap gap-2 pt-2">
            <a
              id="mailto-trigger"
              href="mailto:shivasajay23@gmail.com"
              class="px-5 py-2.5 bg-[#C6FF3D] text-black font-semibold text-xs rounded-lg inline-block"
            >
              Open Email App
            </a>
            <button
              type="button"
              id="reset-form-btn"
              class="px-5 py-2.5 bg-neutral-900 border border-neutral-800 text-neutral-300 hover:text-white font-medium text-xs rounded-lg cursor-pointer"
            >
              Send Another
            </button>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<script>
  function initContactSection() {
    const form = document.getElementById('studio-contact-form') as HTMLFormElement;
    const successAlert = document.getElementById('contact-success-alert');
    const resetBtn = document.getElementById('reset-form-btn');
    const pills = document.querySelectorAll('.contact-type-pill');
    const selectedInput = document.getElementById('selected-project-type') as HTMLInputElement;
    const mailtoTrigger = document.getElementById('mailto-trigger') as HTMLAnchorElement;

    // Pill selection logic
    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        pills.forEach((p) => {
          p.classList.remove('bg-[#C6FF3D]', 'text-black', 'shadow-sm');
          p.classList.add('bg-neutral-900', 'text-neutral-300', 'border', 'border-neutral-800');
        });
        pill.classList.remove('bg-neutral-900', 'text-neutral-300', 'border', 'border-neutral-800');
        pill.classList.add('bg-[#C6FF3D]', 'text-black', 'shadow-sm');

        const val = pill.getAttribute('data-value') || '';
        if (selectedInput) selectedInput.value = val;
      });
    });

    // Auto-select pill based on URL search query (?service=...)
    try {
      const urlParams = new URLSearchParams(window.location.search);
      const serviceParam = urlParams.get('service');
      if (serviceParam) {
        let targetValue = '';
        if (serviceParam.includes('web') || serviceParam.includes('flagship')) targetValue = 'Flagship Web';
        else if (serviceParam.includes('software') || serviceParam.includes('automation')) targetValue = 'Software & Automation';

        if (targetValue) {
          pills.forEach((p) => {
            if (p.getAttribute('data-value') === targetValue) {
              pills.forEach((item) => {
                item.classList.remove('bg-[#C6FF3D]', 'text-black', 'shadow-sm');
                item.classList.add('bg-neutral-900', 'text-neutral-300', 'border', 'border-neutral-800');
              });
              p.classList.remove('bg-neutral-900', 'text-neutral-300', 'border', 'border-neutral-800');
              p.classList.add('bg-[#C6FF3D]', 'text-black', 'shadow-sm');
              if (selectedInput) selectedInput.value = targetValue;
            }
          });
        }
      }
    } catch (e) {}

    // Form Submission
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
        try { navigator.vibrate([15, 40, 20]); } catch (err) {}
      }

      const formData = new FormData(form);
      const name = formData.get('name') as string;
      const email = formData.get('email') as string;
      const type = formData.get('projectType') as string;
      const message = formData.get('message') as string;

      const briefText = `OTHR INQUIRY\n---\nName: ${name}\nEmail: ${email}\nProject Type: ${type}\nMessage:\n${message}`;

      // Copy to clipboard
      if (navigator.clipboard) {
        navigator.clipboard.writeText(briefText);
      }

      // Prepare mailto link
      const subject = encodeURIComponent(`Project Inquiry: ${type} - ${name}`);
      const body = encodeURIComponent(briefText);
      const mailtoUrl = `mailto:shivasajay23@gmail.com?subject=${subject}&body=${body}`;

      if (mailtoTrigger) {
        mailtoTrigger.href = mailtoUrl;
      }

      // Open mailto
      window.location.href = mailtoUrl;

      // Show success alert
      form.classList.add('hidden');
      successAlert?.classList.remove('hidden');
    });

    // Reset button
    resetBtn?.addEventListener('click', () => {
      form.reset();
      form.classList.remove('hidden');
      successAlert?.classList.add('hidden');
    });
  }

  initContactSection();
  document.addEventListener('astro:page-load', initContactSection);
</script>
