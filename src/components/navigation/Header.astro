---
import Icon from '../ui/Icon.astro';

export interface Props {
  minimal?: boolean;
}

const { minimal = false } = Astro.props;
---

<header class="relative w-full bg-[#F5F2EB]" id="site-header">
  <!-- Top Overscroll Floor (Guarantees seamless cream background when rubber-banding down at top) -->
  <div class="absolute bottom-full left-0 right-0 h-[100vh] bg-[#F5F2EB] pointer-events-none -z-10" aria-hidden="true"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 sm:h-20 flex items-center justify-between">
    <!-- Left: Nira Studio Wordmark with Official nira-studio.png Logo -->
    <a href="/" class="flex items-center gap-2.5 sm:gap-3 group focus:outline-none" aria-label="Nira Studio Homepage">
      <img
        src="/nira-studio.png"
        alt="Nira Studio Logo"
        class="h-7 sm:h-8 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        width="134"
        height="117"
      />
      <span class="font-display font-bold text-lg sm:text-xl tracking-tight text-[#0D111C] group-hover:text-[#0B3C85] transition-colors">
        Nira Studio
      </span>
    </a>

    <!-- Right: Enquire CTA or Back to home -->
    {minimal ? (
      <a
        href="/"
        class="inline-flex items-center gap-2 px-4 py-2 bg-[#EDE9DF] hover:bg-white text-[#0D111C] hover:text-[#0B3C85] border border-[#D1CABE] text-xs font-bold rounded-xl transition-all active:scale-95 shadow-sm"
      >
        <span>← Back to home</span>
      </a>
    ) : (
      <!-- One single unified button with text and arrow -->
      <a
        href="/start"
        class="inline-flex items-center gap-2 px-5 sm:px-6 py-2 sm:py-2.5 bg-[#0B3C85] hover:bg-[#082D64] text-[#F5F2EB] text-xs sm:text-sm font-bold rounded-full transition-all shadow-sm active:scale-95 cursor-pointer group"
        aria-label="Enquire"
      >
        <span>Enquire</span>
        <Icon name="ArrowUpRight" size={14} class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
      </a>
    )}
  </div>
</header>
