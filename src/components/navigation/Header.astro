---
import Icon from '../ui/Icon.astro';

const navLinks = [
  { href: '/products', label: 'Products' },
  { href: '/services', label: 'Services' },
  { href: '/studio', label: 'Studio' }
];

const currentPath = Astro.url.pathname;
---

<header class="fixed top-0 left-0 right-0 z-50 bg-black/85 backdrop-blur-md border-b border-neutral-900 transition-all duration-300" id="site-header">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Left: OTHR Wordmark with Official Logo (No full stop) -->
    <a href="/" class="flex items-center gap-3 group focus:outline-none" aria-label="OTHR Homepage">
      <img
        src="/logo-mark.png"
        alt="OTHR Logo"
        class="h-7 w-auto object-contain transition-transform duration-300 group-hover:scale-105"
        width="46"
        height="26"
      />
      <span class="font-display font-black text-2xl tracking-tight text-white group-hover:text-[#C6FF3D] transition-colors">
        OTHR
      </span>
    </a>

    <!-- Desktop Navigation Links (Products, Services, Studio) -->
    <nav class="hidden md:flex items-center gap-8" aria-label="Main Navigation">
      {navLinks.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`font-body text-sm font-semibold transition-colors ${
              isActive ? 'text-[#C6FF3D]' : 'text-neutral-400 hover:text-white'
            }`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <!-- Right: Get in touch CTA -->
    <div class="hidden md:flex items-center gap-4">
      <a
        href="/contact"
        class="bg-white hover:bg-[#C6FF3D] text-black font-semibold text-xs px-5 py-2.5 rounded-full transition-all shadow-md active:scale-95"
      >
        Get in touch
      </a>
    </div>

    <!-- Mobile Navigation Toggle Button -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href="/contact"
        class="bg-white hover:bg-[#C6FF3D] text-black font-semibold text-xs px-3.5 py-1.5 rounded-full transition-all"
      >
        Get in touch
      </a>
      <button
        id="mobile-menu-trigger"
        class="w-10 h-10 flex flex-col items-center justify-center gap-1.5 p-2 focus:outline-none cursor-pointer group"
        aria-label="Open Mobile Menu"
        aria-expanded="false"
      >
        <span class="hamburger-line w-6 h-0.5 bg-[#C6FF3D] rounded-full transition-all duration-300"></span>
        <span class="hamburger-line w-6 h-0.5 bg-[#C6FF3D] rounded-full transition-all duration-300"></span>
        <span class="hamburger-line w-6 h-0.5 bg-[#C6FF3D] rounded-full transition-all duration-300"></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-40 bg-black/98 backdrop-blur-2xl transform -translate-y-full transition-transform duration-500 ease-[cubic-bezier(0.16,1,0.3,1)] md:hidden pt-24 px-6 pb-12 flex flex-col justify-between"
  aria-hidden="true"
>
  <div class="flex flex-col gap-2 mt-4">
    <nav class="flex flex-col">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link flex items-center justify-between py-4 border-b border-neutral-900 font-display text-2xl font-bold tracking-tight text-neutral-300 hover:text-[#C6FF3D] transition-colors"
        >
          <span>{link.label}</span>
        </a>
      ))}
      <a
        href="/contact"
        class="mobile-nav-link flex items-center justify-between py-4 border-b border-neutral-900 font-display text-2xl font-bold tracking-tight text-[#C6FF3D]"
      >
        <span>Get in touch</span>
      </a>
    </nav>
  </div>

  <div class="border-t border-neutral-900 pt-6">
    <div class="font-body text-xs text-neutral-500">
      Creative Engineering Studio
    </div>
  </div>
</div>

<script>
  function initHeaderControls() {
    const trigger = document.getElementById('mobile-menu-trigger');
    const drawer = document.getElementById('mobile-menu-drawer');
    const links = document.querySelectorAll('.mobile-nav-link');
    const lines = trigger?.querySelectorAll<HTMLElement>('.hamburger-line');

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      if (isOpen) {
        drawer?.classList.remove('-translate-y-full');
        drawer?.classList.add('translate-y-0');
        document.body.style.overflow = 'hidden';
        if (lines && lines.length === 3) {
          lines[0].style.transform = 'translateY(8px) rotate(45deg)';
          lines[1].style.opacity = '0';
          lines[2].style.transform = 'translateY(-8px) rotate(-45deg)';
        }
      } else {
        drawer?.classList.add('-translate-y-full');
        drawer?.classList.remove('translate-y-0');
        document.body.style.overflow = '';
        if (lines && lines.length === 3) {
          lines[0].style.transform = 'none';
          lines[1].style.opacity = '1';
          lines[2].style.transform = 'none';
        }
      }
      trigger?.setAttribute('aria-expanded', isOpen.toString());
    }

    trigger?.addEventListener('click', toggleMenu);
    links.forEach((l) => l.addEventListener('click', () => {
      if (isOpen) toggleMenu();
    }));
  }

  initHeaderControls();
  document.addEventListener('astro:page-load', initHeaderControls);
</script>
