---
import { ClientRouter } from 'astro:transitions';
import Header from '../components/navigation/Header.astro';
import Footer from '../components/footer/Footer.astro';
import { siteConfig } from '../config/site';
import '../styles/global.css';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonicalPath?: string;
  keywords?: string;
  minimalNav?: boolean;
  hideFooter?: boolean;
}

const {
  title = "Nira Studio | Thoughtful Websites. Smarter Business Software.",
  description = "Independent digital studio by Shiva Sajay. Thoughtful websites, custom software, and automation for small businesses and growing teams that want better.",
  ogImage = "/nira-studio.png",
  canonicalPath,
  keywords = "Nira Studio, Shiva Sajay, website design, web development, custom software, business automation, internal tools, CRM, PostgreSQL, Astro, Cloudflare, Kochi, Kerala, India",
  minimalNav = false,
  hideFooter = false
} = Astro.props;

const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteConfig.url);
const ogImageURL = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteConfig.url).toString();

// Comprehensive Studio & Local Professional Service Schema (Google Rich Snippets)
const structuredDataSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['Organization', 'ProfessionalService'],
      '@id': `${siteConfig.url}/#organization`,
      name: siteConfig.name,
      legalName: siteConfig.legalName,
      alternateName: 'Nira Studio',
      url: siteConfig.url,
      logo: `${siteConfig.url}/nira-studio.png`,
      image: ogImageURL,
      description: siteConfig.description,
      telephone: '+91 9995228904',
      email: siteConfig.contactEmail,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Kochi',
        addressRegion: 'Kerala',
        addressCountry: 'IN'
      },
      founder: {
        '@type': 'Person',
        name: 'Shiva Sajay',
        jobTitle: 'Founder & Lead Engineer',
        url: siteConfig.url,
        sameAs: [
          'https://x.com/NiraaStudio',
          'https://github.com/shivaacodes'
        ]
      },
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+91 9995228904',
          contactType: 'Direct Engineering & Inquiries',
          email: siteConfig.contactEmail,
          areaServed: 'Worldwide',
          availableLanguage: ['English', 'Malayalam']
        }
      ],
      priceRange: '$$',
      sameAs: siteConfig.socials.map((s) => s.url).filter(Boolean)
    },
    {
      '@type': 'WebSite',
      '@id': `${siteConfig.url}/#website`,
      url: siteConfig.url,
      name: siteConfig.name,
      description: siteConfig.description,
      publisher: {
        '@id': `${siteConfig.url}/#organization`
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/png" href="/nira-studio.png" />
    <link rel="apple-touch-icon" href="/nira-studio.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="Shiva Sajay" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="theme-color" content="#F5F2EB" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Nira Studio — Thoughtful Websites. Smarter Business Software." />
    <meta property="og:site_name" content="Nira Studio" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@NiraaStudio" />
    <meta name="twitter:creator" content="@NiraaStudio" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Preload Primary Font: Manrope (Local Web Font) -->
    <link
      rel="preload"
      href="/fonts/Manrope-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Manrope-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/fonts/Manrope-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    <!-- Google Fonts: Manrope (Fallback), Plus Jakarta Sans & Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Global JSON-LD Schema (Organization, ProfessionalService, LocalBusiness, Founder, Phone) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredDataSchema)} />

    <!-- Astro View Transitions -->
    <ClientRouter />

    <!-- Privacy-First Cloudflare Web Analytics (only injected when token is configured) -->
    {siteConfig.analytics?.cloudflareToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${siteConfig.analytics.cloudflareToken}"}`}
      />
    )}
  </head>
  <body class="bg-[#0B3C85] text-[#0D111C] antialiased selection:bg-[#0B3C85] selection:text-[#F5F2EB]">
    <div class="bg-[#F5F2EB] relative z-10 w-full min-h-screen">
      <Header minimal={minimalNav} />

      <main id="main-content">
        <slot />
      </main>
    </div>

    {!hideFooter && <Footer />}

    <script>
      import { initScrollAnimations } from '../utils/motion';

      function initHaptics() {
        if (typeof window === 'undefined' || !('vibrate' in navigator)) return;

        // Subtle tactile feedback on tap/click for interactive elements
        document.addEventListener('click', (e) => {
          const target = (e.target as HTMLElement)?.closest(
            'button, a, input, select, textarea, [data-haptic], .service-currency-btn, .mockgen-currency-btn, .service-tab-btn, .contact-type-pill'
          );
          if (target) {
            try {
              navigator.vibrate(10);
            } catch (err) {}
          }
        }, { passive: true });
      }

      function initApp() {
        initScrollAnimations();
        initHaptics();
      }

      initApp();
      document.addEventListener('astro:page-load', initApp);
    </script>
  </body>
</html>
