# OTHR Studio Environment Configuration

# Public Site URL (Used for canonical URLs, OpenGraph, and Sitemap generation)
PUBLIC_SITE_URL=https://othr.engineering

# Resend Email Integration (For project inquiry dispatch notifications)
# Obtain from https://resend.com
RESEND_API_KEY=re_your_api_key_here
CONTACT_EMAIL_TO=studio@othr.engineering
CONTACT_EMAIL_FROM=inquiries@othr.engineering

# Cloudflare Turnstile Spam Protection (Optional)
# Obtain from Cloudflare Dashboard > Turnstile
PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
CF_TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Cloudflare Web Analytics Token (Privacy-first, cookie-less)
# Obtain from Cloudflare Dashboard > Web Analytics
PUBLIC_CF_ANALYTICS_TOKEN=your_cf_analytics_beacon_token

# Future Dodo Payments Integration (For digital products & WrapForge subscriptions)
# Not required for static marketing website
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_SECRET=
